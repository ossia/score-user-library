false,"Signatures":[],"StartState":9,"EndState":10,"StartDate":13734928961,"HeightPercentage":0.38866666666666666,"NodalSlotHeight":100.0,"QuantizationRate":-1.0,"Zoom":-1.0,"Center":0,"NodalCenter":[130.0,46.50000000000001],"ViewMode":0,"SmallViewShown":true,"HasSignature":false},{"ObjectName":"Scenario::IntervalModel","id":7,"Metadata":{"ScriptingName":"Interval.joke89.1","Comment":"","Color":"Transparent1","Label":"","Touched":true},"Inlet":{"uuid":"a1574bb0-cbd4-4c7d-9417-0c25cfd1187b","ObjectName":"Inlet","id":0,"Hidden":false,"Custom":"Audio In","Exposed":"audio in"},"Outlet":{"uuid":"a1d97535-18ac-444a-8417-0cbc1692d897","ObjectName":"Outlet","id":0,"Hidden":false,"Custom":"Audio Out","Exposed":"audio out","GainInlet":{"uuid":"9a13fb32-269a-47bf-99a9-930188c1f19c","ObjectName":"Inlet","id":10000,"Hidden":false,"Custom":"Gain","Exposed":"gain","Value":{},"Init":{},"Domain":{"Float":{"Min":0.0,"Max":1.0}}},"PanInlet":{"uuid":"9a13fb32-269a-47bf-99a9-930188c1f19c","ObjectName":"Inlet","id":10001,"Hidden":false,"Custom":"Pan","Exposed":"pan","Value":{},"Init":{},"Domain":{}},"Gain":1.0,"Pan":[1.0,1.0],"Propagate":true},"Processes":[],"SmallViewRack":[],"FullViewRack":[],"DefaultDuration":5860536772,"MinDuration":5860536772,"MaxDuration":5860536772,"GuiDuration":7039866573,"Speed":1.0,"Rigidity":true,"MinNull":false,"MaxInf":false,"Signatures":[],"StartState":13,"EndState":14,"StartDate":7874392189,"HeightPercentage":0.414,"NodalSlotHeight":100.0,"QuantizationRate":-1.0,"Zoom":-1.0,"Center":0,"ViewMode":0,"SmallViewShown":false,"HasSignature":false},{"ObjectName":"Scenario::IntervalModel","id":8,"Metadata":{"ScriptingName":"Interval.egan84.1","Comment":"","Color":"Transparent1","Label":"","Touched":true},"Graphal":true,"DefaultDuration":0,"MinDuration":0,"MaxDuration":0,"GuiDuration":0,"Speed":1.0,"Rigidity":false,"MinNull":true,"MaxInf":true,"StartState":11,"EndState":12,"StartDate":158133096978,"HeightPercentage":0.3666666666666667}],"Comments":[{"ObjectName":"CommentBlockModel","id":1,"Date":9416813455,"HeightPercentage":0.014,"HTMLContent":"<!DOCTYPE HTML PUBLIC \"-//W3C//DTD HTML 4.0//EN\" \"http://www.w3.org/TR/REC-html40/strict.dtd\">\n<html><head><meta name=\"qrichtext\" content=\"1\" /><meta charset=\"utf-8\" /><style type=\"text/css\">\np, li { white-space: pre-wrap; }\nhr { height: 1px; border-width: 0; }\nli.unchecked::marker { content: \"\\2610\"; }\nli.checked::marker { content: \"\\2612\"; }\n</style></head><body style=\" font-family:'Ubuntu'; font-size:13px; font-weight:400; font-style:normal;\">\n<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\"><span style=\" font-size:10pt;\">This template shows a use case when running longer installations, for instance that have day/night cycles <br />with different scores running, and maybe separate OSC controls to start them.<br />Maybe there are additional software to start / stop. <br />For instance it can be useful to restart a score instance every day if using a plug-in that leaks memory for some reason.<br />This score will be the main &quot;manager&quot; and the sub-scores will do the actual audio-video processing.<br />It can also be useful for instance to separate scores that handle audio and video.</span></p></body></html>"},{"ObjectName":"CommentBlockModel","id":2,"Date":103584948014,"HeightPercentage":0.3406666666666667,"HTMLContent":"<!DOCTYPE HTML PUBLIC \"-//W3C//DTD HTML 4.0//EN\" \"http://www.w3.org/TR/REC-html40/strict.dtd\">\n<html><head><meta name=\"qrichtext\" content=\"1\" /><meta charset=\"utf-8\" /><style type=\"text/css\">\np, li { white-space: pre-wrap; }\nhr { height: 1px; border-width: 0; }\nli.unchecked::marker { content: \"\\2610\"; }\nli.checked::marker { content: \"\\2612\"; }\n</style></head><body style=\" font-family:'Ubuntu'; font-size:13px; font-weight:400; font-style:normal;\">\n<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\"><span style=\" font-size:10pt;\">We use a max bound to enforce a regular<br />complete restart on night mode.</span></p></body></html>"},{"ObjectName":"CommentBlockModel","id":3,"Date":7498573677,"HeightPercentage":0.528,"HTMLContent":"<!DOCTYPE HTML PUBLIC \"-//W3C//DTD HTML 4.0//EN\" \"http://www.w3.org/TR/REC-html40/strict.dtd\">\n<html><head><meta name=\"qrichtext\" content=\"1\" /><meta charset=\"utf-8\" /><style type=\"text/css\">\np, li { white-space: pre-wrap; }\nhr { height: 1px; border-width: 0; }\nli.unchecked::marker { content: \"\\2610\"; }\nli.checked::marker { content: \"\\2612\"; }\n</style></head><body style=\" font-family:'Ubuntu'; font-size:13px; font-weight:400; font-style:normal;\">\n<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\"><span style=\" font-size:10pt;\">A small javascript expression object<br />in the top-level (see it by switching to nodal mode <br />with the button at the bottom left) computes a regular &quot;day&quot; / &quot;night&quot; state.</span></p></body></html>"}]},{"uuid":"846a5de5-47f9-46c5-a898-013cb20951d0","ObjectName":"Javascript","id":3,"Metadata":{"ScriptingName":"Expression","Comment":"","Color":"Transparent1","Label":"","Touched":true},"Duration":157867862291,"Height":300.0,"StartOffset":0,"LoopDuration":157867862291,"Pos":[31.0,292.5],"Size":[251.0,85.0],"Loops":false,"FoldMode":0,"Script":"import Score 1.0\n\n// Evaluates a JavaScript expression on every incoming value.\n//\n// Available inside the expression:\n//   x    the incoming value (a number, a string, or an array)\n//   px   the previous input,  po  the previous output\n//   t    date of the tick in ms,  dt  time since the last tick in ms\n//   pos  position inside the parent interval, 0 to 1\n//   fs   sample rate,  n  number of values seen so far\n//   m    a persistent object, free for you to store anything between ticks\n//   a, b two extra inlets, latched to their last received value\n//\n// Try:  x * 2   |   Math.sin(t / 500)   |   x.map(v => v * a)   |   (m.s = (m.s||0) + x)\nScript {\n  ValueInlet  { id: input; objectName: \"Value In\" }\n  LineEdit    { id: expr; objectName: \"Expression\"; text: \"x * 2\" }\n  ValueOutlet { id: output; objectName: \"Value Out\" }\n\n  property var px: undefined\n  property var po: undefined\n  property var m: ({})\n  property int n: 0\n  property real prevT: 0\n\n  function str(ctl) { return (typeof ctl.value === \"string\") ? ctl.value : ctl.text; }\n\n  // An expression can easily produce NaN (arithmetic on a list, a division by\n  // zero...). Emitting it would poison everything downstream, so drop it.\n  function finite(v) {\n    if (typeof v === \"number\") return isFinite(v);\n    if (v !== null && typeof v === \"object\" && typeof v.length === \"number\") {\n      for (var i = 0; i < v.length; ++i) if (!finite(v[i])) return false;\n    }\n    return true;\n  }\n\n  tick: function(token, state) {\n    const t = 1000. * (token.date * state.model_to_physical) / state.sample_rate;\n    const dt = t - prevT;\n    prevT = t;\n\n    if (typeof input.value === \"undefined\")\n      return;\n\n    const x = input.value;\n    const pos = token.position();\n    const fs = state.sample_rate;\n    const src = str(expr);\n    if (src.length === 0)\n      return;\n\n    var o;\n    try { o = eval(src); }\n    catch (e) { console.log(\"Expression: \" + e); return; }\n\n    px = x;\n    po = o;\n    n++;\n    if (typeof o !== \"undefined\" && finite(o))\n      output.value = o;\n  }\n}\n","Root":"<LIBRARY>:packages/default/Presets/Javascript/Utils/Math/Expression.qml","Inlets":[{"uuid":"769dd38a-bfb3-4dc6-b52a-b6abb7afe2a3","ObjectName":"Inlet","id":0,"Hidden":false,"Custom":"Value In","Exposed":"value in","Address":"sysinfo:/time/hour"},{"uuid":"9ae797ea-d94c-4792-acec-9ec1932bae5d","ObjectName":"Inlet","id":1,"Hidden":true,"Custom":"Expression","Exposed":"expression","Value":{"String":"x >= 8 && x < 20 \n  ? \"day\" \n  : \"night\""},"Init":{"String":"x * 2"},"Domain":{}}],"Outlets":[{"uuid":"cff96158-cc72-46d7-99dc-b6038171375b","ObjectName":"Outlet","id":0,"Hidden":false,"Custom":"Value Out","Exposed":"value out"}]},{"uuid":"120a50ad-4e74-43c4-a05b-3e645b27e152","ObjectName":"repetition_filter","id":4,"Metadata":{"ScriptingName":"Repetition Filter.5","Comment":"","Color":"Transparent1","Label":"","Touched":true},"Duration":157867862291,"Height":300.0,"StartOffset":0,"LoopDuration":157867862291,"Pos":[292.00000000000006,292.5],"Size":[161.0,22.0],"Loops":false,"FoldMode":0,"Inlets":[{"uuid":"769dd38a-bfb3-4dc6-b52a-b6abb7afe2a3","ObjectName":"Inlet","id":0,"Hidden":false,"Custom":"Input","Exposed":"input"}],"Outlets":[{"uuid":"cff96158-cc72-46d7-99dc-b6038171375b","ObjectName":"Outlet","id":0,"Hidden":false,"Custom":"Output","Exposed":"output","Address":"OSC:/mode"}]}],"SmallViewRack":[{"Processes":[3,4],"Process":null,"Height":200.0,"Nodal":true}],"FullViewRack":[{"Process":1,"Nodal":false},{"Process":0,"Nodal":true}],"DefaultDuration":157867862291,"MinDuration":157867862291,"MaxDuration":11854080000,"GuiDuration":255404242483,"Speed":1.0,"Rigidity":false,"MinNull":false,"MaxInf":true,"Signatures":[[0,[4,4]]],"StartState":0,"EndState":1,"StartDate":0,"HeightPercentage":0.0,"NodalSlotHeight":100.0,"QuantizationRate":-1.0,"Zoom":174385434.36748987,"Center":92050129714,"NodalCenter":[163.00000000000006,214.25],"ViewMode":1,"SmallViewShown":true,"HasSignature":true},"StartTimeNode":{"ObjectName":"Scenario::TimeSyncModel","id":0,"Metadata":{"ScriptingName":"Sync.start","Comment":"","Color":"Gray","Label":"","Touched":true},"Date":0,"Events":[0],"MusicalSync":-1.0,"AutoTrigger":false,"Start":true,"Active":false,"Expression":" { true == false } "},"EndTimeNode":{"ObjectName":"Scenario::TimeSyncModel","id":1,"Metadata":{"ScriptingName":"Sync.end","Comment":"","Color":"Gray","Label":"","Touched":true},"Date":157867862291,"Events":[1],"Musical