ain":{}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":2,"Hidden":true,"Custom":"Intensity","Exposed":"intensity","Scriptable":true,"Value":{"Float":42.64154052734375},"Init":{"Float":1.0},"Domain":{"Float":{"Min":0.0,"Max":100.0}}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":3,"Hidden":true,"Custom":"Range","Exposed":"range","Value":{"Float":1000.0},"Init":{"Float":0.0},"Domain":{"Float":{"Min":0.0,"Max":1000.0}}},{"uuid":"485680cc-b8b9-4a01-acc7-3e8334bdc016","ObjectName":"Inlet","id":4,"Hidden":true,"Custom":"Falloff","Exposed":"falloff","Value":{"Int":1},"Init":{"Int":2},"Domain":{"Int":{"Values":[0,1,2,3]}},"Values":[["None",{"Int":0}],["Linear",{"Int":1}],["Quadratic (physical)",{"Int":2}],["Cubic",{"Int":3}]],"FolderPort":"","FileExtensions":""},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":5,"Hidden":true,"Custom":"Inner cone °","Exposed":"inner cone _","Value":{"Float":0.0},"Init":{"Float":0.0},"Domain":{"Float":{"Min":0.0,"Max":90.0}}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":6,"Hidden":true,"Custom":"Outer cone °","Exposed":"outer cone _","Value":{"Float":0.0},"Init":{"Float":45.0},"Domain":{"Float":{"Min":0.0,"Max":90.0}}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":7,"Hidden":true,"Custom":"Width","Exposed":"width","Value":{"Float":1.0},"Init":{"Float":1.0},"Domain":{"Float":{"Min":0.009999999776482582,"Max":100.0}}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":8,"Hidden":true,"Custom":"Height","Exposed":"height","Value":{"Float":1.0},"Init":{"Float":1.0},"Domain":{"Float":{"Min":0.009999999776482582,"Max":100.0}}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":9,"Hidden":true,"Custom":"Radius","Exposed":"radius","Value":{"Float":24.057594299316406},"Init":{"Float":0.5},"Domain":{"Float":{"Min":0.009999999776482582,"Max":100.0}}},{"uuid":"fb27e4cb-ea7f-41e2-a