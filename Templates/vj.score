nt":8}],["Hard Light",{"Int":9}],["Hard Mix",{"Int":10}],["Lighten",{"Int":11}],["Linear Burn",{"Int":12}],["Linear Dodge",{"Int":13}],["Linear Light",{"Int":14}],["Multiply",{"Int":15}],["Negation",{"Int":16}],["Normal",{"Int":17}],["Overlay",{"Int":18}],["Phoenix",{"Int":19}],["Pin Light",{"Int":20}],["Reflect",{"Int":21}],["Screen",{"Int":22}],["Soft Light",{"Int":23}],["Subtract",{"Int":24}],["Vivid Light",{"Int":25}]],"FolderPort":"","FileExtensions":""}],"Outlets":[{"uuid":"f1c71046-b754-49a5-8e66-d01374773dfc","ObjectName":"Outlet","id":1,"Hidden":false,"Custom":"Texture Out","Exposed":"texture out"}]},{"uuid":"74ca45ff-92c9-44a0-8f1a-754dea05ee1b","ObjectName":"gfxProcess","id":20,"Metadata":{"ScriptingName":"Video Switcher 8","Comment":"","Color":"Transparent1","Label":"","Touched":true},"Duration":11289600000,"Height":300.0,"StartOffset":0,"LoopDuration":11289600000,"Pos":[1050.790733521928,116.83262462159357],"Size":[179.0,160.0],"Loops":false,"FoldMode":0,"Vertex":"","Fragment":"/*{\n    \"CATEGORIES\": [\n        \"General\"\n    ],\n    \"CREDIT\": \"Jean-Michaël Celerier\",\n    \"ISFVSN\": \"2\",\n    \"DESCRIPTION\": \"Video switcher\",\n    \"INPUTS\": [\n        { \"NAME\": \"t0\", \"LABEL\" : \"Texture 0\", \"TYPE\": \"image\" },\n        { \"NAME\": \"t1\", \"LABEL\" : \"Texture 1\", \"TYPE\": \"image\" },\n        { \"NAME\": \"t2\", \"LABEL\" : \"Texture 2\", \"TYPE\": \"image\" },\n        { \"NAME\": \"t3\", \"LABEL\" : \"Texture 3\", \"TYPE\": \"image\" },\n        { \"NAME\": \"t4\", \"LABEL\" : \"Texture 4\", \"TYPE\": \"image\" },\n        { \"NAME\": \"t5\", \"LABEL\" : \"Texture 5\", \"TYPE\": \"image\" },\n        { \"NAME\": \"t6\", \"LABEL\" : \"Texture 6\", \"TYPE\": \"image\" },\n        { \"NAME\": \"t7\", \"LABEL\" : \"Texture 7\", \"TYPE\": \"image\" },\n        { \"NAME\": \"index\", \"LABEL\" : \"Index\", \"DEFAULT\": 0, \"VALUES\": [0, 1, 2, 3, 4, 5, 6, 7], \"TYPE\": \"long\" }\n    ]\n}\n*/\n\nvoid main() {\n  int idx = int(index);\n  switch(idx) {\n    case 0: gl_FragColor = IMG_THIS_NORM_PIXEL(t0); break;\n    case 1: gl_FragColor = IMG_THIS_NORM_PIXEL(t1); break;\n    case 2: gl_FragColor = IMG_THIS_NORM_PIXEL(t2); break;\n    case 3: gl_FragColor = IMG_THIS_NORM_PIXEL(t3); break;\n    case 4: gl_FragColor = IMG_THIS_NORM_PIXEL(t4); break;\n    case 5: gl_FragColor = IMG_THIS_NORM_PIXEL(t5); break;\n    case 6: gl_FragColor = IMG_THIS_NORM_PIXEL(t6); break;\n    case 7: gl_FragColor = IMG_THIS_NORM_PIXEL(t7); break;\n    default: gl_FragColor = vec4(0.0, 0.0, 0.0, 1.0);\n\n  }\n}\n","Root":"<LIBRARY>:packages/default/Presets/GLSL_shaders/utility/Video Switcher 8.fs","Inlets":[{"uuid":"5ac86198-2d03-4830-9e41-a6d529922d29","ObjectName":"Inlet","id":0,"Hidden":false,"Custom":"t0","Exposed":"t0","Format":0,"FormatSet":false,"Filter":2,"AddressMode":1,"MipmapMode":0},{"uuid":"5ac86198-2d03-4830-9e41-a6d529922d29","ObjectName":"Inlet","id":1,"Hidden":false,"Custom":"t1","Exposed":"t1","Format":0,"FormatSet":false,"Filter":2,"AddressMode":1,"MipmapMode":0},{"uuid":"5ac86198-2d03-4830-9e41-a6d529922d29","ObjectName":"Inlet","id":2,"Hidden":false,"Custom":"t2","Exposed":"t2","Format":0,"FormatSet":false,"Filter":2,"AddressMode":1,"MipmapMode":0},{"uuid":"5ac86198-2d03-4830-9e41-a6d529922d29","ObjectName":"Inlet","id":3,"Hidden":false,"Custom":"t3","Exposed":"t3","Format":0,"FormatSet":false,"Filter":2,"AddressMode":1,"MipmapMode":0},{"uuid":"5ac86198-2d03-4830-9e41-a6d529922d29","ObjectName":"Inlet","id":4,"Hidden":false,"Custom":"t4","Exposed":"t4","Format":0,"FormatSet":false,"Filter":2,"AddressMode":1,"MipmapMode":0},{"uuid":"5ac86198-2d03-4830-9e41-a6d529922d29","ObjectName":"Inlet","id":5,"Hidden":false,"Custom":"t5","Exposed":"t5","Format":0,"FormatSet":false,"Filter":2,"AddressMode":1,"MipmapMode":0},{"uuid":"5ac86198-2d03-4830-9e41-a6d529922d29","ObjectName":"Inlet","id":6,"Hidden":false,"Custom":"t6","Exposed":"t6","Format":0,"FormatSet":false,"Filter":2,"AddressMode":1,"MipmapMode":0},{"uuid":"5ac86198-2d03-4830-9e41-a6d529922d29","ObjectName":"Inlet","id":7,"Hidden":false,"Custom":"t7","Exposed":"t7","Format":0,"FormatSet":false,"Filter":2,"AddressMode":1,"MipmapMode":0},{"uuid":"485680cc-b8b9-4a01-acc7-3e8334bdc016","ObjectName":"Inlet","id":8,"Hidden":true,"Custom":"index","Exposed":"index","Value":{"Int":0},"Init":{"Int":0},"Domain":{"Int":{"Values":[0,1,2,3,4,5,6,7]}},"Values":[["0",{"Int":0}],["1",{"Int":1}],["2",{"Int":2}],["3",{"Int":3}],["4",{"Int":4}],["5",{"Int":5}],["6",{"Int":6}],["7",{"Int":7}]],"FolderPort":"","FileExtensions":""}],"Outlets":[{"uuid":"f1c71046-b754-49a5-8e66-d01374773dfc","ObjectName":"Outlet","id":1,"Hidden":false,"Custom":"Texture Out","Exposed":"texture out","Address":"Window:/"}]},{"uuid":"0b1b1816-c33e-4796-a16d-5aab27fe600f","ObjectName":"LFO","id":21,"Metadata":{"ScriptingName":"LFO","Comment":"","Color":"Transparent1","Label":"","Touched":true},"Duration":11289600000,"Height":300.0,"StartOffset":0,"LoopDuration":11289600000,"Pos":[-415.7798534777632,87.46726335662314],"Size":[261.0,117.5],"Loops":false,"FoldMode":0,"Inlets":[{"uuid":"b631d9b7-cbe3-4d9c-b470-f139e348aecb","ObjectName":"Inlet","id":0,"Hidden":true,"Custom":"Period","Exposed":"period","Value":{"Vec2f":[0.5,1.0]},"Init":{"Vec2f":[0.5,1.0]},"Domain":{"Vec2f":{"Min":[0.009999999776482582,0.0],"Max":[60.0,1.0],"Values":[[],[]]}}},{"uuid":"82427d27-084a-4ab6-9c4e-db83929a1200","ObjectName":"Inlet","id":1,"Hidden":true,"Custom":"Shape","Exposed":"shape","Value":{"Float":0.5},"Init":{"Float":0.5},"Domain":{"Float":{"Min":0.0,"Max":1.0}}},{"uuid":"7cd210d3-ebd1-4f71-9de6-cccfb639cbc3","ObjectName":"Inlet","id":2,"Hidden":true,"Custom":"Retrigger","Exposed":"retrigger","Value":{"Impulse":null},"Init":{"Impulse":null},"Domain":{"Impulse":null}},{"uuid":"82427d27-084a-4ab6-9c4e-db83929a1200","ObjectName":"Inlet","id":3,"Hidden":true,"Custom":"Ampl.","Exposed":"ampl.","Value":{"Float":0.5},"Init":{"Float":0.5},"Domain":{"Float":{"Min":0.0,"Max":2.0}}},{"uuid":"82427d27-084a-4ab6-9c4e-db83929a1200","ObjectName":"Inlet","id":4,"Hidden":true,"Custom":"Offset","Exposed":"offset","Value":{"Float":0.5},"Init":{"Float":0.5},"Domain":{"Float":{"Min":-1.0,"Max":1.0}}},{"uuid":"82427d27-084a-4ab6-9c4e-db83929a1200","ObjectName":"Inlet","id":5,"Hidden":true,"Custom":"Jitter","Exposed":"jitter","Value":{"Float":0.0},"Init":{"Float":0.0},"Domain":{"Float":{"Min":0.0,"Max":180.0}}},{"uuid":"82427d27-084a-4ab6-9c4e-db83929a1200","ObjectName":"Inlet","id":6,"Hidden":true,"Custom":"Phase","Exposed":"phase","Value":{"Float":0.0},"Init":{"Float":0.0},"Domain":{"Float":{"Min":0.0,"Max":360.0}}},{"uuid":"8b1d76c4-3838-4ac0-9b9c-c12bc5db8e8a","ObjectName":"Inlet","id":7,"Hidden":true,"Custom":"Waveform","Exposed":"waveform","Value":{"String":"Sin"},"Init":{"String":"Sin"},"Domain":{"String":{"Values":["Sin","Triangle","Saw","RampDown","Square","SquareOnChange","SampleAndHoldEveryTick","SampleAndHold","Noise1","Noise2","Noise3","Drift"]}},"Values":["Sin","Triangle","Saw","RampDown","Square","SquareOnChange","SampleAndHoldEveryTick","SampleAndHold","Noise1","Noise2","Noise3","Drift"],"Pixmaps":[":/icons/wave_sin_off.png",":/icons/wave_sin_on.png",":/icons/wave_triangle_off.png",":/icons/wave_triangle_on.png",":/icons/wave_saw_off.png",":/icons/wave_saw_on.png",":/icons/wave_ramp_down_off.png",":/icons/wave_ramp_down_on.png",":/icons/wave_square_ticks_off.png",":/icons/wave_square_ticks_on.png",":/icons/wave_square_changes_off.png",":/icons/wave_square_changes_on.png",":/icons/wave_sample_and_hold_ticks_off.png",":/icons/wave_sample_and_hold_ticks_on.png",":/icons/wave_sample_and_hold_changes_off.png",":/icons/wave_sample_and_hold_changes_on.png",":/icons/wave_noise1_off.png",":/icons/wave_noise1_on.png",":/icons/wave_noise2_off.png",":/icons/wave_noise2_on.png",":/icons/wave_noise3_off.png",":/icons/wave_noise3_on.png",":/icons/wave_drift_off.png",":/icons/wave_drift_on.png"]},{"uuid":"fb27e4cb-ea7f-41e2-ad92-2354498c1b6b","ObjectName":"Inlet","id":8,"Hidden":true,"Custom":"Lock to bars","Exposed":"lock to bars","Value":{"Bool":false},"Init":{"Bool":false},"Domain":{"Bool":null}}],"Outlets":[{"uuid":"cff96158-cc72-46d7-99dc-b6038171375b","ObjectName":"Outlet","id":0,"Hidden":false,"Custom":"Out","Exposed":"out"}]},{"uuid":"8c8c1855-b96f-4231-b40a-453468e7f9ec","ObjectName":"avnd_beat_tracker","id":22,"Metadata":{"ScriptingName":"Beat Tracker","Comment":"","Color":"Transparent1","Label":"","Touched":true},"Duration":11289600000,"Height":300.0,"StartOffset":0,"LoopDuration":11289600000,"Pos":[-1284.510771408789,663.4385856266945],"Size":[307.0,122.5],"Loops":false,"FoldMode":0,"Inlets":[{"uuid":"a1574bb0-cbd4-4c7d-9417-0c25cfd1187b","ObjectName":"Inlet","id":0,"Hidden":false,"Custom":"In","Exposed":"in","Description":"Audio to track: a microphone on a drummer, a click, a DJ feed, a bus from elsewhere in the score. Channels are summed to mono. Ignored when Source is Events.","Address":"audio:/in/main"},{"uuid":"485680cc-b8b9-4a01-acc7-3e8334bdc016","ObjectName":"Inlet","id":1,"Hidden":true,"Custom":"Source","Exposed":"source","Description":"Where beats come from. Audio: listen to the input and detect onsets. Events: ignore the audio entirely and take beats from the Beat inlet (OSC, a footswitch, a clock). Audio + Events: both, whichever is alive.","Value":{"Int":0},"Init":{"Int":0},"Domain":{"Int":{"Values":[0,1,2]}},"Values":[["Audio",{"Int":0}],["Events",{"Int":1}],["Audio + Events",{"Int":2}]],"FolderPort":"","FileExtensions":""},{"uuid":"769dd38a-bfb3-4dc6-b52a-b6abb7afe2a3","ObjectName":"Inlet","id":2,"Hidden":false,"Custom":"Beat","Exposed":"beat","Description":"One message per beat, used when Source is Events. Send an int or a float and the value is taken as the beat NUMBER, which also gives the tracker the position in the bar; send anything else (a bang, a string, a list) and it counts as a plain beat, giving tempo and phase only. Timestamps are sample-accurate within the buffer."},{"uuid":"238399a0-7e81-47e3-896f-08e8856e2973","ObjectName":"Inlet","id":3,"Hidden":true,"Custom":"Events per beat","Exposed":"events per beat","Description":"How many messages arrive per beat. 1 for one message per beat, 4 for sixteenth notes in 4/4, 24 for MIDI clock. Only whole beats set the phase; subdivisions only refine the tempo.","Value":{"Int":1},"Init":{"Int":1},"Domain":{"Int":{"Min":1,"Max":24}}},{"uuid":"485680cc-b8b9-4a01-acc7-3e8334bdc016","ObjectName":"Inlet","id":4,"Hidden":true,"Custom":"Band","Exposed":"band","Description":"Which part of the spectrum to listen to. Full works on a finished mix; Kick (30-120 Hz) and Snare (150-400 Hz) are for a miked drum and ignore everything else; Transient (2-5 kHz) suits clicks and sticks. Narrowing the band is the single most effective way to stop the tracker hearing things that are not the beat.","Value":{"Int":0},"Init":{"Int":0},"Domain":{"Int":{"Values":[0,1,2,3,4]}},"Values":[["Full",{"Int":0}],["Kick",{"Int":1}],["Snare",{"Int":2}],["Transient",{"Int":3}],["Kick+Snare",{"Int":4}]],"FolderPort":"","FileExtensions":""},{"uuid":"fb27e4cb-ea7f-41e2-ad92-2354498c1b6b","ObjectName":"Inlet","id":5,"Hidden":true,"Custom":"Limit BPM range","Exposed":"limit bpm range","Description":"Restrict the search to Min/Max BPM. This is the main defence against half- and double-time errors. Turn it off if you would rather the tracker never second-guessed you.","Value":{"Bool":true},"Init":{"Bool":true},"Domain":{"Bool":null}},{"uuid":"10d62b0d-5bc9-4ac9-9540-9e8ac0c24947","ObjectName":"Inlet","id":6,"Hidden":true,"Custom":"Min BPM","Exposed":"min bpm","Description":"Slowest tempo considered. Set the pair to bracket the music you expect: a narrow range locks faster and is far less likely to settle on half or double the real tempo.","Value":{"Float":89.9461441040039},"Init":{"Float":80.0},"Domain":{"Float":{"Min":30.0,"Max":300.0}}},{"uuid":"10d62b0d-5bc9-4ac9-9540-9e8ac0c24947","ObjectName":"Inlet","id":7,"Hidden":true,"Custom":"Max BPM","Exposed":"max bpm","Description":"Fastest tempo considered. See Min BPM.","Value":{"Float":180.0},"Init":{"Float":160.0},"Domain":{"Float":{"Min":30.0,"Max":300.0}}},{"uuid":"fb27e4cb-ea7f-41e2-ad92-2354498c1b6b","ObjectName":"Inlet","id":8,"Hidden":true,"Custom":"Transport tempo hint","Exposed":"transport tempo hint","Description":"Start from the score's own tempo instead of from nothing. A tracker given a starting tempo locks in well under a second where a cold one needs several. Leave this on unless you are deliberately testing cold-start behaviour.","Value":{"Bool":false},"Init":{"Bool":true},"Domain":{"Bool":null}},{"uuid":"485680cc-b8b9-4a01-acc7-3e8334bdc016","ObjectName":"Inlet","id":9,"Hidden":true,"Custom":"Clock filter","Exposed":"clock filter","Description":"The loop that turns detected beats into a smooth clock. 2nd order is the tested default. 3rd order can settle a little flatter on very steady material but has not been measured against it here.","Value":{"Int":0},"Init":{"Int":0},"Domain":{"Int":{"Values":[0,1]}},"Values":[["DLL (2nd order)",{"Int":0}],["DLL (3rd order)",{"Int":1}]],"FolderPort":"","FileExtensions":""},{"uuid":"82427d27-084a-4ab6-9c4e-db83929a1200","ObjectName":"Inlet","id":10,"Hidden":true,"Custom":"Lookahead (ms)","Exposed":"lookahead (ms)","Description":"Emit each beat this early, so downstream processing and display latency land on time. Around 100 ms is nearly free in accuracy terms. Leave at 0 when driving from Events, which already arrive on time.","Value":{"Float":100.0},"Init":{"Float":0.0},"Domain":{"Float":{"Min":0.0,"Max":250.0}}},{"uuid":"82427d27-084a-4ab6-9c4e-db83929a1200","ObjectName":"Inlet","id":11,"Hidden":true,"Custom":"Offset (ms)","Exposed":"offset (ms)","Description":"Fixed timing trim, applied after Lookahead. Positive delays the beat, negative advances it. Use it to compensate a mic distance or a converter's latency.","Value":{"Float":0.0},"Init":{"Float":0.0},"Domain":{"Float":{"Min":-250.0,"Max":250.0}}},{"uuid":"82427d27-084a-4ab6-9c4e-db83929a1200","ObjectName":"Inlet","id":12,"Hidden":true,"Custom":"Gate (dB)","Exposed":"gate (db)","Description":"Input level below which the signal counts as silence, at which point the clock holds its last tempo rather than chasing noise. Raise it if room tone or bleed is keeping the tracker awake.","Value":{"Float":-40.0},"Init":{"Float":-60.0},"Domain":{"Float":{"Min":-90.0,"Max":0.0}}},{"uuid":"fb27e4cb-ea7f-41e2-ad92-2354498c1b6b","ObjectName":"Inlet","id":13,"Hidden":true,"Custom":"Whitening","Exposed":"whitening","Description":"Continuously equalise the spectrum before onset detection, so quiet and loud passages contribute alike. Helps on a full mix or a room mic with a wide dynamic range; unnecessary on a close-miked drum.","Value":{"Bool":true},"Init":{"Bool":false},"Domain":{"Bool":null}},{"uuid":"238399a0-7e81-47e3-896f-08e8856e2973","ObjectName":"Inlet","id":14,"Hidden":true,"Custom":"Beats per bar","Exposed":"beats per bar","Description":"Time signature numerator, used to decide which beats are downbeats and to compute Bar phase. It does not affect tempo tracking.","Value":{"Int":4},"Init":{"Int":4},"Domain":{"Int":{"Min":1,"Max":16}}},{"uuid":"7cd210d3-ebd1-4f71-9de6-cccfb639cbc3","ObjectName":"Inlet","id":15,"Hidden":true,"Custom":"Tap","Exposed":"tap","Description":"When unlocked, tap in time to set the tempo (taps are averaged; pause for two seconds to start a fresh series). Once locked, a single tap resets the phase so the next beat is now.","Value":{"Impulse":null},"Init":{"Impulse":null},"Domain":{"Impulse":null}},{"uuid":"7cd210d3-ebd1-4f71-9de6-cccfb639cbc3","ObjectName":"Inlet","id":16,"Hidden":true,"Custom":"Resync","Exposed":"resync","Description":"Declare that now is beat one. Snaps the downbeat without touching the tempo.","Value":{"Impulse":null},"Init":{"Impulse":null},"Domain":{"Impulse":null}},{"uuid":"7cd210d3-ebd1-4f71-9de6-cccfb639cbc3","ObjectName":"Inlet","id":17,"Hidden":true,"Custom":"Nudge -","Exposed":"nudge -","Description":"Momentarily slow down, to pull the clock back in line with a performer who is ahead. Returns to the tracked tempo on release.","Value":{"Impulse":null},"Init":{"Impulse":null},"Domain":{"Impulse":null}},{"uuid":"7cd210d3-ebd1-4f71-9de6-cccfb639cbc3","ObjectName":"Inlet","id":18,"Hidden":true,"Custom":"Nudge +","Exposed":"nudge _","Description":"Momentarily speed up, to push the clock forward towards a performer who is behind. Returns to the tracked tempo on release.","Value":{"Impulse":null},"Init":{"Impulse":null},"Domain":{"Impulse":null}},{"uuid":"7cd210d3-ebd1-4f71-9de6-cccfb639cbc3","ObjectName":"Inlet","id":19,"Hidden":true,"Custom":"x2","Exposed":"x2","Description":"Double the tempo without re-detecting, for when the tracker settled an octave low.","Value":{"Impulse":null},"Init":{"Impulse":null},"Domain":{"Impulse":null}},{"uuid":"7cd210d3-ebd1-4f71-9de6-cccfb639cbc3","ObjectName":"Inlet","id":20,"Hidden":true,"Custom":"/2","Exposed":"_2","Description":"Halve the tempo without re-detecting, for when the tracker settled an octave high.","Value":{"Impulse":null},"Init":{"Impulse":null},"Domain":{"Impulse":null}},{"uuid":"fb27e4cb-ea7f-41e2-ad92-2354498c1b6b","ObjectName":"Inlet","id":21,"Hidden":true,"Custom":"Hold","Exposed":"hold","Description":"Freeze the tempo at its current value while still following the beat's phase. For a passage where you trust the tempo but not what the tracker is hearing - a breakdown, a solo, heavy bleed.","Value":{"Bool":false},"Init":{"Bool":false},"Domain":{"Bool":null}},{"uuid":"fb27e4cb-ea7f-41e2-ad92-2354498c1b6b","ObjectName":"Inlet","id":22,"Hidden":true,"Custom":"Follow","Exposed":"follow","Description":"Master switch. Off freezes the clock entirely and stops analysing, leaving the last tempo and phase in place.","Value":{"Bool":true},"Init":{"Bool":true},"Domain":{"Bool":null}}],"Outlets":[{"uuid":"cff96158-cc72-46d7-99dc-b6038171375b","ObjectName":"Outlet","id":0,"Hidden":false,"Custom":"Tempo","Exposed":"tempo","Description":"Detected tempo in BPM, smoothed for display. Cable this to an interval's Tempo inlet to drive the timeline."},{"uuid":"cff96158-cc72-46d7-99dc-b6038171375b","ObjectName":"Outlet","id":1,"Hidden":false,"Custom":"Speed","Exposed":"speed","Description":"Playback rate multiplier: 1 means the score's tempo already matches, above 1 means speed up to catch the performer. This is the port to feed a synchroniser or an interval's Speed inlet; unlike Tempo it corrects phase as well, gradually and within safe limits."},{"uuid":"cff96158-cc72-46d7-99dc-b6038171375b","ObjectName":"Outlet","id":2,"Hidden":false,"Custom":"Phase","Exposed":"phase","Description":"Position within the current beat, 0 at the beat and approaching 1 just before the next. Continuous, so it is safe to map to a parameter directly."},{"uuid":"cff96158-cc72-46d7-99dc-b6038171375b","ObjectName":"Outlet","id":3,"Hidden":false,"Custom":"Bar phase","Exposed":"bar phase","Description":"Position within the current bar, 0 at the downbeat approaching 1. Depends on Beats per bar and on the downbeat being correct - use Resync, or send beat numbers, to place it."},{"uuid":"cff96158-cc72-46d7-99dc-b6038171375b","ObjectName":"Outlet","id":4,"Hidden":false,"Custom":"Beat index","Exposed":"beat index","Description":"Beats counted since tracking started. Increments by one on every beat and never goes backwards."},{"uuid":"cff96158-cc72-46d7-99dc-b6038171375b","ObjectName":"Outlet","id":5,"Hidden":false,"Custom":"Next beat (s)","Exposed":"next beat (s)","Description":"Seconds until the next beat, already advanced by Lookahead. Use this to schedule something ahead of time instead of reacting to the Beat pulse."},{"uuid":"cff96158-cc72-46d7-99dc-b6038171375b","ObjectName":"Outlet","id":6,"Hidden":false,"Custom":"Confidence","Exposed":"confidence","Description":"How much the tracker trusts its own reading, 0 to 1. Falls during breakdowns, silence and material with no clear pulse. Worth mapping to a fallback so the score can react to the tracker losing the plot instead of following it blindly."},{"uuid":"cff96158-cc72-46d7-99dc-b6038171375b","ObjectName":"Outlet","id":7,"Hidden":false,"Custom":"Locked","Exposed":"locked","Description":"True once the clock has settled: either the evidence is strong or the tempo has simply held steady for a few seconds. While locked the tracker corrects gently; while unlocked it hunts."},{"uuid":"cff96158-cc72-46d7-99dc-b6038171375b","ObjectName":"Outlet","id":8,"Hidden":false,"Custom":"Valid","Exposed":"valid","Description":"False when there is nothing to track - the input is below the gate, or no events have arrived. The clock keeps running on its last tempo; this tells you not to trust it."},{"uuid":"cff96158-cc72-46d7-99dc-b6038171375b","ObjectName":"Outlet","id":9,"Hidden":false,"Custom":"Beat","Exposed":"beat","Description":"Fires on every beat, timed to the sample. Advanced by Lookahead and trimmed by Offset."},{"uuid":"cff96158-cc72-46d7-99dc-b6038171375b","ObjectName":"Outlet","id":10,"Hidden":false,"Custom":"Downbeat","Exposed":"downbeat","Description":"Fires on the first beat of each bar, according to Beats per bar."},{"uuid":"cff96158-cc72-46d7-99dc-b6038171375b","ObjectName":"Outlet","id":11,"Hidden":false,"Custom":"Onset","Exposed":"onset","Description":"Fires on every detected attack, not only on beats. Useful for triggering off the raw playing rather than the inferred grid."}]},{"uuid":"3f4a41f2-fa39-420f-ab0f-0af6b8409edb","ObjectName":"Display","id":23,"Metadata":{"ScriptingName":"Value display.23","Comment":"","Color":"Transparent1","Label":"","Touched":false},"Duration":11289600000,"Height":300.0,"StartOffset":0,"LoopDuration":11289600000,"Pos":[-938.1217814395794,663.4385856266945],"Size":[200.0,20.0],"Loops":false,"FoldMode":0,"Inlets":[{"uuid":"769dd38a-bfb3-4dc6-b52a-b6abb7afe2a3","ObjectName":"Inlet","id":0,"Hidden":true,"Custom":"Input","Exposed":"input","Description":"Values to display, including every event in a tick."},{"uuid":"238399a0-7e81-47e3-896f-08e8856e2973","ObjectName":"Inlet","id":1,"Hidden":true,"Custom":"Log","Exposed":"log","Description":"Number of recent values to retain, newest first.","Value":{"Int":1},"Init":{"Int":1},"Domain":{"Int":{"Min":1,"Max":100}}},{"uuid":"485680cc-b8b9-4a01-acc7-3e8334bdc016","ObjectName":"Inlet","id":2,"Hidden":true,"Custom":"Format","Exposed":"format","Description":"Ordinary text, indented Pretty text, or Hex bytes. Hex shows raw string bytes, including UTF-8 bytes, NUL and high-bit bytes. Numbers must be exact integers from 0 to 255; booleans are 00 or 01. Flat numeric lists and vectors use one byte per element. Empty strings and lists show [empty]. Other values show [not byte data] followed by ordinary text; no wrapping, truncation or memory reinterpretation.","Value":{"Int":0},"Init":{"Int":0},"Domain":{"Int":{"Values":[0,1,2]}},"Values":[["Ordinary",{"Int":0}],["Pretty",{"Int":1}],["Hex",{"Int":2}]],"FolderPort":"","FileExtensions":""}],"Outlets":[{"uuid":"3620ea94-5991-41cf-89b3-11f842cc39d0","ObjectName":"Outlet","id":0,"Hidden":true,"Custom":"values","Exposed":"values","Description":"Recent values and their sequence number for the display.","Value":{"Tuple":[{"Int":28593},{"Float":137.22943115234375}]},"Domain":{}}]},{"uuid":"3f4a41f2-fa39-420f-ab0f-0af6b8409edb","ObjectName":"Display","id":24,"Metadata":{"ScriptingName":"Value display.24","Comment":"","Color":"Transparent1","Label":"","Touched":false},"Duration":11289600000,"Height":300.0,"StartOffset":0,"LoopDuration":11289600000,"Pos":[-938.1217814395794,691.4385856266945],"Size":[200.0,20.0],"Loops":false,"FoldMode":0,"Inlets":[{"uuid":"769dd38a-bfb3-4dc6-b52a-b6abb7afe2a3","ObjectName":"Inlet","id":0,"Hidden":true,"Custom":"Input","Exposed":"input","Description":"Values to display, including every event in a tick."},{"uuid":"238399a0-7e81-47e3-896f-08e8856e2973","ObjectName":"Inlet","id":1,"Hidden":true,"Custom":"Log","Exposed":"log","Descr