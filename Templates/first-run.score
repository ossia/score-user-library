,"ObjectName":"Inlet","id":8,"Hidden":true,"Custom":"Lock to bars","Exposed":"lock to bars","Value":{"Bool":false},"Init":{"Bool":false},"Domain":{"Bool":null}}],"Outlets":[{"uuid":"cff96158-cc72-46d7-99dc-b6038171375b","ObjectName":"Outlet","id":0,"Hidden":false,"Custom":"Out","Exposed":"out"}]},{"uuid":"d2a67bd8-5d3f-404e-b6e9-e350cf2a833f","ObjectName":"Automation","id":24,"Metadata":{"ScriptingName":"Automation (float).24","Comment":"","Color":"Transparent1","Label":"","Touched":false},"Duration":11289600000,"Height":300.0,"StartOffset":0,"LoopDuration":11289600000,"Pos":[466.0,466.0],"Size":[200.0,100.0],"Loops":false,"FoldMode":0,"Outlet":{"uuid":"047e4cc2-4d99-4e8b-bf98-206018d02274","ObjectName":"Outlet","id":0,"Hidden":false,"Custom":"Out","Exposed":"out","MinInlet":{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":0,"Hidden":false,"Custom":"Min","Exposed":"min","Value":{"Float":0.0},"Init":{},"Domain":{}},"MaxInlet":{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":1,"Hidden":false,"Custom":"Max","Exposed":"max","Value":{"Float":2.0},"Init":{},"Domain":{}}},"Curve":{"ObjectName":"CurveModel","id":45345,"Segments":[{"uuid":"1e7cb83f-4e47-4b14-814d-2242a9c75991","ObjectName":"CurveSegmentModel","id":0,"Previous":null,"Following":null,"Start":[0.0,0.0],"End":[1.0,0.25],"Power":2.788534645390912}]},"Tween":false}],"SmallViewRack":[{"Processes":[2,3,5,8,9,10,13,14,15,16,17,18,19,20,22,23],"Process":null,"Height":182.0,"Nodal":true},{"Processes":[21],"Process":21,"Height":43.0,"Nodal":false},{"Processes":[24],"Process":24,"Height":70.0,"Nodal":false}],"FullViewRack":[{"Process":0,"Nodal":true},{"Process":21,"Nodal":false},{"Process":24,"Nodal":false}],"DefaultDuration":11289600000,"MinDuration":11289600000,"MaxDuration":11289600000,"GuiDuration":106406120979,"Speed":1.0,"Rigidity":true,"MinNull":false,"MaxInf":false,"Signatures":[],"StartState":53,"EndState":54,"StartDate":33868800000,"HeightPercentage":0.05723443223443223,"NodalSlotHeight":845.0,"QuantizationRate":-1.0,"Zoom":85329688.03448276,"Center":53160395645,"NodalCenter":[608.855338553961,26.122576289988285],"NodalScale":0.7029367638019338,"ViewMode":1,"SmallViewShown":false,"HasSignature":false},{"ObjectName":"Scenario::IntervalModel","id":49,"Metadata":{"ScriptingName":"Voxels","Comment":"","Color":"Transparent1","Label":"","Touched":true},"Inlet":{"uuid":"a1574bb0-cbd4-4c7d-9417-0c25cfd1187b","ObjectName":"Inlet","id":0,"Hidden":false,"Custom":"Audio In","Exposed":"audio in"},"Outlet":{"uuid":"a1d97535-18ac-444a-8417-0cbc1692d897","ObjectName":"Outlet","id":0,"Hidden":false,"Custom":"Audio Out","Exposed":"audio out","Address":"audio:/out/main","GainInlet":{"uuid":"9a13fb32-269a-47bf-99a9-930188c1f19c","ObjectName":"Inlet","id":10000,"Hidden":false,"Custom":"Gain","Exposed":"gain","Value":{},"Init":{},"Domain":{"Float":{"Min":0.0,"Max":1.0}}},"PanInlet":{"uuid":"9a13fb32-269a-47bf-99a9-930188c1f19c","ObjectName":"Inlet","id":10001,"Hidden":false,"Custom":"Pan","Exposed":"pan","Value":{},"Init":{},"Domain":{}},"Gain":1.0,"Pan":[1.0,1.0],"Propagate":true},"Processes":[{"uuid":"74ca45ff-92c9-44a0-8f1a-754dea05ee1b","ObjectName":"gfxProcess","id":2,"Metadata":{"ScriptingName":"VolumeRaymarcher","Comment":"","Color":"Transparent1","Label":"","Touched":true},"Duration":14112000000,"Height":300.0,"StartOffset":0,"LoopDuration":16934400000,"Pos":[551.8910386691858,-791.4230667320815],"Size":[403.0,176.0],"Loops":false,"FoldMode":2,"Vertex":"","Fragment":"/*{\n  \"DESCRIPTION\": \"Volumetric raymarcher for 3D textures: renders the volume (the unit cube) as a translucent cloud, coloured by its rgb, with density taken from alpha (or from rgb brightness when alpha is 1 everywhere). densityScale x absorption sets how opaque it gets, threshold hides faint density, steps trades quality for speed. Optional gradient lighting (lightDir, lightStrength, ambientLight). Orbit camera: cameraAngle and cameraPitch in radians, cameraDistance from the centre, autoRotate in radians per second. Outside the cloud the output is transparent, so it composites over whatever is below. Connect any 3D texture producer to the 'volume' input.\",\n  \"CREDIT\": \"ossia score\",\n  \"ISFVSN\": \"2.0\",\n  \"ALPHA\": \"premultiplied\",\n  \"CATEGORIES\": [\"Renderer\", \"3D\", \"Volume\"],\n  \"INPUTS\": [\n    { \"NAME\": \"volume\", \"TYPE\": \"image\", \"DIMENSIONS\": 3 },\n    {\n      \"NAME\": \"steps\",\n      \"TYPE\": \"float\",\n      \"DEFAULT\": 128,\n      \"MIN\": 16,\n      \"MAX\": 512\n    },\n    {\n      \"NAME\": \"densityScale\",\n      \"TYPE\": \"float\",\n      \"DEFAULT\": 10.0,\n      \"MIN\": 0.1,\n      \"MAX\": 50.0\n    },\n    {\n      \"NAME\": \"threshold\",\n      \"TYPE\": \"float\",\n      \"DEFAULT\": 0.02,\n      \"MIN\": 0.0,\n      \"MAX\": 1.0\n    },\n    {\n      \"NAME\": \"absorption\",\n      \"TYPE\": \"float\",\n      \"DEFAULT\": 1.5,\n      \"MIN\": 0.0,\n      \"MAX\": 10.0\n    },\n    {\n      \"NAME\": \"cameraAngle\",\n      \"TYPE\": \"float\",\n      \"DEFAULT\": 0.0,\n      \"MIN\": -3.14159,\n      \"MAX\": 3.14159\n    },\n    {\n      \"NAME\": \"cameraPitch\",\n      \"TYPE\": \"float\",\n      \"DEFAULT\": 0.3,\n      \"MIN\": -1.5,\n      \"MAX\": 1.5\n    },\n    {\n      \"NAME\": \"cameraDistance\",\n      \"TYPE\": \"float\",\n      \"DEFAULT\": 2.5,\n      \"MIN\": 0.5,\n      \"MAX\": 10.0\n    },\n    {\n      \"NAME\": \"autoRotate\",\n      \"TYPE\": \"float\",\n      \"DEFAULT\": 0.3,\n      \"MIN\": 0.0,\n      \"MAX\": 3.0\n    },\n    {\n      \"NAME\": \"lightDir\",\n      \"TYPE\": \"point3D\",\n      \"DEFAULT\": [0.5, 0.8, 0.3],\n      \"MIN\": [-1.0, -1.0, -1.0],\n      \"MAX\": [1.0, 1.0, 1.0]\n    },\n    {\n      \"NAME\": \"lightStrength\",\n      \"TYPE\": \"float\",\n      \"DEFAULT\": 1.2,\n      \"MIN\": 0.0,\n      \"MAX\": 5.0\n    },\n    {\n      \"NAME\": \"ambientLight\",\n      \"TYPE\": \"float\",\n      \"DEFAULT\": 0.25,\n      \"MIN\": 0.0,\n      \"MAX\": 1.0\n    },\n    {\n      \"NAME\": \"enableLighting\",\n      \"TYPE\": \"bool\",\n      \"DEFAULT\": true\n    }\n  ]\n}*/\n\n// Ray-AABB intersection for unit cube [0,1]³\nvec2 intersectBox(vec3 ro, vec3 rd)\n{\n  vec3 invRd = 1.0 / rd;\n  vec3 t0 = -ro * invRd;\n  vec3 t1 = (1.0 - ro) * invRd;\n  vec3 tmin = min(t0, t1);\n  vec3 tmax = max(t0, t1);\n  float tNear = max(max(tmin.x, tmin.y), tmin.z);\n  float tFar  = min(min(tmax.x, tmax.y), tmax.z);\n  return vec2(tNear, tFar);\n}\n\n// Estimate gradient normal via central differences\nvec3 gradientNormal(vec3 pos, float eps)\n{\n  float dx = texture(volume, pos + vec3(eps, 0, 0)).a\n           - texture(volume, pos - vec3(eps, 0, 0)).a;\n  float dy = texture(volume, pos + vec3(0, eps, 0)).a\n           - texture(volume, pos - vec3(0, eps, 0)).a;\n  float dz = texture(volume, pos + vec3(0, 0, eps)).a\n           - texture(volume, pos - vec3(0, 0, eps)).a;\n  vec3 g = vec3(dx, dy, dz);\n  float len = length(g);\n  return len > 0.0001 ? g / len : vec3(0.0, 1.0, 0.0);\n}\n\nvoid main()\n{\n  vec2 uv = isf_FragNormCoord * 2.0 - 1.0;\n  uv.x *= RENDERSIZE.x / RENDERSIZE.y;\n\n  // Orbit camera around volume center\n  vec3 center = vec3(0.5);\n  float angle = cameraAngle + TIME * autoRotate;\n  float cp = cos(cameraPitch);\n  vec3 eye = center + cameraDistance * vec3(cos(angle) * cp, sin(cameraPitch), sin(angle) * cp);\n\n  vec3 forward = normalize(center - eye);\n  vec3 right   = normalize(cross(forward, vec3(0.0, 1.0, 0.0)));\n  vec3 up      = cross(right, forward);\n  vec3 rd      = normalize(forward * 1.5 + uv.x * right + uv.y * up);\n\n  // Intersect ray with volume bounding box\n  vec2 tHit = intersectBox(eye, rd);\n  if(tHit.x > tHit.y || tHit.y < 0.0)\n  {\n    isf_FragColor = vec4(0.0);\n    return;\n  }\n  tHit.x = max(tHit.x, 0.0);\n\n  // Raymarching setup\n  int numSteps = int(steps);\n  float stepSize = (tHit.y - tHit.x) / float(numSteps);\n\n  // Jitter start to reduce banding\n  float jitter = fract(sin(dot(gl_FragCoord.xy, vec2(12.9898, 78.233))) * 43758.5453);\n  float t = tHit.x + stepSize * jitter;\n\n  vec3 L = normalize(lightDir);\n  float gradEps = 1.5 / 128.0; // ~1 texel for gradient estimation\n\n  vec4 accum = vec4(0.0);\n\n  for(int i = 0; i < numSteps; i++)\n  {\n    if(accum.a > 0.99)\n      break;\n\n    vec3 pos = eye + rd * t;\n    vec4 samp = texture(volume, pos);\n\n    // Density: alpha when the producer uses it (alpha < 1 somewhere), else the\n    // luminance of rgb. Most shaderlib/volume generators store density in rgb\n    // with alpha fixed at 1; the old \"fall back only when alpha == 0\" test\n    // read those as a uniformly opaque cube and rendered it black.\n    float density = samp.a < 0.999 ? samp.a : dot(samp.rgb, vec3(0.299, 0.587, 0.114));\n\n    if(density > threshold)\n    {\n      vec3 color = samp.rgb;\n\n      // Gradient-based lighting\n      if(enableLighting)\n      {\n        // Density grows inward, so its gradient points into the blob; the\n        // outward surface normal is -grad (Levoy, \"Display of Surfaces from\n        // Volume Data\", IEEE CG&A 1988). Using +grad lit the far side.\n        vec3 N = -gradientNormal(pos, gradEps);\n        float NdotL = max(dot(N, L), 0.0);\n        float lighting = ambientLight + (1.0 - ambientLight) * NdotL * lightStrength;\n        color *= lighting;\n      }\n\n      // Beer-Lambert absorption\n      float alpha = 1.0 - exp(-density * densityScale * stepSize * absorption);\n\n      // Front-to-back compositing\n      accum.rgb += (1.0 - accum.a) * color * alpha;\n      accum.a   += (1.0 - accum.a) * alpha;\n    }\n\n    t += stepSize;\n  }\n\n  isf_FragColor = accum;\n}\n","Root":"<LIBRARY>:packages/score-csf-testers/shaderlib/renderers/VolumeRaymarcher.fs","Inlets":[{"uuid":"5ac86198-2d03-4830-9e41-a6d529922d29","ObjectName":"Inlet","id":0,"Hidden":false,"Custom":"volume","Exposed":"volume","Format":0,"FormatSet":false,"Filter":2,"AddressMode":1,"MipmapMode":0},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":1,"Hidden":true,"Custom":"steps","Exposed":"steps","Value":{"Float":128.0},"Init":{"Float":128.0},"Domain":{"Float":{"Min":16.0,"Max":512.0}}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":2,"Hidden":true,"Custom":"densityScale","Exposed":"densityscale","Value":{"Float":10.0},"Init":{"Float":10.0},"Domain":{"Float":{"Min":0.10000000149011612,"Max":50.0}}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":3,"Hidden":true,"Custom":"threshold","Exposed":"threshold","Value":{"Float":0.7666666507720947},"Init":{"Float":0.019999999552965164},"Domain":{"Float":{"Min":0.0,"Max":1.0}}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":4,"Hidden":true,"Custom":"absorption","Exposed":"absorption","Value":{"Float":1.1666666269302368},"Init":{"Float":1.5},"Domain":{"Float":{"Min":0.0,"Max":10.0}}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":5,"Hidden":true,"Custom":"cameraAngle","Exposed":"cameraangle","Value":{"Float":0.0},"Init":{"Float":0.0},"Domain":{"Float":{"Min":-3.141590118408203,"Max":3.141590118408203}}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":6,"Hidden":true,"Custom":"cameraPitch","Exposed":"camerapitch","Value":{"Float":0.30000001192092896},"Init":{"Float":0.30000001192092896},"Domain":{"Float":{"Min":-1.5,"Max":1.5}}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":7,"Hidden":true,"Custom":"cameraDistance","Exposed":"cameradistance","Value":{"Float":1.0},"Init":{"Float":2.5},"Domain":{"Float":{"Min":0.5,"Max":10.0}}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":8,"Hidden":true,"Custom":"autoRotate","Exposed":"autorotate","Value":{"Float":0.30000001192092896},"Init":{"Float":0.30000001192092896},"Domain":{"Float":{"Min":0.0,"Max":3.0}}},{"uuid":"377e8205-b442-4d54-8832-3761def522b2","ObjectName":"Inlet","id":9,"Hidden":true,"Custom":"lightDir","Exposed":"lightdir","Value":{"Vec3f":[0.5,0.800000011920929,0.30000001192092896]},"Init":{"Vec3f":[0.5,0.800000011920929,0.30000001192092896]},"Domain":{"Vec3f":{"Min":[-1.0,-1.0,-1.0],"Max":[1.0,1.0,1.0],"Values":[[],[],[]]}}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":10,"Hidden":true,"Custom":"lightStrength","Exposed":"lightstrength","Value":{"Float":1.75},"Init":{"Float":1.2000000476837158},"Domain":{"Float":{"Min":0.0,"Max":5.0}}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":11,"Hidden":true,"Custom":"ambientLight","Exposed":"ambientlight","Value":{"Float":0.25},"Init":{"Float":0.25},"Domain":{"Float":{"Min":0.0,"Max":1.0}}},{"uuid":"fb27e4cb-ea7f-41e2-ad92-2354498c1b6b","ObjectName":"Inlet","id":12,"Hidden":true,"Custom":"enableLighting","Exposed":"enablelighting","Value":{"Bool":false},"Init":{"Bool":true},"Domain":{"Bool":null}}],"Outlets":[{"uuid":"f1c71046-b754-49a5-8e66-d01374773dfc","ObjectName":"Outlet","id":1,"Hidden":false,"Custom":"Texture Out","Exposed":"texture out"}]},{"uuid":"a5bbffe0-93d2-4e70-995c-cf46c2c43520","ObjectName":"CSF","id":3,"Metadata":{"ScriptingName":"01-04_worley_f1","Comment":"","Color":"Transparent1","Label":"","Touched":true},"Duration":14112000000,"Height":300.0,"StartOffset":0,"LoopDuration":16934400000,"Pos":[-654.0,-164.5],"Size":[165.0,70.0],"Loops":false,"FoldMode":0,"Compute":"/*{\n  \"DESCRIPTION\": \"3D Worley (cellular) noise, F1 distance \\u2014 distance to nearest feature point. Produces pebble / cell patterns. Small scale \\u2192 many cells, big scale \\u2192 few.\",\n  \"CREDIT\": \"ossia 3D catalog\",\n  \"ISFVSN\": \"2.0\",\n  \"MODE\": \"COMPUTE_SHADER\",\n  \"CATEGORIES\": [\n    \"3D-GENERATOR\",\n    \"NOISE\"\n  ],\n  \"INPUTS\": [\n    {\n      \"NAME\": \"scale\",\n      \"TYPE\": \"float\",\n      \"DEFAULT\": 6.0,\n      \"MIN\": 1.0,\n      \"MAX\": 32.0,\n      \"LABEL\": \"Scale\"\n    },\n    {\n      \"NAME\": \"drift\",\n      \"TYPE\": \"float\",\n      \"DEFAULT\": 0.15,\n      \"MIN\": 0.0,\n      \"MAX\": 2.0,\n      \"LABEL\": \"Drift\"\n    }\n  ],\n  \"RESOURCES\": [\n    {\n      \"NAME\": \"volume\",\n      \"TYPE\": \"image\",\n      \"ACCESS\": \"write_only\",\n      \"WIDTH\": \"64\",\n      \"HEIGHT\": \"64\",\n      \"DEPTH\": \"64\"\n    }\n  ],\n  \"PASSES\": [\n    {\n      \"LOCAL_SIZE\": [\n        4,\n        4,\n        4\n      ],\n      \"EXECUTION_MODEL\": {\n        \"TYPE\": \"3D_IMAGE\",\n        \"TARGET\": \"volume\"\n      }\n    }\n  ]\n}*/\n\n// --- Hashing & random ----------------------------------------------------\nfloat hash11(float n){ return fract(sin(n)*43758.5453123); }\nfloat hash13(vec3 p){\n    p = fract(p * 0.3183099 + 0.1);\n    p *= 17.0;\n    return fract(p.x*p.y*p.z*(p.x+p.y+p.z));\n}\nvec3 hash33(vec3 p){\n    p = vec3(dot(p,vec3(127.1,311.7, 74.7)),\n             dot(p,vec3(269.5,183.3,246.1)),\n             dot(p,vec3(113.5,271.9,124.6)));\n    return fract(sin(p) * 43758.5453123);\n}\n\n// Worley 3D: returns vec2(F1, F2) — distances to nearest / 2nd-nearest feature points.\nvec2 worley(vec3 x){\n    vec3 p = floor(x);\n    vec3 f = fract(x);\n    float F1 = 1e9, F2 = 1e9;\n    for(int k=-1;k<=1;k++)\n    for(int j=-1;j<=1;j++)\n    for(int i=-1;i<=1;i++){\n        vec3 b = vec3(i,j,k);\n        vec3 r = b + hash33(p+b) - f;\n        float d = dot(r,r);\n        if(d < F1){ F2 = F1; F1 = d; }\n        else if(d < F2){ F2 = d; }\n    }\n    return sqrt(vec2(F1, F2));\n}\n\nvoid main()\n{\n    ivec3 pos = ivec3(gl_GlobalInvocationID.xyz);\n    ivec3 size = imageSize(volume);\n    if(any(greaterThanEqual(pos, size))) return;\n    vec3 p  = (vec3(pos) + 0.5) / vec3(size);   // [0,1]^3\n    vec3 pc = p * 2.0 - 1.0;                     // [-1,1]^3\n\n    vec2 w = worley(pc * scale + vec3(TIME*drift));\n    float v = clamp(w.x, 0.0, 1.0);\n    imageStore(volume, pos, vec4(vec3(v), 1.0));\n\n}\n","Root":"<LIBRARY>:packages/score-csf-testers/archive/2026-09-25/volume/01-04_worley_f1.cs","Inlets":[{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":0,"Hidden":true,"Custom":"scale","Exposed":"scale","Value":{"Float":2.2916667461395264},"Init":{"Float":6.0},"Domain":{"Float":{"Min":1.0,"Max":32.0}}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":1,"Hidden":true,"Custom":"drift","Exposed":"drift","Value":{"Float":0.15000000596046448},"Init":{"Float":0.15000000596046448},"Domain":{"Float":{"Min":0.0,"Max":2.0}}}],"Outlets":[{"uuid":"f1c71046-b754-49a5-8e66-d01374773dfc","ObjectName":"Outlet","id":0,"Hidden":false,"Custom":"volume","Exposed":"volume"}]},{"uuid":"a5bbffe0-93d2-4e70-995c-cf46c2c43520","ObjectName":"CSF","id":5,"Metadata":{"ScriptingName":"10-08_volume_switcher8","Comment":"","Color":"Transparent1","Label":"","Touched":true},"Duration":14112000000,"Height":300.0,"StartOffset":0,"LoopDuration":22579200000,"Pos":[-257.8085819747048,-29.5],"Size":[218.0,160.0],"Loops":false,"FoldMode":0,"Compute":"/*{\n  \"DESCRIPTION\": \"Volume switcher: forwards one of eight 3D volumes, chosen by Index. The 3D counterpart of the Video Switcher 8 utility (which switches 2D images and can only output a 2D image), so a whole volume chain can be swapped live before one viewer. The output takes the largest size among the connected inputs (an unconnected input is a 1x1x1 placeholder), fixed when the node is built; each input is sampled at normalised coordinates, so a smaller volume is resampled trilinearly to that grid, as a smaller image is stretched by the 2D switcher. Selecting an unconnected slot gives an empty volume (all zero: no colour, no density). The output is rgba16f, so signed and HDR inputs pass through without clipping.\",\n  \"CREDIT\": \"ossia 3D catalog\",\n  \"ISFVSN\": \"2.0\",\n  \"MODE\": \"COMPUTE_SHADER\",\n  \"CATEGORIES\": [\n    \"3D-FILTER\",\n    \"COMPOSITE\"\n  ],\n  \"INPUTS\": [\n    { \"NAME\": \"t0\", \"TYPE\": \"texture\", \"DIMENSIONS\": 3, \"LABEL\": \"Volume 0\" },\n    { \"NAME\": \"t1\", \"TYPE\": \"texture\", \"DIMENSIONS\": 3, \"LABEL\": \"Volume 1\" },\n    { \"NAME\": \"t2\", \"TYPE\": \"texture\", \"DIMENSIONS\": 3, \"LABEL\": \"Volume 2\" },\n    { \"NAME\": \"t3\", \"TYPE\": \"texture\", \"DIMENSIONS\": 3, \"LABEL\": \"Volume 3\" },\n    { \"NAME\": \"t4\", \"TYPE\": \"texture\", \"DIMENSIONS\": 3, \"LABEL\": \"Volume 4\" },\n    { \"NAME\": \"t5\", \"TYPE\": \"texture\", \"DIMENSIONS\": 3, \"LABEL\": \"Volume 5\" },\n    { \"NAME\": \"t6\", \"TYPE\": \"texture\", \"DIMENSIONS\": 3, \"LABEL\": \"Volume 6\" },\n    { \"NAME\": \"t7\", \"TYPE\": \"texture\", \"DIMENSIONS\": 3, \"LABEL\": \"Volume 7\" },\n    {\n      \"NAME\": \"index\",\n      \"TYPE\": \"long\",\n      \"DEFAULT\": 0,\n      \"VALUES\": [0, 1, 2, 3, 4, 5, 6, 7],\n      \"LABELS\": [\"0\", \"1\", \"2\", \"3\", \"4\", \"5\", \"6\", \"7\"],\n      \"LABEL\": \"Index\"\n    }\n  ],\n  \"RESOURCES\": [\n    {\n      \"NAME\": \"volOut\",\n      \"TYPE\": \"image\",\n      \"ACCESS\": \"write_only\",\n      \"FORMAT\": \"rgba16f\",\n      \"WIDTH\": \"max($WIDTH_t0, $WIDTH_t1, $WIDTH_t2, $WIDTH_t3, $WIDTH_t4, $WIDTH_t5, $WIDTH_t6, $WIDTH_t7)\",\n      \"HEIGHT\": \"max($HEIGHT_t0, $HEIGHT_t1, $HEIGHT_t2, $HEIGHT_t3, $HEIGHT_t4, $HEIGHT_t5, $HEIGHT_t6, $HEIGHT_t7)\",\n      \"DEPTH\": \"max($DEPTH_t0, $DEPTH_t1, $DEPTH_t2, $DEPTH_t3, $DEPTH_t4, $DEPTH_t5, $DEPTH_t6, $DEPTH_t7)\"\n    }\n  ],\n  \"PASSES\": [\n    {\n      \"LOCAL_SIZE\": [\n        4,\n        4,\n        4\n      ],\n      \"EXECUTION_MODEL\": {\n        \"TYPE\": \"3D_IMAGE\",\n        \"TARGET\": \"volOut\"\n      }\n    }\n  ]\n}*/\n\n// An unconnected slot is bound to the engine's 1x1x1 placeholder, whose\n// content is undefined: read it as empty.\nvec4 pick(sampler3D t, vec3 p)\n{\n    return all(equal(textureSize(t, 0), ivec3(1))) ? vec4(0.0) : texture(t, p);\n}\n\nvoid main()\n{\n    ivec3 pos = ivec3(gl_GlobalInvocationID.xyz);\n    ivec3 size = imageSize(volOut);\n    if(any(greaterThanEqual(pos, size))) return;\n    vec3 p = (vec3(pos) + 0.5) / vec3(size);\n    vec4 o;\n    switch(int(index))\n    {\n        case 0: o = pick(t0, p); break;\n        case 1: o = pick(t1, p); break;\n        case 2: o = pick(t2, p); break;\n        case 3: o = pick(t3, p); break;\n        case 4: o = pick(t4, p); break;\n        case 5: o = pick(t5, p); break;\n        case 6: o = pick(t6, p); break;\n        case 7: o = pick(t7, p); break;\n        default: o = vec4(0.0);\n    }\n    imageStore(volOut, pos, o);\n}\n","Root":"<LIBRARY>:packages/score-csf-testers/shaderlib/volume/10-compositing/10-08_volume_switcher8.cs","Inlets":[{"uuid":"5ac86198-2d03-4830-9e41-a6d529922d29","ObjectName":"Inlet","id":0,"Hidden":false,"Custom":"t0","Exposed":"t0","Format":0,"FormatSet":false,"Filter":2,"AddressMode":1,"MipmapMode":0},{"uuid":"5ac86198-2d03-4830-9e41-a6d529922d29","ObjectName":"Inlet","id":1,"Hidden":false,"Custom":"t1","Exposed":"t1","Format":0,"FormatSet":false,"Filter":2,"AddressMode":1,"MipmapMode":0},{"uuid":"5ac86198-2d03-4830-9e41-a6d529922d29","ObjectName":"Inlet","id":2,"Hidden":false,"Custom":"t2","Exposed":"t2","Format":0,"FormatSet":false,"Filter":2,"AddressMode":1,"MipmapMode":0},{"uuid":"5ac86198-2d03-4830-9e41-a6d529922d29","ObjectName":"Inlet","id":3,"Hidden":false,"Custom":"t3","Exposed":"t3","Format":0,"FormatSet":false,"Filter":2,"AddressMode":1,"MipmapMode":0},{"uuid":"5ac86198-2d03-4830-9e41-a6d529922d29","ObjectName":"Inlet","id":4,"Hidden":false,"Custom":"t4","Exposed":"t4","Format":0,"FormatSet":false,"Filter":2,"AddressMode":1,"MipmapMode":0},{"uuid":"5ac86198-2d03-4830-9e41-a6d529922d29","ObjectName":"Inlet","id":5,"Hidden":false,"Custom":"t5","Exposed":"t5","Format":0,"FormatSet":false,"Filter":2,"AddressMode":1,"MipmapMode":0},{"uuid":"5ac86198-2d03-4830-9e41-a6d529922d29","ObjectName":"Inlet","id":6,"Hidden":false,"Custom":"t6","Exposed":"t6","Format":0,"FormatSet":false,"Filter":2,"AddressMode":1,"MipmapMode":0},{"uuid":"5ac86198-2d03-4830-9e41-a6d529922d29","ObjectName":"Inlet","id":7,"Hidden":false,"Custom":"t7","Exposed":"t7","Format":0,"FormatSet":false,"Filter":2,"AddressMode":1,"MipmapMode":0},{"uuid":"485680cc-b8b9-4a01-acc7-3e8334bdc016","ObjectName":"Inlet","id":8,"Hidden":true,"Custom":"index","Exposed":"index","Value":{"Int":1},"Init":{"Int":0},"Domain":{"Int":{"Values":[0,1,2,3,4,5,6,7]}},"Values":[["0",{"Int":0}],["1",{"Int":1}],["2",{"Int":2}],["3",{"Int":3}],["4",{"Int":4}],["5",{"Int":5}],["6",{"Int":6}],["7",{"Int":7}]],"FolderPort":"","FileExtensions":""}],"Outlets":[{"uuid":"f1c71046-b754-49a5-8e66-d01374773dfc","ObjectName":"Outlet","id":0,"Hidden":false,"Custom":"volOut","Exposed":"volout"}]},{"uuid":"a5bbffe0-93d2-4e70-995c-cf46c2c43520","ObjectName":"CSF","id":8,"Metadata":{"ScriptingName":"01-01_perlin3d","Comment":"","Color":"Transparent1","Label":"","Touched":true},"Duration":14112000000,"Height":300.0,"StartOffset":0,"LoopDuration":22579200000,"Pos":[-655.5,75.5],"Size":[156.0,70.0],"Loops":false,"FoldMode":0,"Compute":"/*{\n  \"DESCRIPTION\": \"3D Perlin gradient noise (Perlin 2002, Improving Noise: 12 cube-edge gradients, quintic fade) written into a volume. Classic smooth organic look; foundation for clouds / terrain / turbulence. Scale stretches the frequency.\",\n  \"CREDIT\": \"ossia 3D catalog. K. Perlin, Improving Noise, SIGGRAPH 2002.\",\n  \"ISFVSN\": \"2.0\",\n  \"MODE\": \"COMPUTE_SHADER\",\n  \"CATEGORIES\": [\n    \"3D-GENERATOR\",\n    \"NOISE\"\n  ],\n  \"INPUTS\": [\n    {\n      \"NAME\": \"scale\",\n      \"TYPE\": \"float\",\n      \"DEFAULT\": 4.0,\n      \"MIN\": 0.5,\n      \"MAX\": 32.0,\n      \"LABEL\": \"Scale\"\n    },\n    {\n      \"NAME\": \"timeScroll\",\n      \"TYPE\": \"float\",\n      \"DEFAULT\": 0.2,\n      \"MIN\": 0.0,\n      \"MAX\": 2.0,\n      \"LABEL\": \"Time scroll\"\n    }\n  ],\n  \"RESOURCES\": [\n    {\n      \"NAME\": \"volume\",\n      \"TYPE\": \"image\",\n      \"ACCESS\": \"write_only\",\n      \"WIDTH\": \"64\",\n      \"HEIGHT\": \"64\",\n      \"DEPTH\": \"64\"\n    }\n  ],\n  \"PASSES\": [\n    {\n      \"LOCAL_SIZE\": [\n        4,\n        4,\n        4\n      ],\n      \"EXECUTION_MODEL\": {\n        \"TYPE\": \"3D_IMAGE\",\n        \"TARGET\": \"volume\"\n      }\n    }\n  ]\n}*/\n\n// --- Hashing & random ----------------------------------------------------\nfloat hash11(float n){ return fract(sin(n)*43758.5453123); }\nfloat hash13(vec3 p){\n    p = fract(p * 0.3183099 + 0.1);\n    p *= 17.0;\n    return fract(p.x*p.y*p.z*(p.x+p.y+p.z));\n}\nvec3 hash33(vec3 p){\n    p = vec3(dot(p,vec3(127.1,311.7, 74.7)),\n             dot(p,vec3(269.5,183.3,246.1)),\n             dot(p,vec3(113.5,271.9,124.6)));\n    return fract(sin(p) * 43758.5453123);\n}\n\n// Perlin gradient noise (Perlin 2002, \"Improving Noise\"): a pseudo-random\n// gradient per lattice corner, chosen among the 12 cube-edge directions, dotted\n// with the offset to that corner, blended with the quintic fade\n// 6t^5 - 15t^4 + 10t^3. Zero at every lattice point, unlike value noise\n// (01-03), which interpolates random values and shows the lattice.\nvec3 grad12(vec3 corner){\n    float h = floor(hash13(corner) * 12.0);\n    // The 12 edge midpoints of a cube: (+-1,+-1,0), (+-1,0,+-1), (0,+-1,+-1).\n    float s1 = (mod(h, 2.0) < 1.0) ? 1.0 : -1.0;\n    float s2 = (mod(floor(h * 0.5), 2.0) < 1.0) ? 1.0 : -1.0;\n    if(h < 4.0) return vec3(s1, s2, 0.0);\n    if(h < 8.0) return vec3(s1, 0.0, s2);\n    return vec3(0.0, s1, s2);\n}\nfloat perlin(vec3 P){\n    vec3 Pi = floor(P);\n    vec3 Pf = fract(P);\n    vec3 w  = Pf*Pf*Pf*(Pf*(Pf*6.0-15.0)+10.0); // quintic fade\n    float n000 = dot(grad12(Pi+vec3(0,0,0)), Pf-vec3(0,0,0));\n    float n100 = dot(grad12(Pi+vec3(1,0,0)), Pf-vec3(1,0,0));\n    float n010 = dot(grad12(Pi+vec3(0,1,0)), Pf-vec3(0,1,0));\n    float n110 = dot(grad12(Pi+vec3(1,1,0)), Pf-vec3(1,1,0));\n    float n001 = dot(grad12(Pi+vec3(0,0,1)), Pf-vec3(0,0,1));\n    float n101 = dot(grad12(Pi+vec3(1,0,1)), Pf-vec3(1,0,1));\n    float n011 = dot(grad12(Pi+vec3(0,1,1)), Pf-vec3(0,1,1));\n    float n111 = dot(grad12(Pi+vec3(1,1,1)), Pf-vec3(1,1,1));\n    float nx00 = mix(n000, n100, w.x);\n    float nx10 = mix(n010, n110, w.x);\n    float nx01 = mix(n001, n101, w.x);\n    float nx11 = mix(n011, n111, w.x);\n    float nxy0 = mix(nx00, nx10, w.y);\n    float nxy1 = mix(nx01, nx11, w.y);\n    return mix(nxy0, nxy1, w.z);   // roughly [-1, 1]\n}\n\nvoid main()\n{\n    ivec3 pos = ivec3(gl_GlobalInvocationID.xyz);\n    ivec3 size = imageSize(volume);\n    if(any(greaterThanEqual(pos, size))) return;\n    vec3 p  = (vec3(pos) + 0.5) / vec3(size);   // [0,1]^3\n    vec3 pc = p * 2.0 - 1.0;                     // [-1,1]^3\n\n    float n = perlin(pc * scale + vec3(TIME*timeScroll));\n    n = n * 0.5 + 0.5;\n    imageStore(volume, pos, vec4(vec3(n), 1.0));\n\n}\n","Root":"<LIBRARY>:packages/score-csf-testers/shaderlib/volume/01-noise/01-01_perlin3d.cs","Inlets":[{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":0,"Hidden":true,"Custom":"scale","Exposed":"scale","Value":{"Float":4.699999809265137},"Init":{"Float":4.0},"Domain":{"Float":{"Min":0.5,"Max":32.0}}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":1,"Hidden":true,"Custom":"timeScroll","Exposed":"timescroll","Value":{"Float":2.0},"Init":{"Float":0.20000000298023224},"Domain":{"Float":{"Min":0.0,"Max":2.0}}}],"Outlets":[{"uuid":"f1c71046-b754-49a5-8e66-d01374773dfc","ObjectName":"Outlet","id":0,"Hidden":false,"Custom":"volume","Exposed":"volume"}]},{"uuid":"a5bbffe0-93d2-4e70-995c-cf46c2c43520","ObjectName":"CSF","id":9,"Metadata":{"ScriptingName":"01-15_curl_noise","Comment":"","Color":"Transparent1","Label":"","Touched":true},"Duration":14112000000,"Height":300.0,"StartOffset":0,"LoopDuration":22579200000,"Pos":[-663.5,-38.5],"Size":[169.0,70.0],"Loops":false,"FoldMode":2,"Compute":"/*{\n  \"DESCRIPTION\": \"3D curl noise (Bridson et al. 2007): the curl of a vector potential made of three decorrelated simplex fields. Stored signed in RGBA16F (RGB = velocity, not clamped to [0,1]; alpha 1): the three components make an incompressible (divergence-free) flow volume. Sample this from warp/advection filters for fluid-like deformation.\",\n  \"CREDIT\": \"ossia 3D catalog\",\n  \"ISFVSN\": \"2.0\",\n  \"MODE\": \"COMPUTE_SHADER\",\n  \"CATEGORIES\": [\n    \"3D-GENERATOR\",\n    \"NOISE\"\n  ],\n  \"INPUTS\": [\n    {\n      \"NAME\": \"scale\",\n      \"TYPE\": \"float\",\n      \"DEFAULT\": 2.0,\n      \"MIN\": 0.5,\n      \"MAX\": 8.0,\n      \"LABEL\": \"Scale\"\n    },\n    {\n      \"NAME\": \"drift\",\n      \"TYPE\": \"float\",\n      \"DEFAULT\": 0.1,\n      \"MIN\": 0.0,\n      \"MAX\": 2.0,\n      \"LABEL\": \"Drift\"\n    }\n  ],\n  \"RESOURCES\": [\n    {\n      \"NAME\": \"volume\",\n      \"TYPE\": \"image\",\n      \"ACCESS\": \"write_only\",\n      \"FORMAT\": \"RGBA16F\",\n      \"WIDTH\": \"64\",\n      \"HEIGHT\": \"64\",\n      \"DEPTH\": \"64\"\n    }\n  ],\n  \"PASSES\": [\n    {\n      \"LOCAL_SIZE\": [\n        4,\n        4,\n        4\n      ],\n      \"EXECUTION_MODEL\": {\n        \"TYPE\": \"3D_IMAGE\",\n        \"TARGET\": \"volume\"\n      }\n    }\n  ]\n}*/\n\n// Simplex 3D noise (Ashima Arts, ISC-licensed, widely used)\nvec4 mod289(vec4 x){return x-floor(x*(1.0/289.0))*289.0;}\nvec3 mod289(vec3 x){return x-floor(x*(1.0/289.0))*289.0;}\nvec4 permute(vec4 x){return mod289(((x*34.0)+1.0)*x);}\nvec4 taylorInvSqrt(vec4 r){return 1.79284291400159-0.85373472095314*r;}\nfloat snoise(vec3 v){\n    const vec2 C = vec2(1.0/6.0, 1.0/3.0);\n    const vec4 D = vec4(0.0, 0.5, 1.0, 2.0);\n    vec3 i  = floor(v + dot(v, C.yyy));\n    vec3 x0 = v - i + dot(i, C.xxx);\n    vec3 g = step(x0.yzx, x0.xyz);\n    vec3 l = 1.0 - g;\n    vec3 i1 = min(g.xyz, l.zxy);\n    vec3 i2 = max(g.xyz, l.zxy);\n    vec3 x1 = x0 - i1 + C.xxx;\n    vec3 x2 = x0 - i2 + C.yyy;\n    vec3 x3 = x0 - D.yyy;\n    i = mod289(i);\n    vec4 p = permute(permute(permute(\n         i.z + vec4(0.0, i1.z, i2.z, 1.0))\n       + i.y + vec4(0.0, i1.y, i2.y, 1.0))\n       + i.x + vec4(0.0, i1.x, i2.x, 1.0));\n    float n_ = 0.142857142857;\n    vec3 ns = n_ * D.wyz - D.xzx;\n    vec4 j = p - 49.0 * floor(p * ns.z * ns.z);\n    vec4 x_ = floor(j * ns.z);\n    vec4 y_ = floor(j - 7.0 * x_);\n    vec4 x = x_ *ns.x + ns.yyyy;\n    vec4 y = y_ *ns.x + ns.yyyy;\n    vec4 h = 1.0 - abs(x) - abs(y);\n    vec4 b0 = vec4(x.xy, y.xy);\n    vec4 b1 = vec4(x.zw, y.zw);\n    vec4 s0 = floor(b0)*2.0 + 1.0;\n    vec4 s1 = floor(b1)*2.0 + 1.0;\n    vec4 sh = -step(h, vec4(0.0));\n    vec4 a0 = b0.xzyw + s0.xzyw*sh.xxyy;\n    vec4 a1 = b1.xzyw + s1.xzyw*sh.zzww;\n    vec3 p0 = vec3(a0.xy, h.x);\n    vec3 p1 = vec3(a0.zw, h.y);\n    vec3 p2 = vec3(a1.xy, h.z);\n    vec3 p3 = vec3(a1.zw, h.w);\n    vec4 norm = taylorInvSqrt(vec4(dot(p0,p0),dot(p1,p1),dot(p2,p2),dot(p3,p3)));\n    p0 *= norm.x; p1 *= norm.y; p2 *= norm.z; p3 *= norm.w;\n    vec4 m = max(0.6 - vec4(dot(x0,x0),dot(x1,x1),dot(x2,x2),dot(x3,x3)), 0.0);\n    m = m * m;\n    return 42.0 * dot(m*m, vec4(dot(p0,x0),dot(p1,x1),dot(p2,x2),dot(p3,x3)));\n}\n\n// 3D vector potential from three decorrelated simplex noises\nvec3 pot(vec3 p){\n    return vec3(snoise(p + vec3(31.416,0,0)),\n                snoise(p + vec3(0,31.416,0)),\n                snoise(p + vec3(0,0,31.416)));\n}\nvec3 curl3(vec3 p){\n    const float e = 0.01;\n    vec3 dx = vec3(e,0,0), dy = vec3(0,e,0), dz = vec3(0,0,e);\n    vec3 px1 = pot(p+dx), px0 = pot(p-dx);\n    vec3 py1 = pot(p+dy), py0 = pot(p-dy);\n    vec3 pz1 = pot(p+dz), pz0 = pot(p-dz);\n    // curl F = (dFz/dy - dFy/dz, dFx/dz - dFz/dx, dFy/dx - dFx/dy)\n    float cx = (py1.z - py0.z) - (pz1.y - pz0.y);\n    float cy = (pz1.x - pz0.x) - (px1.z - px0.z);\n    float cz = (px1.y - px0.y) - (py1.x - py0.x);\n    return vec3(cx, cy, cz) / (2.0*e);\n}\n\nvoid main()\n{\n    ivec3 pos = ivec3(gl_GlobalInvocationID.xyz);\n    ivec3 size = imageSize(volume);\n    if(any(greaterThanEqual(pos, size))) return;\n    vec3 p  = (vec3(pos) + 0.5) / vec3(size);   // [0,1]^3\n    vec3 pc = p * 2.0 - 1.0;                     // [-1,1]^3\n\n    vec3 v = curl3(pc * scale + vec3(TIME*drift));\n    // Encode signed flow into RGB16F (values may exceed [0,1])\n    imageStore(volume, pos, vec4(v, 1.0));\n\n}\n","Root":"<LIBRARY>:packages/score-csf-testers/shaderlib/volume/01-noise/01-15_curl_noise.cs","Inlets":[{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":0,"Hidden":true,"Custom":"scale","Exposed":"scale","Address":"analysis:/rms_smooth","Value":{"Float":0.5},"Init":{"Float":2.0},"Domain":{"Float":{"Min":0.5,"Max":8.0}}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":1,"Hidden":true,"Custom":"drift","Exposed":"drift","Value":{"Float":0.0},"Init":{"Float":0.10000000149011612},"Domain":{"Float":{"Min":0.0,"Max":2.0}}}],"Outlets":[{"uuid":"f1c71046-b754-49a5-8e66-d01374773dfc","ObjectName":"Outlet","id":0,"Hidden":false,"Custom":"volume","Exposed":"volume"}]},{"uuid":"a5bbffe0-93d2-4e70-995c-cf46c2c43520","ObjectName":"CSF","id":10,"Metadata":{"ScriptingName":"01-22_simplex_looping","Comment":"","Color":"Transparent1","Label":"","Touched":true},"Duration":14112000000,"Height":300.0,"StartOffset":0,"LoopDuration":22579200000,"Pos":[-688.5,207.5],"Size":[207.0,70.0],"Loops":false,"FoldMode":0,"Compute":"/*{\n  \"DESCRIPTION\": \"Seamlessly looping animated volume: two 3D simplex samples whose offsets travel around two circles in orthogonal planes of noise space, so the field returns exactly to its start every Period seconds. A looping alternative to a 4D noise slice at a lower cost.\",\n  \"CREDIT\": \"ossia 3D catalog\",\n  \"ISFVSN\": \"2.0\",\n  \"MODE\": \"COMPUTE_SHADER\",\n  \"CATEGORIES\": [\n    \"3D-GENERATOR\",\n    \"NOISE\"\n  ],\n  \"INPUTS\": [\n    {\n      \"NAME\": \"scale\",\n      \"TYPE\": \"float\",\n      \"DEFAULT\": 3.0,\n      \"MIN\": 0.5,\n      \"MAX\": 16.0,\n      \"LABEL\": \"Scale\"\n    },\n    {\n      \"NAME\": \"period\",\n      \"TYPE\": \"float\",\n      \"DEFAULT\": 4.0,\n      \"MIN\": 0.5,\n      \"MAX\": 60.0,\n      \"LABEL\": \"Loop period (s)\"\n    }\n  ],\n  \"RESOURCES\": [\n    {\n      \"NAME\": \"volume\",\n      \"TYPE\": \"image\",\n      \"ACCESS\": \"write_only\",\n      \"WIDTH\": \"64\",\n      \"HEIGHT\": \"64\",\n      \"DEPTH\": \"64\"\n    }\n  ],\n  \"PASSES\": [\n    {\n      \"LOCAL_SIZE\": [\n        4,\n        4,\n        4\n      ],\n      \"EXECUTION_MODEL\": {\n        \"TYPE\": \"3D_IMAGE\",\n        \"TARGET\": \"volume\"\n      }\n    }\n  ]\n}*/\n\n// Simplex 3D noise (Ashima Arts, ISC-licensed, widely used)\nvec4 mod289(vec4 x){return x-floor(x*(1.0/289.0))*289.0;}\nvec3 mod289(vec3 x){return x-floor(x*(1.0/289.0))*289.0;}\nvec4 permute(vec4 x){return mod289(((x*34.0)+1.0)*x);}\nvec4 taylorInvSqrt(vec4 r){return 1.79284291400159-0.85373472095314*r;}\nfloat snoise(vec3 v){\n    const vec2 C = vec2(1.0/6.0, 1.0/3.0);\n    const vec4 D = vec4(0.0, 0.5, 1.0, 2.0);\n    vec3 i  = floor(v + dot(v, C.yyy));\n    vec3 x0 = v - i + dot(i, C.xxx);\n    vec3 g = step(x0.yzx, x0.xyz);\n    vec3 l = 1.0 - g;\n    vec3 i1 = min(g.xyz, l.zxy);\n    vec3 i2 = max(g.xyz, l.zxy);\n    vec3 x1 = x0 - i1 + C.xxx;\n    vec3 x2 = x0 - i2 + C.yyy;\n    vec3 x3 = x0 - D.yyy;\n    i = mod289(i);\n    vec4 p = permute(permute(permute(\n         i.z + vec4(0.0, i1.z, i2.z, 1.0))\n       + i.y + vec4(0.0, i1.y, i2.y, 1.0))\n       + i.x + vec4(0.0, i1.x, i2.x, 1.0));\n    float n_ = 0.142857142857;\n    vec3 ns = n_ * D.wyz - D.xzx;\n    vec4 j = p - 49.0 * floor(p * ns.z * ns.z);\n    vec4 x_ = floor(j * ns.z);\n    vec4 y_ = floor(j - 7.0 * x_);\n    vec4 x = x_ *ns.x + ns.yyyy;\n    vec4 y = y_ *ns.x + ns.yyyy;\n    vec4 h = 1.0 - abs(x) - abs(y);\n    vec4 b0 = vec4(x.xy, y.xy);\n    vec4 b1 = vec4(x.zw, y.zw);\n    vec4 s0 = floor(b0)*2.0 + 1.0;\n    vec4 s1 = floor(b1)*2.0 + 1.0;\n    vec4 sh = -step(h, vec4(0.0));\n    vec4 a0 = b0.xzyw + s0.xzyw*sh.xxyy;\n    vec4 a1 = b1.xzyw + s1.xzyw*sh.zzww;\n    vec3 p0 = vec3(a0.xy, h.x);\n    vec3 p1 = vec3(a0.zw, h.y);\n    vec3 p2 = vec3(a1.xy, h.z);\n    vec3 p3 = vec3(a1.zw, h.w);\n    vec4 norm = taylorInvSqrt(vec4(dot(p0,p0),dot(p1,p1),dot(p2,p2),dot(p3,p3)));\n    p0 *= norm.x; p1 *= norm.y; p2 *= norm.z; p3 *= norm.w;\n    vec4 m = max(0.6 - vec4(dot(x0,x0),dot(x1,x1),dot(x2,x2),dot(x3,x3)), 0.0);\n    m = m * m;\n    return 42.0 * dot(m*m, vec4(dot(p0,x0),dot(p1,x1),dot(p2,x2),dot(p3,x3)));\n}\n\nvoid main()\n{\n    ivec3 pos = ivec3(gl_GlobalInvocationID.xyz);\n    ivec3 size = imageSize(volume);\n    if(any(greaterThanEqual(pos, size))) return;\n    vec3 p  = (vec3(pos) + 0.5) / vec3(size);   // [0,1]^3\n    vec3 pc = p * 2.0 - 1.0;                     // [-1,1]^3\n\n    float phase = 6.28318530718 * TIME / max(period, 0.01);\n    // Use 3D simplex at two decorrelated phased samples and blend\n    vec3 q = pc * scale;\n    float a = snoise(q + vec3(cos(phase), sin(phase), 0.0) * 1.7);\n    // A circle in an orthogonal plane, far away in noise space. (Sampling the\n    // same circle half a turn later made the sum repeat every period / 2.)\n    float b = snoise(q + vec3(0.0, cos(phase), sin(phase)) * 1.7 + vec3(41.3, 17.1, 5.9));\n    float v = 0.5*(a+b) * 0.5 + 0.5;\n    imageStore(volume, pos, vec4(vec3(v), 1.0));\n\n}\n","Root":"<LIBRARY>:packages/score-csf-testers/shaderlib/volume/01-noise/01-22_simplex_looping.cs","Inlets":[{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":0,"Hidden":true,"Custom":"scale","Exposed":"scale","Value":{"Float":1.7916666269302368},"Init":{"Float":3.0},"Domain":{"Float":{"Min":0.5,"Max":16.0}}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":1,"Hidden":true,"Custom":"period","Exposed":"period","Value":{"Float":38.18333435058594},"Init":{"Float":4.0},"Domain":{"Float":{"Min":0.5,"Max":60.0}}}],"Outlets":[{"uuid":"f1c71046-b754-49a5-8e66-d01374773dfc","ObjectName":"Outlet","id":0,"Hidden":false,"Custom":"volume","Exposed":"volume"}]},{"uuid":"a5bbffe0-93d2-4e70-995c-cf46c2c43520","ObjectName":"CSF","id":13,"Metadata":{"ScriptingName":"02-09_lidinoid","Comment":"","Color":"Transparent1","Label":"","Touched":true},"Duration":14112000000,"Height":300.0,"StartOffset":0,"LoopDuration":22579200000,"Pos":[-688.5,464.0],"Size":[152.0,70.0],"Loops":false,"FoldMode":2,"Compute":"/*{\n  \"DESCRIPTION\": \"Lidinoid TPMS: swirly curved channels.\",\n  \"CREDIT\": \"ossia 3D catalog\",\n  \"ISFVSN\": \"2.0\",\n  \"MODE\": \"COMPUTE_SHADER\",\n  \"CATEGORIES\": [\n    \"3D-GENERATOR\",\n    \"STRUCTURED\"\n  ],\n  \"INPUTS\": [\n    {\n      \"NAME\": \"scale\",\n      \"TYPE\": \"float\",\n      \"DEFAULT\": 4.0,\n      \"MIN\": 1.0,\n      \"MAX\": 16.0,\n      \"LABEL\": \"Scale\"\n    },\n    {\n      \"NAME\": \"thickness\",\n      \"TYPE\": \"float\",\n      \"DEFAULT\": 0.35,\n      \"MIN\": 0.0,\n      \"MAX\": 2.0,\n      \"LABEL\": \"Thickness\"\n    }\n  ],\n  \"RESOURCES\": [\n    {\n      \"NAME\": \"volume\",\n      \"TYPE\": \"image\",\n      \"ACCESS\": \"write_only\",\n      \"WIDTH\": \"64\",\n      \"HEIGHT\": \"64\",\n      \"DEPTH\": \"64\"\n    }\n  ],\n  \"PASSES\": [\n    {\n      \"LOCAL_SIZE\": [\n        4,\n        4,\n        4\n      ],\n      \"EXECUTION_MODEL\": {\n        \"TYPE\": \"3D_IMAGE\",\n        \"TARGET\": \"volume\"\n      }\n    }\n  ]\n}*/\n\nvoid main()\n{\n    ivec3 pos = ivec3(gl_GlobalInvocationID.xyz);\n    ivec3 size = imageSize(volume);\n    if(any(greaterThanEqual(pos, size))) return;\n    vec3 p  = (vec3(pos) + 0.5) / vec3(size);   // [0,1]^3\n    vec3 pc = p * 2.0 - 1.0;                     // [-1,1]^3\n\n    vec3 q = pc * scale;\n    float g = 0.5*(sin(2.0*q.x)*cos(q.y)*sin(q.z)\n                 + sin(2.0*q.y)*cos(q.z)*sin(q.x)\n                 + sin(2.0*q.z)*cos(q.x)*sin(q.y))\n            - 0.5*(cos(2.0*q.x)*cos(2.0*q.y)\n                 + cos(2.0*q.y)*cos(2.0*q.z)\n                 + cos(2.0*q.z)*cos(2.0*q.x))\n            + 0.15;\n    float shell = 1.0 - smoothstep(thickness*0.5, thickness, abs(g));\n    imageStore(volume, pos, vec4(vec3(shell), 1.0));\n\n}\n","Root":"<LIBRARY>:packages/score-csf-testers/shaderlib/volume/02-structured/02-09_lidinoid.cs","Inlets":[{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":0,"Hidden":true,"Custom":"scale","Exposed":"scale","Value":{"Float":4.0},"Init":{"Float":4.0},"Domain":{"Float":{"Min":1.0,"Max":16.0}}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":1,"Hidden":true,"Custom":"thickness","Exposed":"thickness","Value":{"Float":0.3499999940395355},"Init":{"Float":0.3499999940395355},"Domain":{"Float":{"Min":0.0,"Max":2.0}}}],"Outlets":[{"uuid":"f1c71046-b754-49a5-8e66-d01374773dfc","ObjectName":"Outlet","id":0,"Hidden":false,"Custom":"volume","Exposed":"volume"}]},{"uuid":"a5bbffe0-93d2-4e70-995c-cf46c2c43520","ObjectName":"CSF","id":14,"Metadata":{"ScriptingName":"02-07_neovius","Comment":"","Color":"Transparent1","Label":"","Touched":true},"Duration":14112000000,"Height":300.0,"StartOffset":0,"LoopDuration":22579200000,"Pos":[-680.5,345.0],"Size":[153.0,70.0],"Loops":false,"FoldMode":2,"Compute":"/*{\n  \"DESCRIPTION\": \"Neovius TPMS: 3(cos(x)+cos(y)+cos(z)) + 4 cos(x)cos(y)cos(z). Denser than Schwarz-P, more complex.\",\n  \"CREDIT\": \"ossia 3D catalog\",\n  \"ISFVSN\": \"2.0\",\n  \"MODE\": \"COMPUTE_SHADER\",\n  \"CATEGORIES\": [\n    \"3D-GENERATOR\",\n    \"STRUCTURED\"\n  ],\n  \"INPUTS\": [\n    {\n      \"NAME\": \"scale\",\n      \"TYPE\": \"float\",\n      \"DEFAULT\": 5.0,\n      \"MIN\": 1.0,\n      \"MAX\": 16.0,\n      \"LABEL\": \"Scale\"\n    },\n    {\n      \"NAME\": \"thickness\",\n      \"TYPE\": \"float\",\n      \"DEFAULT\": 1.2,\n      \"MIN\": 0.0,\n      \"MAX\": 4.0,\n      \"LABEL\": \"Thickness\"\n    }\n  ],\n  \"RESOURCES\": [\n    {\n      \"NAME\": \"volume\",\n      \"TYPE\": \"image\",\n      \"ACCESS\": \"write_only\",\n      \"WIDTH\": \"64\",\n      \"HEIGHT\": \"64\",\n      \"DEPTH\": \"64\"\n    }\n  ],\n  \"PASSES\": [\n    {\n      \"LOCAL_SIZE\": [\n        4,\n        4,\n        4\n      ],\n      \"EXECUTION_MODEL\": {\n        \"TYPE\": \"3D_IMAGE\",\n        \"TARGET\": \"volume\"\n      }\n    }\n  ]\n}*/\n\nvoid main()\n{\n    ivec3 pos = ivec3(gl_GlobalInvocationID.xyz);\n    ivec3 size = imageSize(volume);\n    if(any(greaterThanEqual(pos, size))) return;\n    vec3 p  = (vec3(pos) + 0.5) / vec3(size);   // [0,1]^3\n    vec3 pc = p * 2.0 - 1.0;                     // [-1,1]^3\n\n    vec3 q = pc * scale;\n    float g = 3.0*(cos(q.x)+cos(q.y)+cos(q.z)) + 4.0*cos(q.x)*cos(q.y)*cos(q.z);\n    float shell = 1.0 - smoothstep(thickness*0.5, thickness, abs(g));\n    imageStore(volume, pos, vec4(vec3(shell), 1.0));\n\n}\n","Root":"<LIBRARY>:packages/score-csf-testers/shaderlib/volume/02-structured/02-07_neovius.cs","Inlets":[{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":0,"Hidden":true,"Custom":"scale","Exposed":"scale","Value":{"Float":5.0},"Init":{"Float":5.0},"Domain":{"Float":{"Min":1.0,"Max":16.0}}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":1,"Hidden":true,"Custom":"thickness","Exposed":"thickness","Value":{"Float":0.5333333611488342},"Init":{"Float":1.2000000476837158},"Domain":{"Float":{"Min":0.0,"Max":4.0}}}],"Outlets":[{"uuid":"f1c71046-b754-49a5-8e66-d01374773dfc","ObjectName":"Outlet","id":0,"Hidden":false,"Custom":"volume","Exposed":"volume"}]},{"uuid":"25c64b87-a44a-4fed-9f60-0a48906fd3ec","ObjectName":"MicroMapping","id":15,"Metadata":{"ScriptingName":"Micromap","Comment":"","Color":"Transparent1","Label":"","Touched":true},"Duration":14112000000,"Height":300.0,"StartOffset":0,"LoopDuration":22579200000,"Pos":[-900.5,345.0],"Size":[180.0,35.0],"Loops":false,"FoldMode":0,"Inlets":[{"uuid":"769dd38a-bfb3-4dc6-b52a-b6abb7afe2a3","ObjectName":"Inlet","id":0,"Hidden":false,"Custom":"in","Exposed":"in","Address":"analysis:/rms_smooth"},{"uuid":"9ae797ea-d94c-4792-acec-9ec1932bae5d","ObjectName":"Inlet","id":1,"Hidden":true,"Custom":"Expression","Exposed":"expression","Value":{"String":"70x"},"Init":{"String":"x / 127"},"Domain":{}}],"Outlets":[{"uuid":"cff96158-cc72-46d7-99dc-b6038171375b","ObjectName":"Outlet","id":0,"Hidden":false,"Custom":"out","Exposed":"out"}]},{"uuid":"a5bbffe0-93d2-4e70-995c-cf46c2c43520","ObjectName":"CSF","id":16,"Metadata":{"ScriptingName":"08-02_curl_warp","Comment":"","Color":"Transparent1","Label":"","Touched":true},"Duration":14112000000,"Height":300.0,"StartOffset":0,"LoopDuration":22579200000,"Pos":[-496.5,464.0],"Size":[165.0,125.0],"Loops":false,"FoldMode":0,"Compute":"/*{\n  \"DESCRIPTION\": \"Fluid-looking domain warp by curl of a noise potential. Incompressible: the volume swirls without being squashed or stretched. The output is rgba16f, so signed and HDR inputs (01-15 curl noise, the simulations, 07-06 Laplacian...) pass through without clipping.\",\n  \"CREDIT\": \"ossia 3D catalog\",\n  \"ISFVSN\": \"2.0\",\n  \"MODE\": \"COMPUTE_SHADER\",\n  \"CATEGORIES\": [\n    \"3D-FILTER\",\n    \"WARP\"\n  ],\n  \"INPUTS\": [\n    {\n      \"NAME\": \"volIn\",\n      \"TYPE\": \"texture\",\n      \"DIMENSIONS\": 3,\n      \"LABEL\": \"Input volume\"\n    },\n    {\n      \"NAME\": \"amount\",\n      \"TYPE\": \"float\",\n      \"DEFAULT\": 0.1,\n      \"MIN\": 0.0,\n      \"MAX\": 0.5,\n      \"LABEL\": \"Warp amount\"\n    },\n    {\n      \"NAME\": \"scale\",\n      \"TYPE\": \"float\",\n      \"DEFAULT\": 2.0,\n      \"MIN\": 0.5,\n      \"MAX\": 8.0,\n      \"LABEL\": \"Scale\"\n    },\n    {\n      \"NAME\": \"drift\",\n      \"TYPE\": \"float\",\n      \"DEFAULT\": 0.1,\n      \"MIN\": 0.0,\n      \"MAX\": 2.0,\n      \"LABEL\": \"Drift\"\n    }\n  ],\n  \"RESOURCES\": [\n    {\n      \"NAME\": \"volOut\",\n      \"TYPE\": \"image\",\n      \"ACCESS\": \"write_only\",\n      \"FORMAT\": \"rgba16f\",\n      \"WIDTH\": \"$WIDTH_volIn\",\n      \"HEIGHT\": \"$HEIGHT_volIn\",\n      \"DEPTH\": \"$DEPTH_volIn\"\n    }\n  ],\n  \"PASSES\": [\n    {\n      \"LOCAL_SIZE\": [\n        4,\n        4,\n        4\n      ],\n      \"EXECUTION_MODEL\": {\n        \"TYPE\": \"3D_IMAGE\",\n        \"TARGET\": \"volOut\"\n      }\n    }\n  ]\n}*/\n\n// Simplex 3D noise (Ashima Arts, ISC-licensed, widely used)\nvec4 mod289(vec4 x){return x-floor(x*(1.0/289.0))*289.0;}\nvec3 mod289(vec3 x){return x-floor(x*(1.0/289.0))*289.0;}\nvec4 permute(vec4 x){return mod289(((x*34.0)+1.0)*x);}\nvec4 taylorInvSqrt(vec4 r){return 1.79284291400159-0.85373472095314*r;}\nfloat snoise(vec3 v){\n    const vec2 C = vec2(1.0/6.0, 1.0/3.0);\n    const vec4 D = vec4(0.0, 0.5, 1.0, 2.0);\n    vec3 i  = floor(v + dot(v, C.yyy));\n    vec3 x0 = v - i + dot(i, C.xxx);\n    vec3 g = step(x0.yzx, x0.xyz);\n    vec3 l = 1.0 - g;\n    vec3 i1 = min(g.xyz, l.zxy);\n    vec3 i2 = max(g.xyz, l.zxy);\n    vec3 x1 = x0 - i1 + C.xxx;\n    vec3 x2 = x0 - i2 + C.yyy;\n    vec3 x3 = x0 - D.yyy;\n    i = mod289(i);\n    vec4 p = permute(permute(permute(\n         i.z + vec4(0.0, i1.z, i2.z, 1.0))\n       + i.y + vec4(0.0, i1.y, i2.y, 1.0))\n       + i.x + vec4(0.0, i1.x, i2.x, 1.0));\n    float n_ = 0.142857142857;\n    vec3 ns = n_ * D.wyz - D.xzx;\n    vec4 j = p - 49.0 * floor(p * ns.z * ns.z);\n    vec4 x_ = floor(j * ns.z);\n    vec4 y_ = floor(j - 7.0 * x_);\n    vec4 x = x_ *ns.x + ns.yyyy;\n    vec4 y = y_ *ns.x + ns.yyyy;\n    vec4 h = 1.0 - abs(x) - abs(y);\n    vec4 b0 = vec4(x.xy, y.xy);\n    vec4 b1 = vec4(x.zw, y.zw);\n    vec4 s0 = floor(b0)*2.0 + 1.0;\n    vec4 s1 = floor(b1)*2.0 + 1.0;\n    vec4 sh = -step(h, vec4(0.0));\n    vec4 a0 = b0.xzyw + s0.xzyw*sh.xxyy;\n    vec4 a1 = b1.xzyw + s1.xzyw*sh.zzww;\n    vec3 p0 = vec3(a0.xy, h.x);\n    vec3 p1 = vec3(a0.zw, h.y);\n    vec3 p2 = vec3(a1.xy, h.z);\n    vec3 p3 = vec3(a1.zw, h.w);\n    vec4 norm = taylorInvSqrt(vec4(dot(p0,p0),dot(p1,p1),dot(p2,p2),dot(p3,p3)));\n    p0 *= norm.x; p1 *= norm.y; p2 *= norm.z; p3 *= norm.w;\n    vec4 m = max(0.6 - vec4(dot(x0,x0),dot(x1,x1),dot(x2,x2),dot(x3,x3)), 0.0);\n    m = m * m;\n    return 42.0 * dot(m*m, vec4(dot(p0,x0),dot(p1,x1),dot(p2,x2),dot(p3,x3)));\n}\n\nvec3 pot(vec3 p){\n    return vec3(snoise(p+vec3(31.4,0,0)),\n                snoise(p+vec3(0,31.4,0)),\n                snoise(p+vec3(0,0,31.4)));\n}\nvec3 curl3(vec3 p){\n    const float e = 0.01;\n    vec3 dx=vec3(e,0,0), dy=vec3(0,e,0), dz=vec3(0,0,e);\n    vec3 px1=pot(p+dx), px0=pot(p-dx);\n    vec3 py1=pot(p+dy), py0=pot(p-dy);\n    vec3 pz1=pot(p+dz), pz0=pot(p-dz);\n    return vec3((py1.z-py0.z)-(pz1.y-pz0.y),\n                (pz1.x-pz0.x)-(px1.z-px0.z),\n                (px1.y-px0.y)-(py1.x-py0.x)) / (2.0*e);\n}\n\nvoid main()\n{\n    ivec3 pos = ivec3(gl_GlobalInvocationID.xyz);\n    ivec3 size = imageSize(volOut);\n    if(any(greaterThanEqual(pos, size))) return;\n    vec3 p  = (vec3(pos) + 0.5) / vec3(size);\n    vec3 pc = p * 2.0 - 1.0;\n\n    vec3 off = curl3(pc*scale + vec3(TIME*drift)) * amount;\n    vec4 s = texture(volIn, p + off);\n    imageStore(volOut, pos, s);\n\n}\n","Root":"<LIBRARY>:packages/score-csf-testers/shaderlib/volume/08-warp/08-02_curl_warp.cs","Inlets":[{"uuid":"5ac86198-2d03-4830-9e41-a6d529922d29","ObjectName":"Inlet","id":0,"Hidden":false,"Custom":"volIn","Exposed":"volin","Format":0,"FormatSet":false,"Filter":2,"AddressMode":1,"MipmapMode":0},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":1,"Hidden":true,"Custom":"amount","Exposed":"amount","Address":"analysis:/rms_smooth","Value":{"Float":0.0},"Init":{"Float":0.10000000149011612},"Domain":{"Float":{"Min":0.0,"Max":0.5}}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":2,"Hidden":true,"Custom":"scale","Exposed":"scale","Value":{"Float":1.375},"Init":{"Float":2.0},"Domain":{"Float":{"Min":0.5,"Max":8.0}}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":3,"Hidden":true,"Custom":"drift","Exposed":"drift","Value":{"Float":0.10000000149011612},"Init":{"Float":0.10000000149011612},"Domain":{"Float":{"Min":0.0,"Max":2.0}}}],"Outlets":[{"uuid":"f1c71046-b754-49a5-8e66-d01374773dfc","ObjectName":"Outlet","id":0,"Hidden":false,"Custom":"volOut","Exposed":"volout"}]},{"uuid":"0b1b1816-c33e-4796-a16d-5aab27fe600f","ObjectName":"LFO","id":17,"Metadata":{"ScriptingName":"LFO","Comment":"","Color":"Transparent1","Label":"","Touched":true},"Duration":14112000000,"Height":300.0,"StartOffset":0,"LoopDuration":22579200000,"Pos":[-682.5,-332.0],"Size":[261.0,117.5],"Loops":false,"FoldMode":0,"Inlets":[{"uuid":"b631d9b7-cbe3-4d9c-b470-f139e348aecb","ObjectName":"Inlet","id":0,"Hidden":true,"Custom":"Period","Exposed":"period","Value":{"Vec2f":[0.5,1.0]},"Init":{"Vec2f":[0.5,1.0]},"Domain":{"Vec2f":{"Min":[0.009999999776482582,0.0],"Max":[60.0,1.0],"Values":[[],[]]}}},{"uuid":"82427d27-084a-4ab6-9c4e-db83929a1200","ObjectName":"Inlet","id":1,"Hidden":true,"Custom":"Shape","Exposed":"shape","Value":{"Float":0.5},"Init":{"Float":0.5},"Domain":{"Float":{"Min":0.0,"Max":1.0}}},{"uuid":"7cd210d3-ebd1-4f71-9de6-cccfb639cbc3","ObjectName":"Inlet","id":2,"Hidden":true,"Custom":"Retrigger","Exposed":"retrigger","Value":{"Impulse":null},"Init":{"Impulse":null},"Domain":{"Impulse":null}},{"uuid":"82427d27-084a-4ab6-9c4e-db83929a1200","ObjectName":"Inlet","id":3,"Hidden":true,"Custom":"Ampl.","Exposed":"ampl.","Value":{"Float":0.5},"Init":{"Float":0.5},"Domain":{"Float":{"Min":0.0,"Max":2.0}}},{"uuid":"82427d27-084a-4ab6-9c4e-db83929a1200","ObjectName":"Inlet","id":4,"Hidden":true,"Custom":"Offset","Exposed":"offset","Value":{"Float":0.5},"Init":{"Float":0.5},"Domain":{"Float":{"Min":-1.0,"Max":1.0}}},{"uuid":"82427d27-084a-4ab6-9c4e-db83929a1200","ObjectName":"Inlet","id":5,"Hidden":true,"Custom":"Jitter","Exposed":"jitter","Value":{"Float":0.0},"Init":{"Float":0.0},"Domain":{"Float":{"Min":0.0,"Max":180.0}}},{"uuid":"82427d27-084a-4ab6-9c4e-db83929a1200","ObjectName":"Inlet","id":6,"Hidden":true,"Custom":"Phase","Exposed":"phase","Value":{"Float":0.0},"Init":{"Float":0.0},"Domain":{"Float":{"Min":0.0,"Max":360.0}}},{"uuid":"8b1d76c4-3838-4ac0-9b9c-c12bc5db8e8a","ObjectName":"Inlet","id":7,"Hidden":true,"Custom":"Waveform","Exposed":"waveform","Value":{"String":"SampleAndHoldEveryTick"},"Init":{"String":"Sin"},"Domain":{"String":{"Values":["Sin","Triangle","Saw","RampDown","Square","SquareOnChange","SampleAndHoldEveryTick","SampleAndHold","Noise1","Noise2","Noise3","Drift"]}},"Values":["Sin","Triangle","Saw","RampDown","Square","SquareOnChange","SampleAndHoldEveryTick","SampleAndHold","Noise1","Noise2","Noise3","Drift"],"Pixmaps":[":/icons/wave_sin_off.png",":/icons/wave_sin_on.png",":/icons/wave_triangle_off.png",":/icons/wave_triangle_on.png",":/icons/wave_saw_off.png",":/icons/wave_saw_on.png",":/icons/wave_ramp_down_off.png",":/icons/wave_ramp_down_on.png",":/icons/wave_square_ticks_off.png",":/icons/wave_square_ticks_on.png",":/icons/wave_square_changes_off.png",":/icons/wave_square_changes_on.png",":/icons/wave_sample_and_hold_ticks_off.png",":/icons/wave_sample_and_hold_ticks_on.png",":/icons/wave_sample_and_hold_changes_off.png",":/icons/wave_sample_and_hold_changes_on.png",":/icons/wave_noise1_off.png",":/icons/wave_noise1_on.png",":/icons/wave_noise2_off.png",":/icons/wave_noise2_on.png",":/icons/wave_noise3_off.png",":/icons/wave_noise3_on.png",":/icons/wave_drift_off.png",":/icons/wave_drift_on.png"]},{"uuid":"fb27e4cb-ea7f-41e2-ad92-2354498c1b6b","ObjectName":"Inlet","id":8,"Hidden":true,"Custom":"Lock to bars","Exposed":"lock to bars","Value":{"Bool":false},"Init":{"Bool":false},"Domain":{"Bool":null}}],"Outlets":[{"uuid":"cff96158-cc72-46d7-99dc-b6038171375b","ObjectName":"Outlet","id":0,"Hidden":false,"Custom":"Out","Exposed":"out"}]},{"uuid":"25c64b87-a44a-4fed-9f60-0a48906fd3ec","ObjectName":"MicroMapping","id":18,"Metadata":{"ScriptingName":"Micromap.19","Comment":"","Color":"Transparent1","Label":"","Touched":true},"Duration":14112000000,"Height":300.0,"StartOffset":0,"LoopDuration":22579200000,"Pos":[-287.5,-332.0],"Size":[180.0,35.0],"Loops":false,"FoldMode":0,"Inlets":[{"uuid":"769dd38a-bfb3-4dc6-b52a-b6abb7afe2a3","ObjectName":"Inlet","id":0,"Hidden":false,"Custom":"in","Exposed":"in"},{"uuid":"9ae797ea-d94c-4792-acec-9ec1932bae5d","ObjectName":"Inlet","id":1,"Hidden":true,"Custom":"Expression","Exposed":"expression","Value":{"String":"round(5x)"},"Init":{"String":"x / 127"},"Domain":{}}],"Outlets":[{"uuid":"cff96158-cc72-46d7-99dc-b6038171375b","ObjectName":"Outlet","id":0,"Hidden":false,"Custom":"out","Exposed":"out"}]},{"uuid":"a5bbffe0-93d2-4e70-995c-cf46c2c43520","ObjectName":"CSF","id":30,"Metadata":{"ScriptingName":"13-02_cubic_symmetry","Comment":"","Color":"Transparent1","Label":"","Touched":true},"Duration":14112000000,"Height":300.0,"StartOffset":0,"LoopDuration":22579200000,"Pos":[0.1914180252952065,-29.5],"Size":[206.0,22.0],"Loops":false,"FoldMode":2,"Compute":"/*{\n  \"DESCRIPTION\": \"Cubic symmetry (Oh group, 48-fold): abs + sort the coordinates, producing the fundamental domain of the cubic symmetry group. Beautiful multi-axis mandalas. The output is rgba16f, so signed and HDR inputs (01-15 curl noise, the simulations, 07-06 Laplacian...) pass through without clipping.\",\n  \"CREDIT\": \"ossia 3D catalog\",\n  \"ISFVSN\": \"2.0\",\n  \"MODE\": \"COMPUTE_SHADER\",\n  \"CATEGORIES\": [\n    \"3D-FILTER\",\n    \"SYMMETRY\"\n  ],\n  \"INPUTS\": [\n    {\n      \"NAME\": \"volIn\",\n      \"TYPE\": \"texture\",\n      \"DIMENSIONS\": 3,\n      \"LABEL\": \"Input volume\"\n    }\n  ],\n  \"RESOURCES\": [\n    {\n      \"NAME\": \"volOut\",\n      \"TYPE\": \"image\",\n      \"ACCESS\": \"write_only\",\n      \"FORMAT\": \"rgba16f\",\n      \"WIDTH\": \"$WIDTH_volIn\",\n      \"HEIGHT\": \"$HEIGHT_volIn\",\n      \"DEPTH\": \"$DEPTH_volIn\"\n    }\n  ],\n  \"PASSES\": [\n    {\n      \"LOCAL_SIZE\": [\n        4,\n        4,\n        4\n      ],\n      \"EXECUTION_MODEL\": {\n        \"TYPE\": \"3D_IMAGE\",\n        \"TARGET\": \"volOut\"\n      }\n    }\n  ]\n}*/\n\nvoid main()\n{\n    ivec3 pos = ivec3(gl_GlobalInvocationID.xyz);\n    ivec3 size = imageSize(volOut);\n    if(any(greaterThanEqual(pos, size))) return;\n    vec3 p  = (vec3(pos) + 0.5) / vec3(size);\n    vec3 pc = p * 2.0 - 1.0;\n\n    vec3 q = abs(pc);\n    if(q.x < q.y) q.xy = q.yx;\n    if(q.x < q.z) q.xz = q.zx;\n    if(q.y < q.z) q.yz = q.zy;\n    imageStore(volOut, pos, texture(volIn, q*0.5 + 0.5));\n\n}\n","Root":"<LIBRARY>:packages/score-csf-testers/shaderlib/volume/13-symmetry/13-02_cubic_symmetry.cs","Inlets":[{"uuid":"5ac86198-2d03-4830-9e41-a6d529922d29","ObjectName":"Inlet","id":0,"Hidden":false,"Custom":"volIn","Exposed":"volin","Format":0,"FormatSet":false,"Filter":2,"AddressMode":1,"MipmapMode":0}],"Outlets":[{"uuid":"f1c71046-b754-49a5-8e66-d01374773dfc","ObjectName":"Outlet","id":0,"Hidden":false,"Custom":"volOut","Exposed":"volout"}]},{"uuid":"a5bbffe0-93d2-4e70-995c-cf46c2c43520","ObjectName":"CSF","id":31,"Metadata":{"ScriptingName":"10-08_volume_switcher8.1","Comment":"","Color":"Transparent1","Label":"","Touched":true},"Duration":14112000000,"Height":300.0,"StartOffset":0,"LoopDuration":22579200000,"Pos":[137.5,-270.0],"Size":[228.0,160.0],"Loops":false,"FoldMode":0,"Compute":"/*{\n  \"DESCRIPTION\": \"Volume switcher: forwards one of eight 3D volumes, chosen by Index. The 3D counterpart of the Video Switcher 8 utility (which switches 2D images and can only output a 2D image), so a whole volume chain can be swapped live before one viewer. The output takes the largest size among the connected inputs (an unconnected input is a 1x1x1 placeholder), fixed when the node is built; each input is sampled at normalised coordinates, so a smaller volume is resampled trilinearly to that grid, as a smaller image is stretched by the 2D switcher. Selecting an unconnected slot gives an empty volume (all zero: no colour, no density). The output is rgba16f, so signed and HDR inputs pass through without clipping.\",\n  \"CREDIT\": \"ossia 3D catalog\",\n  \"ISFVSN\": \"2.0\",\n  \"MODE\": \"COMPUTE_SHADER\",\n  \"CATEGORIES\": [\n    \"3D-FILTER\",\n    \"COMPOSITE\"\n  ],\n  \"INPUTS\": [\n    { \"NAME\": \"t0\", \"TYPE\": \"texture\", \"DIMENSIONS\": 3, \"LABEL\": \"Volume 0\" },\n    { \"NAME\": \"t1\", \"TYPE\": \"texture\", \"DIMENSIONS\": 3, \"LABEL\": \"Volume 1\" },\n    { \"NAME\": \"t2\", \"TYPE\": \"texture\", \"DIMENSIONS\": 3, \"LABEL\": \"Volume 2\" },\n    { \"NAME\": \"t3\", \"TYPE\": \"texture\", \"DIMENSIONS\": 3, \"LABEL\": \"Volume 3\" },\n    { \"NAME\": \"t4\", \"TYPE\": \"texture\", \"DIMENSIONS\": 3, \"LABEL\": \"Volume 4\" },\n    { \"NAME\": \"t5\", \"TYPE\": \"texture\", \"DIMENSIONS\": 3, \"LABEL\": \"Volume 5\" },\n    { \"NAME\": \"t6\", \"TYPE\": \"texture\", \"DIMENSIONS\": 3, \"LABEL\": \"Volume 6\" },\n    { \"NAME\": \"t7\", \"TYPE\": \"texture\", \"DIMENSIONS\": 3, \"LABEL\": \"Volume 7\" },\n    {\n      \"NAME\": \"index\",\n      \"TYPE\": \"long\",\n      \"DEFAULT\": 0,\n      \"VALUES\": [0, 1, 2, 3, 4, 5, 6, 7],\n      \"LABELS\": [\"0\", \"1\", \"2\", \"3\", \"4\", \"5\", \"6\", \"7\"],\n      \"LABEL\": \"Index\"\n    }\n  ],\n  \"RESOURCES\": [\n    {\n      \"NAME\": \"volOut\",\n      \"TYPE\": \"image\",\n      \"ACCESS\": \"write_only\",\n      \"FORMAT\": \"rgba16f\",\n      \"WIDTH\": \"max($WIDTH_t0, $WIDTH_t1, $WIDTH_t2, $WIDTH_t3, $WIDTH_t4, $WIDTH_t5, $WIDTH_t6, $WIDTH_t7)\",\n      \"HEIGHT\": \"max($HEIGHT_t0, $HEIGHT_t1, $HEIGHT_t2, $HEIGHT_t3, $HEIGHT_t4, $HEIGHT_t5, $HEIGHT_t6, $HEIGHT_t7)\",\n      \"DEPTH\": \"max($DEPTH_t0, $DEPTH_t1, $DEPTH_t2, $DEPTH_t3, $DEPTH_t4, $DEPTH_t5, $DEPTH_t6, $DEPTH_t7)\"\n    }\n  ],\n  \"PASSES\": [\n    {\n      \"LOCAL_SIZE\": [\n        4,\n        4,\n        4\n      ],\n      \"EXECUTION_MODEL\": {\n        \"TYPE\": \"3D_IMAGE\",\n        \"TARGET\": \"volOut\"\n      }\n    }\n  ]\n}*/\n\n// An unconnected slot is bound to the engine's 1x1x1 placeholder, whose\n// content is undefined: read it as empty.\nvec4 pick(sampler3D t, vec3 p)\n{\n    return all(equal(textureSize(t, 0), ivec3(1))) ? vec4(0.0) : texture(t, p);\n}\n\nvoid main()\n{\n    ivec3 pos = ivec3(gl_GlobalInvocationID.xyz);\n    ivec3 size = imageSize(volOut);\n    if(any(greaterThanEqual(pos, size))) return;\n    vec3 p = (vec3(pos) + 0.5) / vec3(size);\n    vec4 o;\n    switch(int(index))\n    {\n        case 0: o = pick(t0, p); break;\n        case 1: o = pick(t1, p); break;\n        case 2: o = pick(t2, p); break;\n        case 3: o = pick(t3, p); break;\n        case 4: o = pick(t4, p); break;\n        case 5: o = pick(t5, p); break;\n        case 6: o = pick(t6, p); break;\n        case 7: o = pick(t7, p); break;\n        default: o = vec4(0.0);\n    }\n    imageStore(volOut, pos, o);\n}\n","Root":"<LIBRARY>:packages/score-csf-testers/shaderlib/volume/10-compositing/10-08_volume_switcher8.cs","Inlets":[{"uuid":"5ac86198-2d03-4830-9e41-a6d529922d29","ObjectName":"Inlet","id":0,"Hidden":false,"Custom":"t0","Exposed":"t0","Format":0,"FormatSet":false,"Filter":2,"AddressMode":1,"MipmapMode":0},{"uuid":"5ac86198-2d03-4830-9e41-a6d529922d29","ObjectName":"Inlet","id":1,"Hidden":false,"Custom":"t1","Exposed":"t1","Format":0,"FormatSet":false,"Filter":2,"AddressMode":1,"MipmapMode":0},{"uuid":"5ac86198-2d03-4830-9e41-a6d529922d29","ObjectName":"Inlet","id":2,"Hidden":false,"Custom":"t2","Exposed":"t2","Format":0,"FormatSet":false,"Filter":2,"AddressMode":1,"MipmapMode":0},{"uuid":"5ac86198-2d03-4830-9e41-a6d529922d29","ObjectName":"Inlet","id":3,"Hidden":false,"Custom":"t3","Exposed":"t3","Format":0,"FormatSet":false,"Filter":2,"AddressMode":1,"MipmapMode":0},{"uuid":"5ac86198-2d03-4830-9e41-a6d529922d29","ObjectName":"Inlet","id":4,"Hidden":false,"Custom":"t4","Exposed":"t4","Format":0,"FormatSet":false,"Filter":2,"AddressMode":1,"MipmapMode":0},{"uuid":"5ac86198-2d03-4830-9e41-a6d529922d29","ObjectName":"Inlet","id":5,"Hidden":false,"Custom":"t5","Exposed":"t5","Format":0,"FormatSet":false,"Filter":2,"AddressMode":1,"MipmapMode":0},{"uuid":"5ac86198-2d03-4830-9e41-a6d529922d29","ObjectName":"Inlet","id":6,"Hidden":false,"Custom":"t6","Exposed":"t6","Format":0,"FormatSet":false,"Filter":2,"AddressMode":1,"MipmapMode":0},{"uuid":"5ac86198-2d03-4830-9e41-a6d529922d29","ObjectName":"Inlet","id":7,"Hidden":false,"Custom":"t7","Exposed":"t7","Format":0,"FormatSet":false,"Filter":2,"AddressMode":1,"MipmapMode":0},{"uuid":"485680cc-b8b9-4a01-acc7-3e8334bdc016","ObjectName":"Inlet","id":8,"Hidden":true,"Custom":"index","Exposed":"index","Value":{"Int":4},"Init":{"Int":0},"Domain":{"Int":{"Values":[0,1,2,3,4,5,6,7]}},"Values":[["0",{"Int":0}],["1",{"Int":1}],["2",{"Int":2}],["3",{"Int":3}],["4",{"Int":4}],["5",{"Int":5}],["6",{"Int":6}],["7",{"Int":7}]],"FolderPort":"","FileExtensions":""}],"Outlets":[{"uuid":"f1c71046-b754-49a5-8e66-d01374773dfc","ObjectName":"Outlet","id":0,"Hidden":false,"Custom":"volOut","Exposed":"volout"}]},{"uuid":"a5bbffe0-93d2-4e70-995c-cf46c2c43520","ObjectName":"CSF","id":32,"Metadata":{"ScriptingName":"13-03_nfold_axial","Comment":"","Color":"Transparent1","Label":"","Touched":true},"Duration":14112000000,"Height":300.0,"StartOffset":0,"LoopDuration":22579200000,"Pos":[1.5,34.0],"Size":[173.0,107.5],"Loops":false,"FoldMode":0,"Compute":"/*{\n  \"DESCRIPTION\": \"N-fold rotational symmetry around an axis: fold the azimuthal angle into a wedge of 2\\u03c0/N, then mirror. Mirror halves additionally mirrors one half of the volume onto the other along the axis (around Y: the top onto the bottom), for a crystal-like kaleidoscope; axis Y with Mirror halves on replaces the former 08-09_kaleidoscope3d (archived). The output is rgba16f, so signed and HDR inputs (01-15 curl noise, the simulations, 07-06 Laplacian...) pass through without clipping.\",\n  \"CREDIT\": \"ossia 3D catalog\",\n  \"ISFVSN\": \"2.0\",\n  \"MODE\": \"COMPUTE_SHADER\",\n  \"CATEGORIES\": [\n    \"3D-FILTER\",\n    \"SYMMETRY\"\n  ],\n  \"INPUTS\": [\n    {\n      \"NAME\": \"volIn\",\n      \"TYPE\": \"texture\",\n      \"DIMENSIONS\": 3,\n      \"LABEL\": \"Input volume\"\n    },\n    {\n      \"NAME\": \"folds\",\n      \"TYPE\": \"long\",\n      \"DEFAULT\": 6,\n      \"MIN\": 2,\n      \"MAX\": 16,\n      \"LABEL\": \"N folds\"\n    },\n    {\n      \"NAME\": \"axis\",\n      \"TYPE\": \"long\",\n      \"DEFAULT\": 1,\n      \"VALUES\": [\n        0,\n        1,\n        2\n      ],\n      \"LABELS\": [\n        \"X\",\n        \"Y\",\n        \"Z\"\n      ],\n      \"LABEL\": \"Axis\"\n    },\n    {\n      \"NAME\": \"mirror\",\n      \"TYPE\": \"bool\",\n      \"DEFAULT\": false,\n      \"LABEL\": \"Mirror halves along the axis\"\n    }\n  ],\n  \"RESOURCES\": [\n    {\n      \"NAME\": \"volOut\",\n      \"TYPE\": \"image\",\n      \"ACCESS\": \"write_only\",\n      \"FORMAT\": \"rgba16f\",\n      \"WIDTH\": \"$WIDTH_volIn\",\n      \"HEIGHT\": \"$HEIGHT_volIn\",\n      \"DEPTH\": \"$DEPTH_volIn\"\n    }\n  ],\n  \"PASSES\": [\n    {\n      \"LOCAL_SIZE\": [\n        4,\n        4,\n        4\n      ],\n      \"EXECUTION_MODEL\": {\n        \"TYPE\": \"3D_IMAGE\",\n        \"TARGET\": \"volOut\"\n      }\n    }\n  ]\n}*/\n\nvoid main()\n{\n    ivec3 pos = ivec3(gl_GlobalInvocationID.xyz);\n    ivec3 size = imageSize(volOut);\n    if(any(greaterThanEqual(pos, size))) return;\n    vec3 p  = (vec3(pos) + 0.5) / vec3(size);\n    vec3 pc = p * 2.0 - 1.0;\n\n    vec3 q = pc;\n    float sec = 3.14159265 / float(folds);\n    if(axis == 0){\n        float r = length(q.yz);\n        float a = atan(q.z, q.y);\n        a = mod(a + sec, 2.0*sec) - sec;\n        a = abs(a);\n        q.y = r*cos(a); q.z = r*sin(a);\n    } else if(axis == 1){\n        float r = length(q.xz);\n        float a = atan(q.z, q.x);\n        a = mod(a + sec, 2.0*sec) - sec;\n        a = abs(a);\n        q.x = r*cos(a); q.z = r*sin(a);\n    } else {\n        float r = length(q.xy);\n        float a = atan(q.y, q.x);\n        a = mod(a + sec, 2.0*sec) - sec;\n        a = abs(a);\n        q.x = r*cos(a); q.y = r*sin(a);\n    }\n    if(mirror){\n        if(axis == 0)      q.x = abs(q.x);\n        else if(axis == 1) q.y = abs(q.y);\n        else               q.z = abs(q.z);\n    }\n    imageStore(volOut, pos, texture(volIn, q*0.5 + 0.5));\n\n}\n","Root":"<LIBRARY>:packages/score-csf-testers/shaderlib/volume/13-symmetry/13-03_nfold_axial.cs","Inlets":[{"uuid":"5ac86198-2d03-4830-9e41-a6d529922d29","ObjectName":"Inlet","id":0,"Hidden":false,"Custom":"volIn","Exposed":"volin","Format":0,"FormatSet":false,"Filter":2,"AddressMode":1,"MipmapMode":0},{"uuid":"238399a0-7e81-47e3-896f-08e8856e2973","ObjectName":"Inlet","id":1,"Hidden":true,"Custom":"folds","Exposed":"folds","Value":{"Int":6},"Init":{"Int":6},"Domain":{"Int":{"Min":2,"Max":16}}},{"uuid":"485680cc-b8b9-4a01-acc7-3e8334bdc016","ObjectName":"Inlet","id":2,"Hidden":true,"Custom":"axis","Exposed":"axis","Value":{"Int":1},"Init":{"Int":1},"Domain":{"Int":{"Values":[0,1,2]}},"Values":[["X",{"Int":0}],["Y",{"Int":1}],["Z",{"Int":2}]],"FolderPort":"","FileExtensions":""},{"uuid":"fb27e4cb-ea7f-41e2-ad92-2354498c1b6b","ObjectName":"Inlet","id":3,"Hidden":true,"Custom":"mirror","Exposed":"mirror","Value":{"Bool":false},"Init":{"Bool":false},"Domain":{"Bool":null}}],"Outlets":[{"uuid":"f1c71046-b754-49a5-8e66-d01374773dfc","ObjectName":"Outlet","id":0,"Hidden":false,"Custom":"volOut","Exposed":"volout"}]},{"uuid":"a5bbffe0-93d2-4e70-995c-cf46c2c43520","ObjectName":"CSF","id":33,"Metadata":{"ScriptingName":"14-01_pixelate3d","Comment":"","Color":"Transparent1","Label":"","Touched":true},"Duration":14112000000,"Height":300.0,"StartOffset":0,"LoopDuration":22579200000,"Pos":[5.5,212.0],"Size":[171.0,52.0],"Loops":false,"FoldMode":0,"Compute":"/*{\n  \"DESCRIPTION\": \"3D pixelate / cubify: snap sample position to a coarse grid and sample the center. Voxel-art look. The output is rgba16f, so signed and HDR inputs (01-15 curl noise, the simulations, 07-06 Laplacian...) pass through without clipping.\",\n  \"CREDIT\": \"ossia 3D catalog\",\n  \"ISFVSN\": \"2.0\",\n  \"MODE\": \"COMPUTE_SHADER\",\n  \"CATEGORIES\": [\n    \"3D-FILTER\",\n    \"STYLIZE\"\n  ],\n  \"INPUTS\": [\n    {\n      \"NAME\": \"volIn\",\n      \"TYPE\": \"texture\",\n      \"DIMENSIONS\": 3,\n      \"LABEL\": \"Input volume\"\n    },\n    {\n      \"NAME\": \"cellCount\",\n      \"TYPE\": \"long\",\n      \"DEFAULT\": 16,\n      \"MIN\": 4,\n      \"MAX\": 64,\n      \"LABEL\": \"Cells per side\"\n    }\n  ],\n  \"RESOURCES\": [\n    {\n      \"NAME\": \"volOut\",\n      \"TYPE\": \"image\",\n      \"ACCESS\": \"write_only\",\n      \"FORMAT\": \"rgba16f\",\n      \"WIDTH\": \"$WIDTH_volIn\",\n      \"HEIGHT\": \"$HEIGHT_volIn\",\n      \"DEPTH\": \"$DEPTH_volIn\"\n    }\n  ],\n  \"PASSES\": [\n    {\n      \"LOCAL_SIZE\": [\n        4,\n        4,\n        4\n      ],\n      \"EXECUTION_MODEL\": {\n        \"TYPE\": \"3D_IMAGE\",\n        \"TARGET\": \"volOut\"\n      }\n    }\n  ]\n}*/\n\nvoid main()\n{\n    ivec3 pos = ivec3(gl_GlobalInvocationID.xyz);\n    ivec3 size = imageSize(volOut);\n    if(any(greaterThanEqual(pos, size))) return;\n    vec3 p  = (vec3(pos) + 0.5) / vec3(size);\n    vec3 pc = p * 2.0 - 1.0;\n\n    float n = float(cellCount);\n    vec3 q = (floor(p*n) + 0.5) / n;\n    imageStore(volOut, pos, texture(volIn, q));\n\n}\n","Root":"<LIBRARY>:packages/score-csf-testers/shaderlib/volume/14-stylize/14-01_pixelate3d.cs","Inlets":[{"uuid":"5ac86198-2d03-4830-9e41-a6d529922d29","ObjectName":"Inlet","id":0,"Hidden":false,"Custom":"volIn","Exposed":"volin","Format":0,"FormatSet":false,"Filter":2,"AddressMode":1,"MipmapMode":0},{"uuid":"238399a0-7e81-47e3-896f-08e8856e2973","ObjectName":"Inlet","id":1,"Hidden":true,"Custom":"cellCount","Exposed":"cellcount","Value":{"Int":12},"Init":{"Int":16},"Domain":{"Int":{"Min":4,"Max":64}}}],"Outlets":[{"uuid":"f1c71046-b754-49a5-8e66-d01374773dfc","ObjectName":"Outlet","id":0,"Hidden":false,"Custom":"volOut","Exposed":"volout"}]},{"uuid":"a5bbffe0-93d2-4e70-995c-cf46c2c43520","ObjectName":"CSF","id":35,"Metadata":{"ScriptingName":"14-07_voronoi_stylize","Comment":"","Color":"Transparent1","Label":"","Touched":true},"Duration":14112000000,"Height":300.0,"StartOffset":0,"LoopDuration":22579200000,"Pos":[15.5,317.0],"Size":[201.0,55.0],"Loops":false,"FoldMode":2,"Compute":"/*{\n  \"DESCRIPTION\": \"Voronoi stylization: each voxel adopts the color of its nearest feature point in a random 3D grid. Flattens the volume into faceted cells \\u2014 low-poly / paper-craft look. The output is rgba16f, so signed and HDR inputs (01-15 curl noise, the simulations, 07-06 Laplacian...) pass through without clipping.\",\n  \"CREDIT\": \"ossia 3D catalog\",\n  \"ISFVSN\": \"2.0\",\n  \"MODE\": \"COMPUTE_SHADER\",\n  \"CATEGORIES\": [\n    \"3D-FILTER\",\n    \"STYLIZE\"\n  ],\n  \"INPUTS\": [\n    {\n      \"NAME\": \"volIn\",\n      \"TYPE\": \"texture\",\n      \"DIMENSIONS\": 3,\n      \"LABEL\": \"Input volume\"\n    },\n    {\n      \"NAME\": \"cellScale\",\n      \"TYPE\": \"float\",\n      \"DEFAULT\": 6.0,\n      \"MIN\": 1.0,\n      \"MAX\": 32.0,\n      \"LABEL\": \"Cell scale\"\n    }\n  ],\n  \"RESOURCES\": [\n    {\n      \"NAME\": \"volOut\",\n      \"TYPE\": \"image\",\n      \"ACCESS\": \"write_only\",\n      \"FORMAT\": \"rgba16f\",\n      \"WIDTH\": \"$WIDTH_volIn\",\n      \"HEIGHT\": \"$HEIGHT_volIn\",\n      \"DEPTH\": \"$DEPTH_volIn\"\n    }\n  ],\n  \"PASSES\": [\n    {\n      \"LOCAL_SIZE\": [\n        4,\n        4,\n        4\n      ],\n      \"EXECUTION_MODEL\": {\n        \"TYPE\": \"3D_IMAGE\",\n        \"TARGET\": \"volOut\"\n      }\n    }\n  ]\n}*/\n\nvec3 hash33(vec3 p){\n    p = vec3(dot(p, vec3(127.1,311.7, 74.7)),\n             dot(p, vec3(269.5,183.3,246.1)),\n             dot(p, vec3(113.5,271.9,124.6)));\n    return fract(sin(p)*43758.5453123);\n}\n\nvoid main()\n{\n    ivec3 pos = ivec3(gl_GlobalInvocationID.xyz);\n    ivec3 size = imageSize(volOut);\n    if(any(greaterThanEqual(pos, size))) return;\n    vec3 p  = (vec3(pos) + 0.5) / vec3(size);\n    vec3 pc = p * 2.0 - 1.0;\n\n    vec3 q = p * cellScale;\n    vec3 P = floor(q);\n    vec3 F = fract(q);\n    float best = 1e9;\n    vec3 bestPt = vec3(0.0);\n    for(int k=-1;k<=1;k++)\n    for(int j=-1;j<=1;j++)\n    for(int i=-1;i<=1;i++){\n        vec3 b = vec3(i,j,k);\n        vec3 c = hash33(P + b);\n        vec3 r = b + c - F;\n        float d = dot(r,r);\n        if(d < best){ best = d; bestPt = (P + b + c) / cellScale; }\n    }\n    vec4 c = texture(volIn, bestPt);\n    imageStore(volOut, pos, c);\n\n}\n","Root":"<LIBRARY>:packages/score-csf-testers/shaderlib/volume/14-stylize/14-07_voronoi_stylize.cs","Inlets":[{"uuid":"5ac86198-2d03-4830-9e41-a6d529922d29","ObjectName":"Inlet","id":0,"Hidden":false,"Custom":"volIn","Exposed":"volin","Format":0,"FormatSet":false,"Filter":2,"AddressMode":1,"MipmapMode":0},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":1,"Hidden":true,"Custom":"cellScale","Exposed":"cellscale","Value":{"Float":6.0},"Init":{"Float":6.0},"Domain":{"Float":{"Min":1.0,"Max":32.0}}}],"Outlets":[{"uuid":"f1c71046-b754-49a5-8e66-d01374773dfc","ObjectName":"Outlet","id":0,"Hidden":false,"Custom":"volOut","Exposed":"volout"}]},{"uuid":"a5bbffe0-93d2-4e70-995c-cf46c2c43520","ObjectName":"CSF","id":36,"Metadata":{"ScriptingName":"15-03_audio_metaballs","Comment":"","Color":"Transparent1","Label":"","Touched":true},"Duration":14112000000,"Height":300.0,"StartOffset":0,"LoopDuration":22579200000,"Pos":[8.5,414.0],"Size":[207.0,160.0],"Loops":false,"FoldMode":0,"Compute":"/*{\n  \"DESCRIPTION\": \"Three 3D metaballs whose radii are driven by bass / mid / high frequency bands. The blobs pulse and merge with the music. Very VJ-friendly gooey audio-reactivity.\",\n  \"CREDIT\": \"ossia 3D catalog\",\n  \"ISFVSN\": \"2.0\",\n  \"MODE\": \"COMPUTE_SHADER\",\n  \"CATEGORIES\": [\n    \"3D-GENERATOR\",\n    \"AUDIO\"\n  ],\n  \"INPUTS\": [\n    {\n      \"NAME\": \"fft\",\n      \"TYPE\": \"audioFFT\",\n      \"MAX\": 256,\n      \"LABEL\": \"Audio spectrum\"\n    },\n    {\n      \"NAME\": \"baseRadius\",\n      \"TYPE\": \"float\",\n      \"DEFAULT\": 0.2,\n      \"MIN\": 0.05,\n      \"MAX\": 0.6,\n      \"LABEL\": \"Base radius\"\n    },\n    {\n      \"NAME\": \"reactivity\",\n      \"TYPE\": \"float\",\n      \"DEFAULT\": 2.5,\n      \"MIN\": 0.0,\n      \"MAX\": 8.0,\n      \"LABEL\": \"Pulse gain\"\n    },\n    {\n      \"NAME\": \"speed\",\n      \"TYPE\": \"float\",\n      \"DEFAULT\": 0.8,\n      \"MIN\": 0.0,\n      \"MAX\": 3.0,\n      \"LABEL\": \"Orbit speed\"\n    },\n    {\n      \"NAME\": \"threshold\",\n      \"TYPE\": \"float\",\n      \"DEFAULT\": 1.0,\n      \"MIN\": 0.2,\n      \"MAX\": 3.0,\n      \"LABEL\": \"Iso threshold\"\n    }\n  ],\n  \"RESOURCES\": [\n    {\n      \"NAME\": \"volume\",\n      \"TYPE\": \"image\",\n      \"ACCESS\": \"write_only\",\n      \"WIDTH\": \"64\",\n      \"HEIGHT\": \"64\",\n      \"DEPTH\": \"64\"\n    }\n  ],\n  \"PASSES\": [\n    {\n      \"LOCAL_SIZE\": [\n        4,\n        4,\n        4\n      ],\n      \"EXECUTION_MODEL\": {\n        \"TYPE\": \"3D_IMAGE\",\n        \"TARGET\": \"volume\"\n      }\n    }\n  ]\n}*/\n\nfloat audioBand(sampler2D fft, float lo, float hi){\n    const int N = 8;\n    float acc = 0.0;\n    for(int i = 0; i < N; i++){\n        float x = mix(lo, hi, (float(i) + 0.5) / float(N));\n        acc += texture(fft, vec2(x, 0.0)).r;\n    }\n    return acc / float(N);\n}\nfloat audioBass(sampler2D fft)   { return audioBand(fft, 0.00, 0.10); }\nfloat audioLowMid(sampler2D fft) { return audioBand(fft, 0.10, 0.25); }\nfloat audioMid(sampler2D fft)    { return audioBand(fft, 0.25, 0.50); }\nfloat audioHigh(sampler2D fft)   { return audioBand(fft, 0.50, 1.00); }\n// Overall amplitude from spectrum (broadband)\nfloat audioAmp(sampler2D fft)    { return audioBand(fft,  0.0, 1.0); }\n\nvoid main()\n{\n    ivec3 pos = ivec3(gl_GlobalInvocationID.xyz);\n    ivec3 size = imageSize(volume);\n    if(any(greaterThanEqual(pos, size))) return;\n    vec3 p  = (vec3(pos) + 0.5) / vec3(size);   // [0,1]^3\n    vec3 pc = p * 2.0 - 1.0;                     // [-1,1]^3\n\n    float t = TIME * speed;\n    vec3 c1 = 0.45 * vec3(sin(t*1.1), cos(t*0.7), sin(t*0.9));\n    vec3 c2 = 0.45 * vec3(cos(t*1.7+1.0), sin(t*0.8+2.0), cos(t*1.2+0.5));\n    vec3 c3 = 0.45 * vec3(sin(t*0.6+3.0), sin(t*1.4+1.5), cos(t*1.0+2.5));\n    float rBass = baseRadius * (1.0 + audioBass(fft) * reactivity);\n    float rMid  = baseRadius * (1.0 + audioMid(fft)  * reactivity);\n    float rHigh = baseRadius * (1.0 + audioHigh(fft) * reactivity);\n    float f1 = rBass*rBass / max(dot(pc-c1,pc-c1), 1e-4);\n    float f2 = rMid*rMid   / max(dot(pc-c2,pc-c2), 1e-4);\n    float f3 = rHigh*rHigh / max(dot(pc-c3,pc-c3), 1e-4);\n    float f = f1 + f2 + f3;\n    float v = smoothstep(threshold * 0.7, threshold * 1.3, f);\n    // Colour by which ball is closest\n    vec3 col = vec3(1.0, 0.25, 0.25) * f1\n             + vec3(0.3, 1.0, 0.4)   * f2\n             + vec3(0.3, 0.5, 1.0)   * f3;\n    col /= max(f, 1e-3);\n    imageStore(volume, pos, vec4(col * v, v));\n\n}\n","Root":"<LIBRARY>:packages/score-csf-testers/shaderlib/volume/15-audio/15-03_audio_metaballs.cs","Inlets":[{"uuid":"a1574bb0-cbd4-4c7d-9417-0c25cfd1187b","ObjectName":"Inlet","id":0,"Hidden":false,"Custom":"fft","Exposed":"fft"},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":1,"Hidden":true,"Custom":"baseRadius","Exposed":"baseradius","Value":{"Float":0.20000000298023224},"Init":{"Float":0.20000000298023224},"Domain":{"Float":{"Min":0.05000000074505806,"Max":0.6000000238418579}}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":2,"Hidden":true,"Custom":"reactivity","Exposed":"reactivity","Value":{"Float":2.5},"Init":{"Float":2.5},"Domain":{"Float":{"Min":0.0,"Max":8.0}}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":3,"Hidden":true,"Custom":"speed","Exposed":"speed","Value":{"Float":0.800000011920929},"Init":{"Float":0.800000011920929},"Domain":{"Float":{"Min":0.0,"Max":3.0}}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":4,"Hidden":true,"Custom":"threshold","Exposed":"threshold","Value":{"Float":1.0},"Init":{"Float":1.0},"Domain":{"Float":{"Min":0.20000000298023224,"Max":3.0}}}],"Outlets":[{"uuid":"f1c71046-b754-49a5-8e66-d01374773dfc","ObjectName":"Outlet","id":0,"Hidden":false,"Custom":"volume","Exposed":"volume"}]},{"uuid":"25c64b87-a44a-4fed-9f60-0a48906fd3ec","ObjectName":"MicroMapping","id":37,"Metadata":{"ScriptingName":"Micromap.20","Comment":"","Color":"Transparent1","Label":"","Touched":true},"Duration":14112000000,"Height":300.0,"StartOffset":0,"LoopDuration":22579200000,"Pos":[-291.0,-588.25],"Size":[180.0,35.0],"Loops":false,"FoldMode":0,"Inlets":[{"uuid":"769dd38a-bfb3-4dc6-b52a-b6abb7afe2a3","ObjectName":"Inlet","id":0,"Hidden":false,"Custom":"in","Exposed":"in"},{"uuid":"9ae797ea-d94c-4792-acec-9ec1932bae5d","ObjectName":"Inlet","id":1,"Hidden":true,"Custom":"Expression","Exposed":"expression","Value":{"String":"(round(4x)+7)%5"},"Init":{"String":"x / 127"},"Domain":{}}],"Outlets":[{"uuid":"cff96158-cc72-46d7-99dc-b6038171375b","ObjectName":"Outlet","id":0,"Hidden":false,"Custom":"out","Exposed":"out"}]},{"uuid":"0b1b1816-c33e-4796-a16d-5aab27fe600f","ObjectName":"LFO","id":38,"Metadata":{"ScriptingName":"LFO.1","Comment":"","Color":"Transparent1","Label":"","Touched":true},"Duration":14112000000,"Height":300.0,"StartOffset":0,"LoopDuration":22579200000,"Pos":[-686.0,-588.25],"Size":[261.0,117.5],"Loops":false,"FoldMode":0,"Inlets":[{"uuid":"b631d9b7-cbe3-4d9c-b470-f139e348aecb","ObjectName":"Inlet","id":0,"Hidden":true,"Custom":"Period","Exposed":"period","Value":{"Vec2f":[0.5,1.0]},"Init":{"Vec2f":[0.5,1.0]},"Domain":{"Vec2f":{"Min":[0.009999999776482582,0.0],"Max":[60.0,1.0],"Values":[[],[]]}}},{"uuid":"82427d27-084a-4ab6-9c4e-db83929a1200","ObjectName":"Inlet","id":1,"Hidden":true,"Custom":"Shape","Exposed":"shape","Value":{"Float":0.5},"Init":{"Float":0.5},"Domain":{"Float":{"Min":0.0,"Max":1.0}}},{"uuid":"7cd210d3-ebd1-4f71-9de6-cccfb639cbc3","ObjectName":"Inlet","id":2,"Hidden":true,"Custom":"Retrigger","Exposed":"retrigger","Value":{"Impulse":null},"Init":{"Impulse":null},"Domain":{"Impulse":null}},{"uuid":"82427d27-084a-4ab6-9c4e-db83929a1200","ObjectName":"Inlet","id":3,"Hidden":true,"Custom":"Ampl.","Exposed":"ampl.","Value":{"Float":0.5},"Init":{"Float":0.5},"Domain":{"Float":{"Min":0.0,"Max":2.0}}},{"uuid":"82427d27-084a-4ab6-9c4e-db83929a1200","ObjectName":"Inlet","id":4,"Hidden":true,"Custom":"Offset","Exposed":"offset","Value":{"Float":0.5},"Init":{"Float":0.5},"Domain":{"Float":{"Min":-1.0,"Max":1.0}}},{"uuid":"82427d27-084a-4ab6-9c4e-db83929a1200","ObjectName":"Inlet","id":5,"Hidden":true,"Custom":"Jitter","Exposed":"jitter","Value":{"Float":0.0},"Init":{"Float":0.0},"Domain":{"Float":{"Min":0.0,"Max":180.0}}},{"uuid":"82427d27-084a-4ab6-9c4e-db83929a1200","ObjectName":"Inlet","id":6,"Hidden":true,"Custom":"Phase","Exposed":"phase","Value":{"Float":0.0},"Init":{"Float":0.0},"Domain":{"Float":{"Min":0.0,"Max":360.0}}},{"uuid":"8b1d76c4-3838-4ac0-9b9c-c12bc5db8e8a","ObjectName":"Inlet","id":7,"Hidden":true,"Custom":"Waveform","Exposed":"waveform","Value":{"String":"SampleAndHoldEveryTick"},"Init":{"String":"Sin"},"Domain":{"String":{"Values":["Sin","Triangle","Saw","RampDown","Square","SquareOnChange","SampleAndHoldEveryTick","SampleAndHold","Noise1","Noise2","Noise3","Drift"]}},"Values":["Sin","Triangle","Saw","RampDown","Square","SquareOnChange","SampleAndHoldEveryTick","SampleAndHold","Noise1","Noise2","Noise3","Drift"],"Pixmaps":[":/icons/wave_sin_off.png",":/icons/wave_sin_on.png",":/icons/wave_triangle_off.png",":/icons/wave_triangle_on.png",":/icons/wave_saw_off.png",":/icons/wave_saw_on.png",":/icons/wave_ramp_down_off.png",":/icons/wave_ramp_down_on.png",":/icons/wave_square_ticks_off.png",":/icons/wave_square_ticks_on.png",":/icons/wave_square_changes_off.png",":/icons/wave_square_changes_on.png",":/icons/wave_sample_and_hold_ticks_off.png",":/icons/wave_sample_and_hold_ticks_on.png",":/icons/wave_sample_and_hold_changes_off.png",":/icons/wave_sample_and_hold_changes_on.png",":/icons/wave_noise1_off.png",":/icons/wave_noise1_on.png",":/icons/wave_noise2_off.png",":/icons/wave_noise2_on.png",":/icons/wave_noise3_off.png",":/icons/wave_noise3_on.png",":/icons/wave_drift_off.png",":/icons/wave_drift_on.png"]},{"uuid":"fb27e4cb-ea7f-41e2-ad92-2354498c1b6b","ObjectName":"Inlet","id":8,"Hidden":true,"Custom":"Lock to bars","Exposed":"lock to bars","Value":{"Bool":false},"Init":{"Bool":false},"Domain":{"Bool":null}}],"Outlets":[{"uuid":"cff96158-cc72-46d7-99dc-b6038171375b","ObjectName":"Outlet","id":0,"Hidden":false,"Custom":"Out","Exposed":"out"}]},{"uuid":"a5bbffe0-93d2-4e70-995c-cf46c2c43520","ObjectName":"CSF","id":40,"Metadata":{"ScriptingName":"01-04_worley_f1.1","Comment":"","Color":"Transparent1","Label":"","Touched":true},"Duration":14112000000,"Height":300.0,"StartOffset":0,"LoopDuration":16934400000,"Pos":[-649.75,-1660.0],"Size":[175.0,70.0],"Loops":false,"FoldMode":0,"Compute":"/*{\n  \"DESCRIPTION\": \"3D Worley (cellular) noise, F1 distance \\u2014 distance to nearest feature point. Produces pebble / cell patterns. Small scale \\u2192 many cells, big scale \\u2192 few.\",\n  \"CREDIT\": \"ossia 3D catalog\",\n  \"ISFVSN\": \"2.0\",\n  \"MODE\": \"COMPUTE_SHADER\",\n  \"CATEGORIES\": [\n    \"3D-GENERATOR\",\n    \"NOISE\"\n  ],\n  \"INPUTS\": [\n    {\n      \"NAME\": \"scale\",\n      \"TYPE\": \"float\",\n      \"DEFAULT\": 6.0,\n      \"MIN\": 1.0,\n      \"MAX\": 32.0,\n      \"LABEL\": \"Scale\"\n    },\n    {\n      \"NAME\": \"drift\",\n      \"TYPE\": \"float\",\n      \"DEFAULT\": 0.15,\n      \"MIN\": 0.0,\n      \"MAX\": 2.0,\n      \"LABEL\": \"Drift\"\n    }\n  ],\n  \"RESOURCES\": [\n    {\n      \"NAME\": \"volume\",\n      \"TYPE\": \"image\",\n      \"ACCESS\": \"write_only\",\n      \"WIDTH\": \"64\",\n      \"HEIGHT\": \"64\",\n      \"DEPTH\": \"64\"\n    }\n  ],\n  \"PASSES\": [\n    {\n      \"LOCAL_SIZE\": [\n        4,\n        4,\n        4\n      ],\n      \"EXECUTION_MODEL\": {\n        \"TYPE\": \"3D_IMAGE\",\n        \"TARGET\": \"volume\"\n      }\n    }\n  ]\n}*/\n\n// --- Hashing & random ----------------------------------------------------\nfloat hash11(float n){ return fract(sin(n)*43758.5453123); }\nfloat hash13(vec3 p){\n    p = fract(p * 0.3183099 + 0.1);\n    p *= 17.0;\n    return fract(p.x*p.y*p.z*(p.x+p.y+p.z));\n}\nvec3 hash33(vec3 p){\n    p = vec3(dot(p,vec3(127.1,311.7, 74.7)),\n             dot(p,vec3(269.5,183.3,246.1)),\n             dot(p,vec3(113.5,271.9,124.6)));\n    return fract(sin(p) * 43758.5453123);\n}\n\n// Worley 3D: returns vec2(F1, F2) — distances to nearest / 2nd-nearest feature points.\nvec2 worley(vec3 x){\n    vec3 p = floor(x);\n    vec3 f = fract(x);\n    float F1 = 1e9, F2 = 1e9;\n    for(int k=-1;k<=1;k++)\n    for(int j=-1;j<=1;j++)\n    for(int i=-1;i<=1;i++){\n        vec3 b = vec3(i,j,k);\n        vec3 r = b + hash33(p+b) - f;\n        float d = dot(r,r);\n        if(d < F1){ F2 = F1; F1 = d; }\n        else if(d < F2){ F2 = d; }\n    }\n    return sqrt(vec2(F1, F2));\n}\n\nvoid main()\n{\n    ivec3 pos = ivec3(gl_GlobalInvocationID.xyz);\n    ivec3 size = imageSize(volume);\n    if(any(greaterThanEqual(pos, size))) return;\n    vec3 p  = (vec3(pos) + 0.5) / vec3(size);   // [0,1]^3\n    vec3 pc = p * 2.0 - 1.0;                     // [-1,1]^3\n\n    vec2 w = worley(pc * scale + vec3(TIME*drift));\n    float v = clamp(w.x, 0.0, 1.0);\n    imageStore(volume, pos, vec4(vec3(v), 1.0));\n\n}\n","Root":"<LIBRARY>:packages/score-csf-testers/archive/2026-09-25/volume/01-04_worley_f1.cs","Inlets":[{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":0,"Hidden":true,"Custom":"scale","Exposed":"scale","Value":{"Float":2.2916667461395264},"Init":{"Float":6.0},"Domain":{"Float":{"Min":1.0,"Max":32.0}}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":1,"Hidden":true,"Custom":"drift","Exposed":"drift","Value":{"Float":0.15000000596046448},"Init":{"Float":0.15000000596046448},"Domain":{"Float":{"Min":0.0,"Max":2.0}}}],"Outlets":[{"uuid":"f1c71046-b754-49a5-8e66-d01374773dfc","ObjectName":"Outlet","id":0,"Hidden":false,"Custom":"volume","Exposed":"volume"}]},{"uuid":"a5bbffe0-93d2-4e70-995c-cf46c2c43520","ObjectName":"CSF","id":41,"Metadata":{"ScriptingName":"10-08_volume_switcher8.2","Comment":"","Color":"Transparent1","Label":"","Touched":true},"Duration":14112000000,"Height":300.0,"StartOffset":0,"LoopDuration":22579200000,"Pos":[-253.5585819747048,-1525.0],"Size":[228.0,160.0],"Loops":false,"FoldMode":0,"Compute":"/*{\n  \"DESCRIPTION\": \"Volume switcher: forwards one of eight 3D volumes, chosen by Index. The 3D counterpart of the Video Switcher 8 utility (which switches 2D images and can only output a 2D image), so a whole volume chain can be swapped live before one viewer. The output takes the largest size among the connected inputs (an unconnected input is a 1x1x1 placeholder), fixed when the node is built; each input is sampled at normalised coordinates, so a smaller volume is resampled trilinearly to that grid, as a smaller image is stretched by the 2D switcher. Selecting an unconnected slot gives an empty volume (all zero: no colour, no density). The output is rgba16f, so signed and HDR inputs pass through without clipping.\",\n  \"CREDIT\": \"ossia 3D catalog\",\n  \"ISFVSN\": \"2.0\",\n  \"MODE\": \"COMPUTE_SHADER\",\n  \"CATEGORIES\": [\n    \"3D-FILTER\",\n    \"COMPOSITE\"\n  ],\n  \"INPUTS\": [\n    { \"NAME\": \"t0\", \"TYPE\": \"texture\", \"DIMENSIONS\": 3, \"LABEL\": \"Volume 0\" },\n    { \"NAME\": \"t1\", \"TYPE\": \"texture\", \"DIMENSIONS\": 3, \"LABEL\": \"Volume 1\" },\n    { \"NAME\": \"t2\", \"TYPE\": \"texture\", \"DIMENSIONS\": 3, \"LABEL\": \"Volume 2\" },\n    { \"NAME\": \"t3\", \"TYPE\": \"texture\", \"DIMENSIONS\": 3, \"LABEL\": \"Volume 3\" },\n    { \"NAME\": \"t4\", \"TYPE\": \"texture\", \"DIMENSIONS\": 3, \"LABEL\": \"Volume 4\" },\n    { \"NAME\": \"t5\", \"TYPE\": \"texture\", \"DIMENSIONS\": 3, \"LABEL\": \"Volume 5\" },\n    { \"NAME\": \"t6\", \"TYPE\": \"texture\", \"DIMENSIONS\": 3, \"LABEL\": \"Volume 6\" },\n    { \"NAME\": \"t7\", \"TYPE\": \"texture\", \"DIMENSIONS\": 3, \"LABEL\": \"Volume 7\" },\n    {\n      \"NAME\": \"index\",\n      \"TYPE\": \"long\",\n      \"DEFAULT\": 0,\n      \"VALUES\": [0, 1, 2, 3, 4, 5, 6, 7],\n      \"LABELS\": [\"0\", \"1\", \"2\", \"3\", \"4\", \"5\", \"6\", \"7\"],\n      \"LABEL\": \"Index\"\n    }\n  ],\n  \"RESOURCES\": [\n    {\n      \"NAME\": \"volOut\",\n      \"TYPE\": \"image\",\n      \"ACCESS\": \"write_only\",\n      \"FORMAT\": \"rgba16f\",\n      \"WIDTH\": \"max($WIDTH_t0, $WIDTH_t1, $WIDTH_t2, $WIDTH_t3, $WIDTH_t4, $WIDTH_t5, $WIDTH_t6, $WIDTH_t7)\",\n      \"HEIGHT\": \"max($HEIGHT_t0, $HEIGHT_t1, $HEIGHT_t2, $HEIGHT_t3, $HEIGHT_t4, $HEIGHT_t5, $HEIGHT_t6, $HEIGHT_t7)\",\n      \"DEPTH\": \"max($DEPTH_t0, $DEPTH_t1, $DEPTH_t2, $DEPTH_t3, $DEPTH_t4, $DEPTH_t5, $DEPTH_t6, $DEPTH_t7)\"\n    }\n  ],\n  \"PASSES\": [\n    {\n      \"LOCAL_SIZE\": [\n        4,\n        4,\n        4\n      ],\n      \"EXECUTION_MODEL\": {\n        \"TYPE\": \"3D_IMAGE\",\n        \"TARGET\": \"volOut\"\n      }\n    }\n  ]\n}*/\n\n// An unconnected slot is bound to the engine's 1x1x1 placeholder, whose\n// content is undefined: read it as empty.\nvec4 pick(sampler3D t, vec3 p)\n{\n    return all(equal(textureSize(t, 0), ivec3(1))) ? vec4(0.0) : texture(t, p);\n}\n\nvoid main()\n{\n    ivec3 pos = ivec3(gl_GlobalInvocationID.xyz);\n    ivec3 size = imageSize(volOut);\n    if(any(greaterThanEqual(pos, size))) return;\n    vec3 p = (vec3(pos) + 0.5) / vec3(size);\n    vec4 o;\n    switch(int(index))\n    {\n        case 0: o = pick(t0, p); break;\n        case 1: o = pick(t1, p); break;\n        case 2: o = pick(t2, p); break;\n        case 3: o = pick(t3, p); break;\n        case 4: o = pick(t4, p); break;\n        case 5: o = pick(t5, p); break;\n        case 6: o = pick(t6, p); break;\n        case 7: o = pick(t7, p); break;\n        default: o = vec4(0.0);\n    }\n    imageStore(volOut, pos, o);\n}\n","Root":"<LIBRARY>:packages/score-csf-testers/shaderlib/volume/10-compositing/10-08_volume_switcher8.cs","Inlets":[{"uuid":"5ac86198-2d03-4830-9e41-a6d529922d29","ObjectName":"Inlet","id":0,"Hidden":false,"Custom":"t0","Exposed":"t0","Format":0,"FormatSet":false,"Filter":2,"AddressMode":1,"MipmapMode":0},{"uuid":"5ac86198-2d03-4830-9e41-a6d529922d29","ObjectName":"Inlet","id":1,"Hidden":false,"Custom":"t1","Exposed":"t1","Format":0,"FormatSet":false,"Filter":2,"AddressMode":1,"MipmapMode":0},{"uuid":"5ac86198-2d03-4830-9e41-a6d529922d29","ObjectName":"Inlet","id":2,"Hidden":false,"Custom":"t2","Exposed":"t2","Format":0,"FormatSet":false,"Filter":2,"AddressMode":1,"MipmapMode":0},{"uuid":"5ac86198-2d03-4830-9e41-a6d529922d29","ObjectName":"Inlet","id":3,"Hidden":false,"Custom":"t3","Exposed":"t3","Format":0,"FormatSet":false,"Filter":2,"AddressMode":1,"MipmapMode":0},{"uuid":"5ac86198-2d03-4830-9e41-a6d529922d29","ObjectName":"Inlet","id":4,"Hidden":false,"Custom":"t4","Exposed":"t4","Format":0,"FormatSet":false,"Filter":2,"AddressMode":1,"MipmapMode":0},{"uuid":"5ac86198-2d03-4830-9e41-a6d529922d29","ObjectName":"Inlet","id":5,"Hidden":false,"Custom":"t5","Exposed":"t5","Format":0,"FormatSet":false,"Filter":2,"AddressMode":1,"MipmapMode":0},{"uuid":"5ac86198-2d03-4830-9e41-a6d529922d29","ObjectName":"Inlet","id":6,"Hidden":false,"Custom":"t6","Exposed":"t6","Format":0,"FormatSet":false,"Filter":2,"AddressMode":1,"MipmapMode":0},{"uuid":"5ac86198-2d03-4830-9e41-a6d529922d29","ObjectName":"Inlet","id":7,"Hidden":false,"Custom":"t7","Exposed":"t7","Format":0,"FormatSet":false,"Filter":2,"AddressMode":1,"MipmapMode":0},{"uuid":"485680cc-b8b9-4a01-acc7-3e8334bdc016","ObjectName":"Inlet","id":8,"Hidden":true,"Custom":"index","Exposed":"index","Value":{"Int":5},"Init":{"Int":0},"Domain":{"Int":{"Values":[0,1,2,3,4,5,6,7]}},"Values":[["0",{"Int":0}],["1",{"Int":1}],["2",{"Int":2}],["3",{"Int":3}],["4",{"Int":4}],["5",{"Int":5}],["6",{"Int":6}],["7",{"Int":7}]],"FolderPort":"","FileExtensions":""}],"Outlets":[{"uuid":"f1c71046-b754-49a5-8e66-d01374773dfc","ObjectName":"Outlet","id":0,"Hidden":false,"Custom":"volOut","Exposed":"volout"}]},{"uuid":"a5bbffe0-93d2-4e70-995c-cf46c2c43520","ObjectName":"CSF","id":42,"Metadata":{"ScriptingName":"01-01_perlin3d.1","Comment":"","Color":"Transparent1","Label":"","Touched":true},"Duration":14112000000,"Height":300.0,"StartOffset":0,"LoopDuration":22579200000,"Pos":[-651.25,-1420.0],"Size":[166.0,70.0],"Loops":false,"FoldMode":0,"Compute":"/*{\n  \"DESCRIPTION\": \"3D Perlin gradient noise (Perlin 2002, Improving Noise: 12 cube-edge gradients, quintic fade) written into a volume. Classic smooth organic look; foundation for clouds / terrain / turbulence. Scale stretches the frequency.\",\n  \"CREDIT\": \"ossia 3D catalog. K. Perlin, Improving Noise, SIGGRAPH 2002.\",\n  \"ISFVSN\": \"2.0\",\n  \"MODE\": \"COMPUTE_SHADER\",\n  \"CATEGORIES\": [\n    \"3D-GENERATOR\",\n    \"NOISE\"\n  ],\n  \"INPUTS\": [\n    {\n      \"NAME\": \"scale\",\n      \"TYPE\": \"float\",\n      \"DEFAULT\": 4.0,\n      \"MIN\": 0.5,\n      \"MAX\": 32.0,\n      \"LABEL\": \"Scale\"\n    },\n    {\n      \"NAME\": \"timeScroll\",\n      \"TYPE\": \"float\",\n      \"DEFAULT\": 0.2,\n      \"MIN\": 0.0,\n      \"MAX\": 2.0,\n      \"LABEL\": \"Time scroll\"\n    }\n  ],\n  \"RESOURCES\": [\n    {\n      \"NAME\": \"volume\",\n      \"TYPE\": \"image\",\n      \"ACCESS\": \"write_only\",\n      \"WIDTH\": \"64\",\n      \"HEIGHT\": \"64\",\n      \"DEPTH\": \"64\"\n    }\n  ],\n  \"PASSES\": [\n    {\n      \"LOCAL_SIZE\": [\n        4,\n        4,\n        4\n      ],\n      \"EXECUTION_MODEL\": {\n        \"TYPE\": \"3D_IMAGE\",\n        \"TARGET\": \"volume\"\n      }\n    }\n  ]\n}*/\n\n// --- Hashing & random ----------------------------------------------------\nfloat hash11(float n){ return fract(sin(n)*43758.5453123); }\nfloat hash13(vec3 p){\n    p = fract(p * 0.3183099 + 0.1);\n    p *= 17.0;\n    return fract(p.x*p.y*p.z*(p.x+p.y+p.z));\n}\nvec3 hash33(vec3 p){\n    p = vec3(dot(p,vec3(127.1,311.7, 74.7)),\n             dot(p,vec3(269.5,183.3,246.1)),\n             dot(p,vec3(113.5,271.9,124.6)));\n    return fract(sin(p) * 43758.5453123);\n}\n\n// Perlin gradient noise (Perlin 2002, \"Improving Noise\"): a pseudo-random\n// gradient per lattice corner, chosen among the 12 cube-edge directions, dotted\n// with the offset to that corner, blended with the quintic fade\n// 6t^5 - 15t^4 + 10t^3. Zero at every lattice point, unlike value noise\n// (01-03), which interpolates random values and shows the lattice.\nvec3 grad12(vec3 corner){\n    float h = floor(hash13(corner) * 12.0);\n    // The 12 edge midpoints of a cube: (+-1,+-1,0), (+-1,0,+-1), (0,+-1,+-1).\n    float s1 = (mod(h, 2.0) < 1.0) ? 1.0 : -1.0;\n    float s2 = (mod(floor(h * 0.5), 2.0) < 1.0) ? 1.0 : -1.0;\n    if(h < 4.0) return vec3(s1, s2, 0.0);\n    if(h < 8.0) return vec3(s1, 0.0, s2);\n    return vec3(0.0, s1, s2);\n}\nfloat perlin(vec3 P){\n    vec3 Pi = floor(P);\n    vec3 Pf = fract(P);\n    vec3 w  = Pf*Pf*Pf*(Pf*(Pf*6.0-15.0)+10.0); // quintic fade\n    float n000 = dot(grad12(Pi+vec3(0,0,0)), Pf-vec3(0,0,0));\n    float n100 = dot(grad12(Pi+vec3(1,0,0)), Pf-vec3(1,0,0));\n    float n010 = dot(grad12(Pi+vec3(0,1,0)), Pf-vec3(0,1,0));\n    float n110 = dot(grad12(Pi+vec3(1,1,0)), Pf-vec3(1,1,0));\n    float n001 = dot(grad12(Pi+vec3(0,0,1)), Pf-vec3(0,0,1));\n    float n101 = dot(grad12(Pi+vec3(1,0,1)), Pf-vec3(1,0,1));\n    float n011 = dot(grad12(Pi+vec3(0,1,1)), Pf-vec3(0,1,1));\n    float n111 = dot(grad12(Pi+vec3(1,1,1)), Pf-vec3(1,1,1));\n    float nx00 = mix(n000, n100, w.x);\n    float nx10 = mix(n010, n110, w.x);\n    float nx01 = mix(n001, n101, w.x);\n    float nx11 = mix(n011, n111, w.x);\n    float nxy0 = mix(nx00, nx10, w.y);\n    float nxy1 = mix(nx01, nx11, w.y);\n    return mix(nxy0, nxy1, w.z);   // roughly [-1, 1]\n}\n\nvoid main()\n{\n    ivec3 pos = ivec3(gl_GlobalInvocationID.xyz);\n    ivec3 size = imageSize(volume);\n    if(any(greaterThanEqual(pos, size))) return;\n    vec3 p  = (vec3(pos) + 0.5) / vec3(size);   // [0,1]^3\n    vec3 pc = p * 2.0 - 1.0;                     // [-1,1]^3\n\n    float n = perlin(pc * scale + vec3(TIME*timeScroll));\n    n = n * 0.5 + 0.5;\n    imageStore(volume, pos, vec4(vec3(n), 1.0));\n\n}\n","Root":"<LIBRARY>:packages/score-csf-testers/shaderlib/volume/01-noise/01-01_perlin3d.cs","Inlets":[{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":0,"Hidden":true,"Custom":"scale","Exposed":"scale","Value":{"Float":4.699999809265137},"Init":{"Float":4.0},"Domain":{"Float":{"Min":0.5,"Max":32.0}}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":1,"Hidden":true,"Custom":"timeScroll","Exposed":"timescroll","Value":{"Float":2.0},"Init":{"Float":0.20000000298023224},"Domain":{"Float":{"Min":0.0,"Max":2.0}}}],"Outlets":[{"uuid":"f1c71046-b754-49a5-8e66-d01374773dfc","ObjectName":"Outlet","id":0,"Hidden":false,"Custom":"volume","Exposed":"volume"}]},{"uuid":"a5bbffe0-93d2-4e70-995c-cf46c2c43520","ObjectName":"CSF","id":43,"Metadata":{"ScriptingName":"01-15_curl_noise.1","Comment":"","Color":"Transparent1","Label":"","Touched":true},"Duration":14112000000,"Height":300.0,"StartOffset":0,"LoopDuration":22579200000,"Pos":[-659.25,-1534.0],"Size":[179.0,70.0],"Loops":false,"FoldMode":2,"Compute":"/*{\n  \"DESCRIPTION\": \"3D curl noise (Bridson et al. 2007): the curl of a vector potential made of three decorrelated simplex fields. Stored signed in RGBA16F (RGB = velocity, not clamped to [0,1]; alpha 1): the three components make an incompressible (divergence-free) flow volume. Sample this from warp/advection filters for fluid-like deformation.\",\n  \"CREDIT\": \"ossia 3D catalog\",\n  \"ISFVSN\": \"2.0\",\n  \"MODE\": \"COMPUTE_SHADER\",\n  \"CATEGORIES\": [\n    \"3D-GENERATOR\",\n    \"NOISE\"\n  ],\n  \"INPUTS\": [\n    {\n      \"NAME\": \"scale\",\n      \"TYPE\": \"float\",\n      \"DEFAULT\": 2.0,\n      \"MIN\": 0.5,\n      \"MAX\": 8.0,\n      \"LABEL\": \"Scale\"\n    },\n    {\n      \"NAME\": \"drift\",\n      \"TYPE\": \"float\",\n      \"DEFAULT\": 0.1,\n      \"MIN\": 0.0,\n      \"MAX\": 2.0,\n      \"LABEL\": \"Drift\"\n    }\n  ],\n  \"RESOURCES\": [\n    {\n      \"NAME\": \"volume\",\n      \"TYPE\": \"image\",\n      \"ACCESS\": \"write_only\",\n      \"FORMAT\": \"RGBA16F\",\n      \"WIDTH\": \"64\",\n      \"HEIGHT\": \"64\",\n      \"DEPTH\": \"64\"\n    }\n  ],\n  \"PASSES\": [\n    {\n      \"LOCAL_SIZE\": [\n        4,\n        4,\n        4\n      ],\n      \"EXECUTION_MODEL\": {\n        \"TYPE\": \"3D_IMAGE\",\n        \"TARGET\": \"volume\"\n      }\n    }\n  ]\n}*/\n\n// Simplex 3D noise (Ashima Arts, ISC-licensed, widely used)\nvec4 mod289(vec4 x){return x-floor(x*(1.0/289.0))*289.0;}\nvec3 mod289(vec3 x){return x-floor(x*(1.0/289.0))*289.0;}\nvec4 permute(vec4 x){return mod289(((x*34.0)+1.0)*x);}\nvec4 taylorInvSqrt(vec4 r){return 1.79284291400159-0.85373472095314*r;}\nfloat snoise(vec3 v){\n    const vec2 C = vec2(1.0/6.0, 1.0/3.0);\n    const vec4 D = vec4(0.0, 0.5, 1.0, 2.0);\n    vec3 i  = floor(v + dot(v, C.yyy));\n    vec3 x0 = v - i + dot(i, C.xxx);\n    vec3 g = step(x0.yzx, x0.xyz);\n    vec3 l = 1.0 - g;\n    vec3 i1 = min(g.xyz, l.zxy);\n    vec3 i2 = max(g.xyz, l.zxy);\n    vec3 x1 = x0 - i1 + C.xxx;\n    vec3 x2 = x0 - i2 + C.yyy;\n    vec3 x3 = x0 - D.yyy;\n    i = mod289(i);\n    vec4 p = permute(permute(permute(\n         i.z + vec4(0.0, i1.z, i2.z, 1.0))\n       + i.y + vec4(0.0, i1.y, i2.y, 1.0))\n       + i.x + vec4(0.0, i1.x, i2.x, 1.0));\n    float n_ = 0.142857142857;\n    vec3 ns = n_ * D.wyz - D.xzx;\n    vec4 j = p - 49.0 * floor(p * ns.z * ns.z);\n    vec4 x_ = floor(j * ns.z);\n    vec4 y_ = floor(j - 7.0 * x_);\n    vec4 x = x_ *ns.x + ns.yyyy;\n    vec4 y = y_ *ns.x + ns.yyyy;\n    vec4 h = 1.0 - abs(x) - abs(y);\n    vec4 b0 = vec4(x.xy, y.xy);\n    vec4 b1 = vec4(x.zw, y.zw);\n    vec4 s0 = floor(b0)*2.0 + 1.0;\n    vec4 s1 = floor(b1)*2.0 + 1.0;\n    vec4 sh = -step(h, vec4(0.0));\n    vec4 a0 = b0.xzyw + s0.xzyw*sh.xxyy;\n    vec4 a1 = b1.xzyw + s1.xzyw*sh.zzww;\n    vec3 p0 = vec3(a0.xy, h.x);\n    vec3 p1 = vec3(a0.zw, h.y);\n    vec3 p2 = vec3(a1.xy, h.z);\n    vec3 p3 = vec3(a1.zw, h.w);\n    vec4 norm = taylorInvSqrt(vec4(dot(p0,p0),dot(p1,p1),dot(p2,p2),dot(p3,p3)));\n    p0 *= norm.x; p1 *= norm.y; p2 *= norm.z; p3 *= norm.w;\n    vec4 m = max(0.6 - vec4(dot(x0,x0),dot(x1,x1),dot(x2,x2),dot(x3,x3)), 0.0);\n    m = m * m;\n    return 42.0 * dot(m*m, vec4(dot(p0,x0),dot(p1,x1),dot(p2,x2),dot(p3,x3)));\n}\n\n// 3D vector potential from three decorrelated simplex noises\nvec3 pot(vec3 p){\n    return vec3(snoise(p + vec3(31.416,0,0)),\n                snoise(p + vec3(0,31.416,0)),\n                snoise(p + vec3(0,0,31.416)));\n}\nvec3 curl3(vec3 p){\n    const float e = 0.01;\n    vec3 dx = vec3(e,0,0), dy = vec3(0,e,0), dz = vec3(0,0,e);\n    vec3 px1 = pot(p+dx), px0 = pot(p-dx);\n    vec3 py1 = pot(p+dy), py0 = pot(p-dy);\n    vec3 pz1 = pot(p+dz), pz0 = pot(p-dz);\n    // curl F = (dFz/dy - dFy/dz, dFx/dz - dFz/dx, dFy/dx - dFx/dy)\n    float cx = (py1.z - py0.z) - (pz1.y - pz0.y);\n    float cy = (pz1.x - pz0.x) - (px1.z - px0.z);\n    float cz = (px1.y - px0.y) - (py1.x - py0.x);\n    return vec3(cx, cy, cz) / (2.0*e);\n}\n\nvoid main()\n{\n    ivec3 pos = ivec3(gl_GlobalInvocationID.xyz);\n    ivec3 size = imageSize(volume);\n    if(any(greaterThanEqual(pos, size))) return;\n    vec3 p  = (vec3(pos) + 0.5) / vec3(size);   // [0,1]^3\n    vec3 pc = p * 2.0 - 1.0;                     // [-1,1]^3\n\n    vec3 v = curl3(pc * scale + vec3(TIME*drift));\n    // Encode signed flow into RGB16F (values may exceed [0,1])\n    imageStore(volume, pos, vec4(v, 1.0));\n\n}\n","Root":"<LIBRARY>:packages/score-csf-testers/shaderlib/volume/01-noise/01-15_curl_noise.cs","Inlets":[{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":0,"Hidden":true,"Custom":"scale","Exposed":"scale","Address":"analysis:/rms_smooth","Value":{"Float":0.5},"Init":{"Float":2.0},"Domain":{"Float":{"Min":0.5,"Max":8.0}}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":1,"Hidden":true,"Custom":"drift","Exposed":"drift","Value":{"Float":0.0},"Init":{"Float":0.10000000149011612},"Domain":{"Float":{"Min":0.0,"Max":2.0}}}],"Outlets":[{"uuid":"f1c71046-b754-49a5-8e66-d01374773dfc","ObjectName":"Outlet","id":0,"Hidden":false,"Custom":"volume","Exposed":"volume"}]},{"uuid":"a5bbffe0-93d2-4e70-995c-cf46c2c43520","ObjectName":"CSF","id":44,"Metadata":{"ScriptingName":"01-22_simplex_looping.1","Comment":"","Color":"Transparent1","Label":"","Touched":true},"Duration":14112000000,"Height":300.0,"StartOffset":0,"LoopDuration":22579200000,"Pos":[-684.25,-1288.0],"Size":[217.0,70.0],"Loops":false,"FoldMode":0,"Compute":"/*{\n  \"DESCRIPTION\": \"Seamlessly looping animated volume: two 3D simplex samples whose offsets travel around two circles in orthogonal planes of noise space, so the field returns exactly to its start every Period seconds. A looping alternative to a 4D noise slice at a lower cost.\",\n  \"CREDIT\": \"ossia 3D catalog\",\n  \"ISFVSN\": \"2.0\",\n  \"MODE\": \"COMPUTE_SHADER\",\n  \"CATEGORIES\": [\n    \"3D-GENERATOR\",\n    \"NOISE\"\n  ],\n  \"INPUTS\": [\n    {\n      \"NAME\": \"scale\",\n      \"TYPE\": \"float\",\n      \"DEFAULT\": 3.0,\n      \"MIN\": 0.5,\n      \"MAX\": 16.0,\n      \"LABEL\": \"Scale\"\n    },\n    {\n      \"NAME\": \"period\",\n      \"TYPE\": \"float\",\n      \"DEFAULT\": 4.0,\n      \"MIN\": 0.5,\n      \"MAX\": 60.0,\n      \"LABEL\": \"Loop period (s)\"\n    }\n  ],\n  \"RESOURCES\": [\n    {\n      \"NAME\": \"volume\",\n      \"TYPE\": \"image\",\n      \"ACCESS\": \"write_only\",\n      \"WIDTH\": \"64\",\n      \"HEIGHT\": \"64\",\n      \"DEPTH\": \"64\"\n    }\n  ],\n  \"PASSES\": [\n    {\n      \"LOCAL_SIZE\": [\n        4,\n        4,\n        4\n      ],\n      \"EXECUTION_MODEL\": {\n        \"TYPE\": \"3D_IMAGE\",\n        \"TARGET\": \"volume\"\n      }\n    }\n  ]\n}*/\n\n// Simplex 3D noise (Ashima Arts, ISC-licensed, widely used)\nvec4 mod289(vec4 x){return x-floor(x*(1.0/289.0))*289.0;}\nvec3 mod289(vec3 x){return x-floor(x*(1.0/289.0))*289.0;}\nvec4 permute(vec4 x){return mod289(((x*34.0)+1.0)*x);}\nvec4 taylorInvSqrt(vec4 r){return 1.79284291400159-0.85373472095314*r;}\nfloat snoise(vec3 v){\n    const vec2 C = vec2(1.0/6.0, 1.0/3.0);\n    const vec4 D = vec4(0.0, 0.5, 1.0, 2.0);\n    vec3 i  = floor(v + dot(v, C.yyy));\n    vec3 x0 = v - i + dot(i, C.xxx);\n    vec3 g = step(x0.yzx, x0.xyz);\n    vec3 l = 1.0 - g;\n    vec3 i1 = min(g.xyz, l.zxy);\n    vec3 i2 = max(g.xyz, l.zxy);\n    vec3 x1 = x0 - i1 + C.xxx;\n    vec3 x2 = x0 - i2 + C.yyy;\n    vec3 x3 = x0 - D.yyy;\n    i = mod289(i);\n    vec4 p = permute(permute(permute(\n         i.z + vec4(0.0, i1.z, i2.z, 1.0))\n       + i.y + vec4(0.0, i1.y, i2.y, 1.0))\n       + i.x + vec4(0.0, i1.x, i2.x, 1.0));\n    float n_ = 0.142857142857;\n    vec3 ns = n_ * D.wyz - D.xzx;\n    vec4 j = p - 49.0 * floor(p * ns.z * ns.z);\n    vec4 x_ = floor(j * ns.z);\n    vec4 y_ = floor(j - 7.0 * x_);\n    vec4 x = x_ *ns.x + ns.yyyy;\n    vec4 y = y_ *ns.x + ns.yyyy;\n    vec4 h = 1.0 - abs(x) - abs(y);\n    vec4 b0 = vec4(x.xy, y.xy);\n    vec4 b1 = vec4(x.zw, y.zw);\n    vec4 s0 = floor(b0)*2.0 + 1.0;\n    vec4 s1 = floor(b1)*2.0 + 1.0;\n    vec4 sh = -step(h, vec4(0.0));\n    vec4 a0 = b0.xzyw + s0.xzyw*sh.xxyy;\n    vec4 a1 = b1.xzyw + s1.xzyw*sh.zzww;\n    vec3 p0 = vec3(a0.xy, h.x);\n    vec3 p1 = vec3(a0.zw, h.y);\n    vec3 p2 = vec3(a1.xy, h.z);\n    vec3 p3 = vec3(a1.zw, h.w);\n    vec4 norm = taylorInvSqrt(vec4(dot(p0,p0),dot(p1,p1),dot(p2,p2),dot(p3,p3)));\n    p0 *= norm.x; p1 *= norm.y; p2 *= norm.z; p3 *= norm.w;\n    vec4 m = max(0.6 - vec4(dot(x0,x0),dot(x1,x1),dot(x2,x2),dot(x3,x3)), 0.0);\n    m = m * m;\n    return 42.0 * dot(m*m, vec4(dot(p0,x0),dot(p1,x1),dot(p2,x2),dot(p3,x3)));\n}\n\nvoid main()\n{\n    ivec3 pos = ivec3(gl_GlobalInvocationID.xyz);\n    ivec3 size = imageSize(volume);\n    if(any(greaterThanEqual(pos, size))) return;\n    vec3 p  = (vec3(pos) + 0.5) / vec3(size);   // [0,1]^3\n    vec3 pc = p * 2.0 - 1.0;                     // [-1,1]^3\n\n    float phase = 6.28318530718 * TIME / max(period, 0.01);\n    // Use 3D simplex at two decorrelated phased samples and blend\n    vec3 q = pc * scale;\n    float a = snoise(q + vec3(cos(phase), sin(phase), 0.0) * 1.7);\n    // A circle in an orthogonal plane, far away in noise space. (Sampling the\n    // same circle half a turn later made the sum repeat every period / 2.)\n    float b = snoise(q + vec3(0.0, cos(phase), sin(phase)) * 1.7 + vec3(41.3, 17.1, 5.9));\n    float v = 0.5*(a+b) * 0.5 + 0.5;\n    imageStore(volume, pos, vec4(vec3(v), 1.0));\n\n}\n","Root":"<LIBRARY>:packages/score-csf-testers/shaderlib/volume/01-noise/01-22_simplex_looping.cs","Inlets":[{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":0,"Hidden":true,"Custom":"scale","Exposed":"scale","Value":{"Float":1.7916666269302368},"Init":{"Float":3.0},"Domain":{"Float":{"Min":0.5,"Max":16.0}}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":1,"Hidden":true,"Custom":"period","Exposed":"period","Value":{"Float":38.18333435058594},"Init":{"Float":4.0},"Domain":{"Float":{"Min":0.5,"Max":60.0}}}],"Outlets":[{"uuid":"f1c71046-b754-49a5-8e66-d01374773dfc","ObjectName":"Outlet","id":0,"Hidden":false,"Custom":"volume","Exposed":"volume"}]},{"uuid":"a5bbffe0-93d2-4e70-995c-cf46c2c43520","ObjectName":"CSF","id":45,"Metadata":{"ScriptingName":"02-09_lidinoid.1","Comment":"","Color":"Transparent1","Label":"","Touched":true},"Duration":14112000000,"Height":300.0,"StartOffset":0,"LoopDuration":22579200000,"Pos":[-684.25,-1031.5],"Size":[162.0,70.0],"Loops":false,"FoldMode":2,"Compute":"/*{\n  \"DESCRIPTION\": \"Lidinoid TPMS: swirly curved channels.\",\n  \"CREDIT\": \"ossia 3D catalog\",\n  \"ISFVSN\": \"2.0\",\n  \"MODE\": \"COMPUTE_SHADER\",\n  \"CATEGORIES\": [\n    \"3D-GENERATOR\",\n    \"STRUCTURED\"\n  ],\n  \"INPUTS\": [\n    {\n      \"NAME\": \"scale\",\n      \"TYPE\": \"float\",\n      \"DEFAULT\": 4.0,\n      \"MIN\": 1.0,\n      \"MAX\": 16.0,\n      \"LABEL\": \"Scale\"\n    },\n    {\n      \"NAME\": \"thickness\",\n      \"TYPE\": \"float\",\n      \"DEFAULT\": 0.35,\n      \"MIN\": 0.0,\n      \"MAX\": 2.0,\n      \"LABEL\": \"Thickness\"\n    }\n  ],\n  \"RESOURCES\": [\n    {\n      \"NAME\": \"volume\",\n      \"TYPE\": \"image\",\n      \"ACCESS\": \"write_only\",\n      \"WIDTH\": \"64\",\n      \"HEIGHT\": \"64\",\n      \"DEPTH\": \"64\"\n    }\n  ],\n  \"PASSES\": [\n    {\n      \"LOCAL_SIZE\": [\n        4,\n        4,\n        4\n      ],\n      \"EXECUTION_MODEL\": {\n        \"TYPE\": \"3D_IMAGE\",\n        \"TARGET\": \"volume\"\n      }\n    }\n  ]\n}*/\n\nvoid main()\n{\n    ivec3 pos = ivec3(gl_GlobalInvocationID.xyz);\n    ivec3 size = imageSize(volume);\n    if(any(greaterThanEqual(pos, size))) return;\n    vec3 p  = (vec3(pos) + 0.5) / vec3(size);   // [0,1]^3\n    vec3 pc = p * 2.0 - 1.0;                     // [-1,1]^3\n\n    vec3 q = pc * scale;\n    float g = 0.5*(sin(2.0*q.x)*cos(q.y)*sin(q.z)\n                 + sin(2.0*q.y)*cos(q.z)*sin(q.x)\n                 + sin(2.0*q.z)*cos(q.x)*sin(q.y))\n            - 0.5*(cos(2.0*q.x)*cos(2.0*q.y)\n                 + cos(2.0*q.y)*cos(2.0*q.z)\n                 + cos(2.0*q.z)*cos(2.0*q.x))\n            + 0.15;\n    float shell = 1.0 - smoothstep(thickness*0.5, thickness, abs(g));\n    imageStore(volume, pos, vec4(vec3(shell), 1.0));\n\n}\n","Root":"<LIBRARY>:packages/score-csf-testers/shaderlib/volume/02-structured/02-09_lidinoid.cs","Inlets":[{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":0,"Hidden":true,"Custom":"scale","Exposed":"scale","Value":{"Float":4.0},"Init":{"Float":4.0},"Domain":{"Float":{"Min":1.0,"Max":16.0}}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":1,"Hidden":true,"Custom":"thickness","Exposed":"thickness","Value":{"Float":0.3499999940395355},"Init":{"Float":0.3499999940395355},"Domain":{"Float":{"Min":0.0,"Max":2.0}}}],"Outlets":[{"uuid":"f1c71046-b754-49a5-8e66-d01374773dfc","ObjectName":"Outlet","id":0,"Hidden":false,"Custom":"volume","Exposed":"volume"}]},{"uuid":"a5bbffe0-93d2-4e70-995c-cf46c2c43520","ObjectName":"CSF","id":46,"Metadata":{"ScriptingName":"02-07_neovius.1","Comment":"","Color":"Transparent1","Label":"","Touched":true},"Duration":14112000000,"Height":300.0,"StartOffset":0,"LoopDuration":22579200000,"Pos":[-676.25,-1150.5],"Size":[163.0,70.0],"Loops":false,"FoldMode":2,"Compute":"/*{\n  \"DESCRIPTION\": \"Neovius TPMS: 3(cos(x)+cos(y)+cos(z)) + 4 cos(x)cos(y)cos(z). Denser than Schwarz-P, more complex.\",\n  \"CREDIT\": \"ossia 3D catalog\",\n  \"ISFVSN\": \"2.0\",\n  \"MODE\": \"COMPUTE_SHADER\",\n  \"CATEGORIES\": [\n    \"3D-GENERATOR\",\n    \"STRUCTURED\"\n  ],\n  \"INPUTS\": [\n    {\n      \"NAME\": \"scale\",\n      \"TYPE\": \"float\",\n      \"DEFAULT\": 5.0,\n      \"MIN\": 1.0,\n      \"MAX\": 16.0,\n      \"LABEL\": \"Scale\"\n    },\n    {\n      \"NAME\": \"thickness\",\n      \"TYPE\": \"float\",\n      \"DEFAULT\": 1.2,\n      \"MIN\": 0.0,\n      \"MAX\": 4.0,\n      \"LABEL\": \"Thickness\"\n    }\n  ],\n  \"RESOURCES\": [\n    {\n      \"NAME\": \"volume\",\n      \"TYPE\": \"image\",\n      \"ACCESS\": \"write_only\",\n      \"WIDTH\": \"64\",\n      \"HEIGHT\": \"64\",\n      \"DEPTH\": \"64\"\n    }\n  ],\n  \"PASSES\": [\n    {\n      \"LOCAL_SIZE\": [\n        4,\n        4,\n        4\n      ],\n      \"EXECUTION_MODEL\": {\n        \"TYPE\": \"3D_IMAGE\",\n        \"TARGET\": \"volume\"\n      }\n    }\n  ]\n}*/\n\nvoid main()\n{\n    ivec3 pos = ivec3(gl_GlobalInvocationID.xyz);\n    ivec3 size = imageSize(volume);\n    if(any(greaterThanEqual(pos, size))) return;\n    vec3 p  = (vec3(pos) + 0.5) / vec3(size);   // [0,1]^3\n    vec3 pc = p * 2.0 - 1.0;                     // [-1,1]^3\n\n    vec3 q = pc * scale;\n    float g = 3.0*(cos(q.x)+cos(q.y)+cos(q.z)) + 4.0*cos(q.x)*cos(q.y)*cos(q.z);\n    float shell = 1.0 - smoothstep(thickness*0.5, thickness, abs(g));\n    imageStore(volume, pos, vec4(vec3(shell), 1.0));\n\n}\n","Root":"<LIBRARY>:packages/score-csf-testers/shaderlib/volume/02-structured/02-07_neovius.cs","Inlets":[{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":0,"Hidden":true,"Custom":"scale","Exposed":"scale","Value":{"Float":5.0},"Init":{"Float":5.0},"Domain":{"Float":{"Min":1.0,"Max":16.0}}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":1,"Hidden":true,"Custom":"thickness","Exposed":"thickness","Value":{"Float":0.5333333611488342},"Init":{"Float":1.2000000476837158},"Domain":{"Float":{"Min":0.0,"Max":4.0}}}],"Outlets":[{"uuid":"f1c71046-b754-49a5-8e66-d01374773dfc","ObjectName":"Outlet","id":0,"Hidden":false,"Custom":"volume","Exposed":"volume"}]},{"uuid":"25c64b87-a44a-4fed-9f60-0a48906fd3ec","ObjectName":"MicroMapping","id":47,"Metadata":{"ScriptingName":"Micromap.21","Comment":"","Color":"Transparent1","Label":"","Touched":true},"Duration":14112000000,"Height":300.0,"StartOffset":0,"LoopDuration":22579200000,"Pos":[-896.25,-1150.5],"Size":[180.0,35.0],"Loops":false,"FoldMode":0,"Inlets":[{"uuid":"769dd38a-bfb3-4dc6-b52a-b6abb7afe2a3","ObjectName":"Inlet","id":0,"Hidden":false,"Custom":"in","Exposed":"in","Address":"analysis:/rms_smooth"},{"uuid":"9ae797ea-d94c-4792-acec-9ec1932bae5d","ObjectName":"Inlet","id":1,"Hidden":true,"Custom":"Expression","Exposed":"expression","Value":{"String":"70x"},"Init":{"String":"x / 127"},"Domain":{}}],"Outlets":[{"uuid":"cff96158-cc72-46d7-99dc-b6038171375b","ObjectName":"Outlet","id":0,"Hidden":false,"Custom":"out","Exposed":"out"}]},{"uuid":"a5bbffe0-93d2-4e70-995c-cf46c2c43520","ObjectName":"CSF","id":48,"Metadata":{"ScriptingName":"08-02_curl_warp.1","Comment":"","Color":"Transparent1","Label":"","Touched":true},"Duration":14112000000,"Height":300.0,"StartOffset":0,"LoopDuration":22579200000,"Pos":[-492.25,-1031.5],"Size":[175.0,125.0],"Loops":false,"FoldMode":0,"Compute":"/*{\n  \"DESCRIPTION\": \"Fluid-looking domain warp by curl of a noise potential. Incompressible: the volume swirls without being squashed or stretched. The output is rgba16f, so signed and HDR inputs (01-15 curl noise, the simulations, 07-06 Laplacian...) pass through without clipping.\",\n  \"CREDIT\": \"ossia 3D catalog\",\n  \"ISFVSN\": \"2.0\",\n  \"MODE\": \"COMPUTE_SHADER\",\n  \"CATEGORIES\": [\n    \"3D-FILTER\",\n    \"WARP\"\n  ],\n  \"INPUTS\": [\n    {\n      \"NAME\": \"volIn\",\n      \"TYPE\": \"texture\",\n      \"DIMENSIONS\": 3,\n      \"LABEL\": \"Input volume\"\n    },\n    {\n      \"NAME\": \"amount\",\n      \"TYPE\": \"float\",\n      \"DEFAULT\": 0.1,\n      \"MIN\": 0.0,\n      \"MAX\": 0.5,\n      \"LABEL\": \"Warp amount\"\n    },\n    {\n      \"NAME\": \"scale\",\n      \"TYPE\": \"float\",\n      \"DEFAULT\": 2.0,\n      \"MIN\": 0.5,\n      \"MAX\": 8.0,\n      \"LABEL\": \"Scale\"\n    },\n    {\n      \"NAME\": \"drift\",\n      \"TYPE\": \"float\",\n      \"DEFAULT\": 0.1,\n      \"MIN\": 0.0,\n      \"MAX\": 2.0,\n      \"LABEL\": \"Drift\"\n    }\n  ],\n  \"RESOURCES\": [\n    {\n      \"NAME\": \"volOut\",\n      \"TYPE\": \"image\",\n      \"ACCESS\": \"write_only\",\n      \"FORMAT\": \"rgba16f\",\n      \"WIDTH\": \"$WIDTH_volIn\",\n      \"HEIGHT\": \"$HEIGHT_volIn\",\n      \"DEPTH\": \"$DEPTH_volIn\"\n    }\n  ],\n  \"PASSES\": [\n    {\n      \"LOCAL_SIZE\": [\n        4,\n        4,\n        4\n      ],\n      \"EXECUTION_MODEL\": {\n        \"TYPE\": \"3D_IMAGE\",\n        \"TARGET\": \"volOut\"\n      }\n    }\n  ]\n}*/\n\n// Simplex 3D noise (Ashima Arts, ISC-licensed, widely used)\nvec4 mod289(vec4 x){return x-floor(x*(1.0/289.0))*289.0;}\nvec3 mod289(vec3 x){return x-floor(x*(1.0/289.0))*289.0;}\nvec4 permute(vec4 x){return mod289(((x*34.0)+1.0)*x);}\nvec4 taylorInvSqrt(vec4 r){return 1.79284291400159-0.85373472095314*r;}\nfloat snoise(vec3 v){\n    const vec2 C = vec2(1.0/6.0, 1.0/3.0);\n    const vec4 D = vec4(0.0, 0.5, 1.0, 2.0);\n    vec3 i  = floor(v + dot(v, C.yyy));\n    vec3 x0 = v - i + dot(i, C.xxx);\n    vec3 g = step(x0.yzx, x0.xyz);\n    vec3 l = 1.0 - g;\n    vec3 i1 = min(g.xyz, l.zxy);\n    vec3 i2 = max(g.xyz, l.zxy);\n    vec3 x1 = x0 - i1 + C.xxx;\n    vec3 x2 = x0 - i2 + C.yyy;\n    vec3 x3 = x0 - D.yyy;\n    i = mod289(i);\n    vec4 p = permute(permute(permute(\n         i.z + vec4(0.0, i1.z, i2.z, 1.0))\n       + i.y + vec4(0.0, i1.y, i2.y, 1.0))\n       + i.x + vec4(0.0, i1.x, i2.x, 1.0));\n    float n_ = 0.142857142857;\n    vec3 ns = n_ * D.wyz - D.xzx;\n    vec4 j = p - 49.0 * floor(p * ns.z * ns.z);\n    vec4 x_ = floor(j * ns.z);\n    vec4 y_ = floor(j - 7.0 * x_);\n    vec4 x = x_ *ns.x + ns.yyyy;\n    vec4 y = y_ *ns.x + ns.yyyy;\n    vec4 h = 1.0 - abs(x) - abs(y);\n    vec4 b0 = vec4(x.xy, y.xy);\n    vec4 b1 = vec4(x.zw, y.zw);\n    vec4 s0 = floor(b0)*2.0 + 1.0;\n    vec4 s1 = floor(b1)*2.0 + 1.0;\n    vec4 sh = -step(h, vec4(0.0));\n    vec4 a0 = b0.xzyw + s0.xzyw*sh.xxyy;\n    vec4 a1 = b1.xzyw + s1.xzyw*sh.zzww;\n    vec3 p0 = vec3(a0.xy, h.x);\n    vec3 p1 = vec3(a0.zw, h.y);\n    vec3 p2 = vec3(a1.xy, h.z);\n    vec3 p3 = vec3(a1.zw, h.w);\n    vec4 norm = taylorInvSqrt(vec4(dot(p0,p0),dot(p1,p1),dot(p2,p2),dot(p3,p3)));\n    p0 *= norm.x; p1 *= norm.y; p2 *= norm.z; p3 *= norm.w;\n    vec4 m = max(0.6 - vec4(dot(x0,x0),dot(x1,x1),dot(x2,x2),dot(x3,x3)), 0.0);\n    m = m * m;\n    return 42.0 * dot(m*m, vec4(dot(p0,x0),dot(p1,x1),dot(p2,x2),dot(p3,x3)));\n}\n\nvec3 pot(vec3 p){\n    return vec3(snoise(p+vec3(31.4,0,0)),\n                snoise(p+vec3(0,31.4,0)),\n                snoise(p+vec3(0,0,31.4)));\n}\nvec3 curl3(vec3 p){\n    const float e = 0.01;\n    vec3 dx=vec3(e,0,0), dy=vec3(0,e,0), dz=vec3(0,0,e);\n    vec3 px1=pot(p+dx), px0=pot(p-dx);\n    vec3 py1=pot(p+dy), py0=pot(p-dy);\n    vec3 pz1=pot(p+dz), pz0=pot(p-dz);\n    return vec3((py1.z-py0.z)-(pz1.y-pz0.y),\n                (pz1.x-pz0.x)-(px1.z-px0.z),\n                (px1.y-px0.y)-(py1.x-py0.x)) / (2.0*e);\n}\n\nvoid main()\n{\n    ivec3 pos = ivec3(gl_GlobalInvocationID.xyz);\n    ivec3 size = imageSize(volOut);\n    if(any(greaterThanEqual(pos, size))) return;\n    vec3 p  = (vec3(pos) + 0.5) / vec3(size);\n    vec3 pc = p * 2.0 - 1.0;\n\n    vec3 off = curl3(pc*scale + vec3(TIME*drift)) * amount;\n    vec4 s = texture(volIn, p + off);\n    imageStore(volOut, pos, s);\n\n}\n","Root":"<LIBRARY>:packages/score-csf-testers/shaderlib/volume/08-warp/08-02_curl_warp.cs","Inlets":[{"uuid":"5ac86198-2d03-4830-9e41-a6d529922d29","ObjectName":"Inlet","id":0,"Hidden":false,"Custom":"volIn","Exposed":"volin","Format":0,"FormatSet":false,"Filter":2,"AddressMode":1,"MipmapMode":0},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":1,"Hidden":true,"Custom":"amount","Exposed":"amount","Address":"analysis:/rms_smooth","Value":{"Float":0.0},"Init":{"Float":0.10000000149011612},"Domain":{"Float":{"Min":0.0,"Max":0.5}}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":2,"Hidden":true,"Custom":"scale","Exposed":"scale","Value":{"Float":1.375},"Init":{"Float":2.0},"Domain":{"Float":{"Min":0.5,"Max":8.0}}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":3,"Hidden":true,"Custom":"drift","Exposed":"drift","Value":{"Float":0.10000000149011612},"Init":{"Float":0.10000000149011612},"Domain":{"Float":{"Min":0.0,"Max":2.0}}}],"Outlets":[{"uuid":"f1c71046-b754-49a5-8e66-d01374773dfc","ObjectName":"Outlet","id":0,"Hidden":false,"Custom":"volOut","Exposed":"volout"}]},{"uuid":"0b1b1816-c33e-4796-a16d-5aab27fe600f","ObjectName":"LFO","id":49,"Metadata":{"ScriptingName":"LFO.2","Comment":"","Color":"Transparent1","Label":"","Touched":true},"Duration":14112000000,"Height":300.0,"StartOffset":0,"LoopDuration":22579200000,"Pos":[-678.25,-1827.5],"Size":[261.0,117.5],"Loops":false,"FoldMode":0,"Inlets":[{"uuid":"b631d9b7-cbe3-4d9c-b470-f139e348aecb","ObjectName":"Inlet","id":0,"Hidden":true,"Custom":"Period","Exposed":"period","Value":{"Vec2f":[0.5,1.0]},"Init":{"Vec2f":[0.5,1.0]},"Domain":{"Vec2f":{"Min":[0.009999999776482582,0.0],"Max":[60.0,1.0],"Values":[[],[]]}}},{"uuid":"82427d27-084a-4ab6-9c4e-db83929a1200","ObjectName":"Inlet","id":1,"Hidden":true,"Custom":"Shape","Exposed":"shape","Value":{"Float":0.5},"Init":{"Float":0.5},"Domain":{"Float":{"Min":0.0,"Max":1.0}}},{"uuid":"7cd210d3-ebd1-4f71-9de6-cccfb639cbc3","ObjectName":"Inlet","id":2,"Hidden":true,"Custom":"Retrigger","Exposed":"retrigger","Value":{"Impulse":null},"Init":{"Impulse":null},"Domain":{"Impulse":null}},{"uuid":"82427d27-084a-4ab6-9c4e-db83929a1200","ObjectName":"Inlet","id":3,"Hidden":true,"Custom":"Ampl.","Exposed":"ampl.","Value":{"Float":0.5},"Init":{"Float":0.5},"Domain":{"Float":{"Min":0.0,"Max":2.0}}},{"uuid":"82427d27-084a-4ab6-9c4e-db83929a1200","ObjectName":"Inlet","id":4,"Hidden":true,"Custom":"Offset","Exposed":"offset","Value":{"Float":0.5},"Init":{"Float":0.5},"Domain":{"Float":{"Min":-1.0,"Max":1.0}}},{"uuid":"82427d27-084a-4ab6-9c4e-db83929a1200","ObjectName":"Inlet","id":5,"Hidden":true,"Custom":"Jitter","Exposed":"jitter","Value":{"Float":0.0},"Init":{"Float":0.0},"Domain":{"Float":{"Min":0.0,"Max":180.0}}},{"uuid":"82427d27-084a-4ab6-9c4e-db83929a1200","ObjectName":"Inlet","id":6,"Hidden":true,"Custom":"Phase","Exposed":"phase","Value":{"Float":0.0},"Init":{"Float":0.0},"Domain":{"Float":{"Min":0.0,"Max":360.0}}},{"uuid":"8b1d76c4-3838-4ac0-9b9c-c12bc5db8e8a","ObjectName":"Inlet","id":7,"Hidden":true,"Custom":"Waveform","Exposed":"waveform","Value":{"String":"SampleAndHoldEveryTick"},"Init":{"String":"Sin"},"Domain":{"String":{"Values":["Sin","Triangle","Saw","RampDown","Square","SquareOnChange","SampleAndHoldEveryTick","SampleAndHold","Noise1","Noise2","Noise3","Drift"]}},"Values":["Sin","Triangle","Saw","RampDown","Square","SquareOnChange","SampleAndHoldEveryTick","SampleAndHold","Noise1","Noise2","Noise3","Drift"],"Pixmaps":[":/icons/wave_sin_off.png",":/icons/wave_sin_on.png",":/icons/wave_triangle_off.png",":/icons/wave_triangle_on.png",":/icons/wave_saw_off.png",":/icons/wave_saw_on.png",":/icons/wave_ramp_down_off.png",":/icons/wave_ramp_down_on.png",":/icons/wave_square_ticks_off.png",":/icons/wave_square_ticks_on.png",":/icons/wave_square_changes_off.png",":/icons/wave_square_changes_on.png",":/icons/wave_sample_and_hold_ticks_off.png",":/icons/wave_sample_and_hold_ticks_on.png",":/icons/wave_sample_and_hold_changes_off.png",":/icons/wave_sample_and_hold_changes_on.png",":/icons/wave_noise1_off.png",":/icons/wave_noise1_on.png",":/icons/wave_noise2_off.png",":/icons/wave_noise2_on.png",":/icons/wave_noise3_off.png",":/icons/wave_noise3_on.png",":/icons/wave_drift_off.png",":/icons/wave_drift_on.png"]},{"uuid":"fb27e4cb-ea7f-41e2-ad92-2354498c1b6b","ObjectName":"Inlet","id":8,"Hidden":true,"Custom":"Lock to bars","Exposed":"lock to bars","Value":{"Bool":false},"Init":{"Bool":false},"Domain":{"Bool":null}}],"Outlets":[{"uuid":"cff96158-cc72-46d7-99dc-b6038171375b","ObjectName":"Outlet","id":0,"Hidden":false,"Custom":"Out","Exposed":"out"}]},{"uuid":"25c64b87-a44a-4fed-9f60-0a48906fd3ec","ObjectName":"MicroMapping","id":50,"Metadata":{"ScriptingName":"Micromap.22","Comment":"","Color":"Transparent1","Label":"","Touched":true},"Duration":14112000000,"Height":300.0,"StartOffset":0,"LoopDuration":22579200000,"Pos":[-283.25,-1827.5],"Size":[180.0,35.0],"Loops":false,"FoldMode":0,"Inlets":[{"uuid":"769dd38a-bfb3-4dc6-b52a-b6abb7afe2a3","ObjectName":"Inlet","id":0,"Hidden":false,"Custom":"in","Exposed":"in"},{"uuid":"9ae797ea-d94c-4792-acec-9ec1932bae5d","ObjectName":"Inlet","id":1,"Hidden":true,"Custom":"Expression","Exposed":"expression","Value":{"String":"round(5x)"},"Init":{"String":"x / 127"},"Domain":{}}],"Outlets":[{"uuid":"cff96158-cc72-46d7-99dc-b6038171375b","ObjectName":"Outlet","id":0,"Hidden":false,"Custom":"out","Exposed":"out"}]},{"uuid":"a5bbffe0-93d2-4e70-995c-cf46c2c43520","ObjectName":"CSF","id":54,"Metadata":{"ScriptingName":"10-06_crossfade","Comment":"","Color":"Transparent1","Label":"","Touched":true},"Duration":14112000000,"Height":300.0,"StartOffset":0,"LoopDuration":22579200000,"Pos":[354.5089769588803,-805.4057419317573],"Size":[164.0,75.0],"Loops":false,"FoldMode":2,"Compute":"/*{\n  \"DESCRIPTION\": \"Time / parameter crossfade between two 3D volumes: mix(A, B, t). The output is rgba16f, so signed and HDR inputs (01-15 curl noise, the simulations, 07-06 Laplacian...) pass through without clipping.\",\n  \"CREDIT\": \"ossia 3D catalog\",\n  \"ISFVSN\": \"2.0\",\n  \"MODE\": \"COMPUTE_SHADER\",\n  \"CATEGORIES\": [\n    \"3D-FILTER\",\n    \"COMPOSITE\"\n  ],\n  \"INPUTS\": [\n    {\n      \"NAME\": \"A\",\n      \"TYPE\": \"texture\",\n      \"DIMENSIONS\": 3,\n      \"LABEL\": \"A\"\n    },\n    {\n      \"NAME\": \"B\",\n      \"TYPE\": \"texture\",\n      \"DIMENSIONS\": 3,\n      \"LABEL\": \"B\"\n    },\n    {\n      \"NAME\": \"t\",\n      \"TYPE\": \"float\",\n      \"DEFAULT\": 0.5,\n      \"MIN\": 0.0,\n      \"MAX\": 1.0,\n      \"LABEL\": \"t\"\n    }\n  ],\n  \"RESOURCES\": [\n    {\n      \"NAME\": \"volOut\",\n      \"TYPE\": \"image\",\n      \"ACCESS\": \"write_only\",\n      \"FORMAT\": \"rgba16f\",\n      \"WIDTH\": \"$WIDTH_A\",\n      \"HEIGHT\": \"$HEIGHT_A\",\n      \"DEPTH\": \"$DEPTH_A\"\n    }\n  ],\n  \"PASSES\": [\n    {\n      \"LOCAL_SIZE\": [\n        4,\n        4,\n        4\n      ],\n      \"EXECUTION_MODEL\": {\n        \"TYPE\": \"3D_IMAGE\",\n        \"TARGET\": \"volOut\"\n      }\n    }\n  ]\n}*/\n\nvoid main()\n{\n    ivec3 pos = ivec3(gl_GlobalInvocationID.xyz);\n    ivec3 size = imageSize(volOut);\n    if(any(greaterThanEqual(pos, size))) return;\n    vec3 p = (vec3(pos)+0.5)/vec3(size);\n    imageStore(volOut, pos, mix(texture(A, p), texture(B, p), t));\n}\n","Root":"<LIBRARY>:packages/score-csf-testers/shaderlib/volume/10-compositing/10-06_crossfade.cs","Inlets":[{"uuid":"5ac86198-2d03-4830-9e41-a6d529922d29","ObjectName":"Inlet","id":0,"Hidden":false,"Custom":"A","Exposed":"a","Format":0,"FormatSet":false,"Filter":2,"AddressMode":1,"MipmapMode":0},{"uuid":"5ac86198-2d03-4830-9e41-a6d529922d29","ObjectName":"Inlet","id":1,"Hidden":false,"Custom":"B","Exposed":"b","Format":0,"FormatSet":false,"Filter":2,"AddressMode":1,"MipmapMode":0},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":2,"Hidden":true,"Custom":"t","Exposed":"t","Value":{"Float":0.8004646301269531},"Init":{"Float":0.5},"Domain":{"Float":{"Min":0.0,"Max":1.0}}}],"Outlets":[{"uuid":"f1c71046-b754-49a5-8e66-d01374773dfc","ObjectName":"Outlet","id":0,"Hidden":false,"Custom":"volOut","Exposed":"volout"}]},{"uuid":"0b1b1816-c33e-4796-a16d-5aab27fe600f","ObjectName":"LFO","id":55,"Metadata":{"ScriptingName":"LFO.56","Comment":"","Color":"Transparent1","Label":"","Touched":true},"Duration":14112000000,"Height":300.0,"StartOffset":0,"LoopDuration":22579200000,"Pos":[-537.8980073706551,-836.5127077850087],"Size":[261.0,117.5],"Loops":false,"FoldMode":0,"Inlets":[{"uuid":"b631d9b7-cbe3-4d9c-b470-f139e348aecb","ObjectName":"Inlet","id":0,"Hidden":true,"Custom":