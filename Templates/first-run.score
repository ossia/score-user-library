},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":12,"Hidden":true,"Custom":"Shadow normal bias","Exposed":"shadow normal bias","Value":{"Float":0.009999999776482582},"Init":{"Float":0.009999999776482582},"Domain":{"Float":{"Min":0.0,"Max":0.10000000149011612}}},{"uuid":"377e8205-b442-4d54-8832-3761def522b2","ObjectName":"Inlet","id":13,"Hidden":true,"Custom":"Position","Exposed":"position","Value":{"Vec3f":[-9.957716941833496,3.393113613128662,-0.8036383390426636]},"Init":{"Vec3f":[0.0,0.0,0.0]},"Domain":{"Vec3f":{"Min":[-8388608.0,-8388608.0,-8388608.0],"Max":[8388608.0,8388608.0,8388608.0],"Values":[[],[],[]]}}},{"uuid":"377e8205-b442-4d54-8832-3761def522b2","ObjectName":"Inlet","id":14,"Hidden":true,"Custom":"Rotation","Exposed":"rotation","Value":{"Vec3f":[0.0,0.0,0.0]},"Init":{"Vec3f":[0.0,0.0,0.0]},"Domain":{"Vec3f":{"Min":[0.0,0.0,0.0],"Max":[360.0,360.0,360.0],"Values":[[],[],[]]}}}],"Outlets":[{"uuid":"848061c5-e8a0-4a13-9985-e8df30ce6d4f","ObjectName":"Outlet","id":0,"Hidden":false,"Custom":"Scene","Exposed":"scene"}]},{"uuid":"d1e8c4b7-6a32-4f9e-b5d8-2c4f3a1e8b6d","ObjectName":"camera_switch","id":13,"Metadata":{"ScriptingName":"Camera Switch","Comment":"","Color":"Transparent1","Label":"","Touched":true},"Duration":11289600000,"Height":300.0,"StartOffset":0,"LoopDuration":11289600000,"Pos":[-906.9154034126644,-440.8983123615934],"Size":[280.0,111.0],"Loops":false,"FoldMode":0,"Inlets":[{"uuid":"f2ab26ea-415d-45a2-bfbc-2968c7c92a33","ObjectName":"Inlet","id":0,"Hidden":false,"Custom":"Camera 0","Exposed":"camera 0"},{"uuid":"f2ab26ea-415d-45a2-bfbc-2968c7c92a33","ObjectName":"Inlet","id":1,"Hidden":false,"Custom":"Camera 1","Exposed":"camera 1"},{"uuid":"f2ab26ea-415d-45a2-bfbc-2968c7c92a33","ObjectName":"Inlet","id":2,"Hidden":false,"Custom":"Camera 2","Exposed":"camera 2"},{"uuid":"f2ab26ea-415d-45a2-bfbc-2968c7c92a33","ObjectName":"Inlet","id":3,"Hidden":false,"Custom":"Camera 3","Exposed":"camera 3"},{"uuid":"8b1d76c4-3838-4a