2,0.000009999999747378752],"Max":[1000.0,1000.0,1000.0],"Values":[[],[],[]]}}},{"uuid":"485680cc-b8b9-4a01-acc7-3e8334bdc016","ObjectName":"Inlet","id":10,"Hidden":true,"Custom":"Per-instance transform","Exposed":"per-instance transform","Value":{"Int":0},"Init":{"Int":0},"Domain":{"Int":{"Values":[0,1]}},"Values":[["Full matrix",{"Int":0}],["Translation only",{"Int":1}]],"FolderPort":"","FileExtensions":""}],"Outlets":[{"uuid":"848061c5-e8a0-4a13-9985-e8df30ce6d4f","ObjectName":"Outlet","id":0,"Hidden":false,"Custom":"Scene Out","Exposed":"scene out"}]},{"uuid":"a5bbffe0-93d2-4e70-995c-cf46c2c43520","ObjectName":"CSF","id":50,"Metadata":{"ScriptingName":"GridPoints","Comment":"","Color":"Transparent1","Label":"","Touched":true},"Duration":11289600000,"Height":300.0,"StartOffset":0,"LoopDuration":11289600000,"Pos":[-1963.8424158862556,990.2820098926884],"Size":[435.0,176.0],"Loops":false,"FoldMode":0,"Compute":"/*{\n\"DESCRIPTION\": \"Scatters count points randomly inside a box, a solid ellipsoid, or on an ellipsoid surface, with a random rotation (quaternion) and scale per point. Reproducible for a given seed; existing points keep their position, rotation and scale when count changes. Colour is the normalised position within the bounds; texcoord is an independent per-point random vec4.\",\n\"CREDIT\": \"ossia score\",\n\"ISFVSN\": \"2.0\",\n\"MODE\": \"COMPUTE_SHADER\",\n\"CATEGORIES\": [\"Geometry Generator\"],\n\"RESOURCES\": [\n{\n\"NAME\": \"geo\",\n\"TYPE\": \"geometry\",\n\"VERTEX_COUNT\": \"$count\",\n\"ATTRIBUTES\": [\n{ \"NAME\": \"position\", \"SEMANTIC\": \"position\", \"TYPE\": \"vec4\", \"ACCESS\": \"write_only\", \"RATE\": \"vertex\" },\n{ \"NAME\": \"rotation\", \"SEMANTIC\": \"rotation\", \"TYPE\": \"vec4\", \"ACCESS\": \"write_only\", \"RATE\": \"vertex\" },\n{ \"NAME\": \"scale\", \"SEMANTIC\": \"scale\", \"TYPE\": \"vec4\", \"ACCESS\": \"write_only\", \"RATE\": \"vertex\" },\n{ \"NAME\": \"color\", \"SEMANTIC\": \"color\", \"TYPE\": \"vec4\", \"ACCESS\": \"write_only\", \"RATE\": \"vertex\" },\n{ \"NAME\": \"texcoord\", \"SEMANTIC\": \"texcoord\", \"TYPE\": \"vec4\", \"ACCESS\": \"write_only\", \"RATE\": \"vertex\" }\n]\n},\n{ \"NAME\": \"count\", \"TYPE\": \"long\", \"DEFAULT\": 1024, \"MIN\": 0, \"MAX\": 1000000 },\n{ \"NAME\": \"seed\", \"TYPE\": \"long\", \"DEFAULT\": 0, \"MIN\": 0, \"MAX\": 65535 },\n{ \"NAME\": \"shape\", \"TYPE\": \"long\", \"DEFAULT\": 0, \"VALUES\": [0, 1, 2], \"LABELS\": [\"Box\", \"Ellipsoid (volume)\", \"Ellipsoid (surface)\"] },\n{ \"NAME\": \"size\", \"TYPE\": \"point3D\", \"DEFAULT\": [2, 2, 2], \"MIN\": [0, 0, 0], \"MAX\": [20, 20, 20] },\n{ \"NAME\": \"center\", \"TYPE\": \"point3D\", \"DEFAULT\": [0, 0, 0], \"MIN\": [-10, -10, -10], \"MAX\": [10, 10, 10] },\n{ \"NAME\": \"rotationMode\", \"TYPE\": \"long\", \"DEFAULT\": 0, \"VALUES\": [0, 1], \"LABELS\": [\"Free\", \"Around axis\"] },\n{ \"NAME\": \"rotationAxis\", \"TYPE\": \"point3D\", \"DEFAULT\": [0, 1, 0], \"MIN\": [-1, -1, -1], \"MAX\": [1, 1, 1] },\n{ \"NAME\": \"rotationSpread\", \"TYPE\": \"float\", \"DEFAULT\": 1.0, \"MIN\": 0.0, \"MAX\": 1.0 },\n{ \"NAME\": \"scaleMode\", \"TYPE\": \"long\", \"DEFAULT\": 0, \"VALUES\": [0, 1], \"LABELS\": [\"Uniform\", \"Per axis\"] },\n{ \"NAME\": \"scaleMin\", \"TYPE\": \"float\", \"DEFAULT\": 0.5, \"MIN\": 0.0, \"MAX\": 10.0 },\n{ \"NAME\": \"scaleMax\", \"TYPE\": \"float\", \"DEFAULT\": 1.5, \"MIN\": 0.0, \"MAX\": 10.0 }\n],\n\"PASSES\": [\n{ \"LOCAL_SIZE\": [64, 1, 1], \"EXECUTION_MODEL\": { \"TYPE\": \"PER_VERTEX\" } }\n]\n}*/\n\nuvec3 pcg3d(uvec3 v)\n{\n  v = v * 1664525u + 1013904223u;\n  v.x += v.y * v.z; v.y += v.z * v.x; v.z += v.x * v.y;\n  v ^= v >> 16u;\n  v.x += v.y * v.z; v.y += v.z * v.x; v.z += v.x * v.y;\n  return v;\n}\n\nvec3 rand3(uint idx, uint s, uint stream)\n{\n  uvec3 h = pcg3d(uvec3(idx, s, stream));\n  return vec3(h >> 8u) * (1.0 / 16777216.0);\n}\n\nconst float TAU = 6.28318530718;\n\nvoid main()\n{\n  uint idx = gl_GlobalInvocationID.x;\n  uint n = uint(ISF_WRITE(geo, position).length());\n  if(idx >= n)\n    return;\n\n  uint s = uint(seed);\n\n  // ---- Position (stream 0, unchanged from the plain scatter) ----\n  vec3 r = rand3(idx, s, 0u);\n  vec3 p;\n  if(shape == 0)\n  {\n    p = r * 2.0 - 1.0;\n  }\n  else\n  {\n    float cosT = r.x * 2.0 - 1.0;\n    float sinT = sqrt(max(0.0, 1.0 - cosT * cosT));\n    float phi = r.y * TAU;\n    vec3 dir = vec3(sinT * cos(phi), sinT * sin(phi), cosT);\n    float radius = (shape == 1) ? pow(r.z, 1.0 / 3.0) : 1.0;\n    p = dir * radius;\n  }\n  vec3 pos = p * size * 0.5 + center;\n\n  // ---- Rotation (stream 3), quaternion stored as (x, y, z, w) ----\n  vec3 rr = rand3(idx, s, 3u);\n  vec4 q;\n  if(rotationMode == 0)\n  {\n    // Shoemake: uniformly distributed over SO(3)\n    float a = sqrt(1.0 - rr.x);\n    float b = sqrt(rr.x);\n    q = vec4(a * sin(TAU * rr.y), a * cos(TAU * rr.y),\n             b * sin(TAU * rr.z), b * cos(TAU * rr.z));\n    if(q.w < 0.0)\n      q = -q; // shortest path from identity for the spread blend\n    // spread = 0 -> identity, 1 -> fully uniform\n    q = normalize(mix(vec4(0.0, 0.0, 0.0, 1.0), q, rotationSpread));\n  }\n  else\n  {\n    vec3 axis = rotationAxis;\n    float len = length(axis);\n    axis = len > 1e-6 ? axis / len : vec3(0.0, 1.0, 0.0);\n    // Angle in [-spread*pi, spread*pi]; spread = 1 covers the full turn\n    float angle = (rr.x * 2.0 - 1.0) * rotationSpread * 3.14159265359;\n    q = vec4(axis * sin(angle * 0.5), cos(angle * 0.5));\n  }\n\n  // ---- Scale (stream 4) ----\n  vec3 rs = rand3(idx, s, 4u);\n  vec3 scl = (scaleMode == 0)\n      ? vec3(mix(scaleMin, scaleMax, rs.x))\n      : mix(vec3(scaleMin), vec3(scaleMax), rs);\n\n  // ---- Extra streams ----\n  vec3 r2 = rand3(idx, s, 1u);\n  float r3 = rand3(idx, s, 2u).x;\n\n  ISF_WRITE(geo, position)[idx] = vec4(pos, 1.0);\n  ISF_WRITE(geo, rotation)[idx] = q;\n  ISF_WRITE(geo, scale)[idx] = vec4(scl, 1.0);\n  ISF_WRITE(geo, color)[idx] = vec4(p * 0.5 + 0.5, 1.0);\n  