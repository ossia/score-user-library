:"x","Value":{"Float":1.0},"Init":{"Float":1.0},"Domain":{"Float":{"Min":-8388608.0,"Max":8388608.0}}},{"uuid":"10d62b0d-5bc9-4ac9-9540-9e8ac0c24947","ObjectName":"Inlet","id":1,"Hidden":true,"Custom":"Y","Exposed":"y","Value":{"Float":1.0},"Init":{"Float":1.0},"Domain":{"Float":{"Min":-8388608.0,"Max":8388608.0}}},{"uuid":"10d62b0d-5bc9-4ac9-9540-9e8ac0c24947","ObjectName":"Inlet","id":2,"Hidden":true,"Custom":"Z","Exposed":"z","Value":{"Float":1.0},"Init":{"Float":1.0},"Domain":{"Float":{"Min":-8388608.0,"Max":8388608.0}}}],"Outlets":[{"uuid":"cff96158-cc72-46d7-99dc-b6038171375b","ObjectName":"Outlet","id":0,"Hidden":false,"Custom":"Pair","Exposed":"pair"}]},{"uuid":"25c64b87-a44a-4fed-9f60-0a48906fd3ec","ObjectName":"MicroMapping","id":58,"Metadata":{"ScriptingName":"Micromap.56","Comment":"","Color":"Transparent1","Label":"","Touched":true},"Duration":11289600000,"Height":300.0,"StartOffset":0,"LoopDuration":11289600000,"Pos":[-2268.9707601707873,1370.2264313000924],"Size":[180.0,35.0],"Loops":false,"FoldMode":0,"Inlets":[{"uuid":"769dd38a-bfb3-4dc6-b52a-b6abb7afe2a3","ObjectName":"Inlet","id":0,"Hidden":false,"Custom":"in","Exposed":"in"},{"uuid":"9ae797ea-d94c-4792-acec-9ec1932bae5d","ObjectName":"Inlet","id":1,"Hidden":true,"Custom":"Expression","Exposed":"expression","Value":{"String":"50x"},"Init":{"String":"x / 127"},"Domain":{}}],"Outlets":[{"uuid":"cff96158-cc72-46d7-99dc-b6038171375b","ObjectName":"Outlet","id":0,"Hidden":false,"Custom":"out","Exposed":"out"}]},{"uuid":"a5bbffe0-93d2-4e70-995c-cf46c2c43520","ObjectName":"CSF","id":59,"Metadata":{"ScriptingName":"Compute Shader","Comment":"","Color":"Transparent1","Label":"","Touched":true},"Duration":11289600000,"Height":300.0,"StartOffset":0,"LoopDuration":11289600000,"Pos":[-1492.6704342403514,1016.6814808938312],"Size":[507.0,391.0],"Loops":false,"FoldMode":0,"Compute":"/*{\n  \"DESCRIPTION\": \"Colours geometry along a 2- or 3-stop gradient. The gradient coordinate comes from the vertex index, a seeded random value, the projection of the position on an axis (-range..+range around center), or the distance from center (0..range). Supports repeats, offset, wrap mode and per-vertex jitter, with optional OKLab interpolation. amount blends the gradient over the incoming colour, by replacing or multiplying it.\",\n  \"CREDIT\": \"ossia score\",\n  \"ISFVSN\": \"2.0\",\n  \"MODE\": \"COMPUTE_SHADER\",\n  \"CATEGORIES\": [\"Geometry Modifier\"],\n  \"RESOURCES\": [\n    {\n      \"NAME\": \"geo\",\n      \"TYPE\": \"geometry\",\n      \"ATTRIBUTES\": [\n        { \"NAME\": \"position\", \"SEMANTIC\": \"position\", \"TYPE\": \"vec4\", \"ACCESS\": \"read_only\" },\n        { \"NAME\": \"color\",    \"SEMANTIC\": \"color\",    \"TYPE\": \"vec4\", \"ACCESS\": \"read_write\" }\n      ]\n    },\n    { \"NAME\": \"stops\", \"TYPE\": \"long\", \"DEFAULT\": 3, \"VALUES\": [2, 3], \"LABELS\": [\"2 colours\", \"3 colours\"] },\n    { \"NAME\": \"colorA\", \"TYPE\": \"color\", \"DEFAULT\": [0.10, 0.20, 0.90, 1.0] },\n    { \"NAME\": \"colorB\", \"TYPE\": \"color\", \"DEFAULT\": [0.95, 0.30, 0.55, 1.0] },\n    { \"NAME\": \"colorC\", \"TYPE\": \"color\", \"DEFAULT\": [1.00, 0.85, 0.20, 1.0] },\n    { \"NAME\": \"source\", \"TYPE\": \"long\", \"DEFAULT\": 2, \"VALUES\": [0, 1, 2, 3], \"LABELS\": [\"Index\", \"Random\", \"Axis\", \"Radial\"] },\n    { \"NAME\": \"axis\", \"TYPE\": \"point3D\", \"DEFAULT\": [0, 1, 0], \"MIN\": [-1, -1, -1], \"MAX\": [1, 1, 1] },\n    { \"NAME\": \"center\", \"TYPE\": \"point3D\", \"DEFAULT\": [0, 0, 0], \"MIN\": [-10, -10, -10], \"MAX\": [10, 10, 10] },\n    { \"NAME\": \"range\", \"TYPE\": \"float\", \"DEFAULT\": 1.0, \"MIN\": 0.001, \"MAX\": 20.0 },\n    { \"NAME\": \"seed\", \"TYPE\": \"long\", \"DEFAULT\": 0, \"MIN\": 0, \"MAX\": 65535 },\n    { \"NAME\": \"repeats\", \"TYPE\": \"float\", \"DEFAULT\": 1.0, \"MIN\": 0.0, \"MAX\": 64.0 },\n    { \"NAME\": \"offset\", \"TYPE\": \"float\", \"DEFAULT\": 0.0, \"MIN\": -1.0, \"MAX\": 1.0 },\n    { \"NAME\": \"wrap\", \"TYPE\": \"long\", \"DEFAULT\": 0, \"VALUES\": [0, 1, 2], \"LABELS\": [\"Clamp\", \"Repeat\", \"Mirror\"] },\n    { \"NAME\": \"jitter\", \"TYPE\": \"float\", \"DEFAULT\": 0.0, \"MIN\": 0.0, \"MAX\": 1.0 },\n    { \"NAME\": \"space\", \"TYPE\": \"long\", \"DEFAULT\": 1, \"VALUES\": [0, 1], \"LABELS\": [\"RGB\", \"OKLab\"] },\n    { \"NAME\": \"blend\", \"TYPE\": \"long\", \"DEFAULT\": 0, \"VALUES\": [0, 1], \"LABELS\": [\"Replace\", \"Multiply\"] },\n    { \"NAME\": \"amount\", \"TYPE\": \"float\", \"DEFAULT\": 1.0, \"MIN\": 0.0, \"MAX\": 1.0 }\n  ],\n  \"PASSES\": [\n    { \"LOCAL_SIZE\": [64, 1, 1], \"EXECUTION_MODEL\": { \"TYPE\": \"PER_VERTEX\" } }\n  ]\n}*/\n\nuvec3 pcg3d(uvec3 v)\n{\n  v = v * 1664525u + 1013904223u;\n  v.x += v.y * v.z; v.y += v.z * v.x; v.z += v.x * v.y;\n  v ^= v >> 16u;\n  v.x += v.y * v.z; v.y += v.z * v.x; v.z += v.x * v.y;\n  return v;\n}\n\nvec3 rand3(uint idx, uint s, uint stream)\n{\n  uvec3 h = pcg3d(uvec3(idx, s, stream));\n  return vec3(h >> 8u) * (1.0 / 16777216.0);\n}\n\nvec3 toLinear(vec3 c)\n{\n  return mix(c / 12.92, pow((c + 0.055) / 1.055, vec3(2.4)), step(0.04045, c));\n}\nvec3 toSrgb(vec3 c)\n{\n  c = max(c, 0.0);\n  return mix(c * 12.92, 1.055 * pow(c, vec3(1.0 / 2.4)) - 0.055, step(0.0031308, c));\n}\n\nvec3 linearToOklab(vec3 c)\n{\n  float l = 0.4122214708 * c.r + 0.5363325363 * c.g + 0.0514459929 * c.b;\n  float m = 0.2119034982 * c.r + 0.6806995451 * c.g + 0.1073969566 * c.b;\n  float s = 0.0883024619 * c.r + 0.2817188376 * c.g + 0.6299787005 * c.b;\n  l = pow(max(l, 0.0), 1.0 / 3.0);\n  m = pow(max(m, 0.0), 1.0 / 3.0);\n  s = pow(max(s, 0.0), 1.0 / 3.0);\n  return vec3(\n      0.2104542553 * l + 0.7936177850 * m - 0.0040720468 * s,\n      1.9779984951 * l - 2.4285922050 * m + 0.4505937099 * s,\n      0.0259040371 * l + 0.7827717662 * m - 0.8086757660 * s);\n}\nvec3 oklabToLinear(vec3 c)\n{\n  float l = c.x + 0.3963377774 * c.y + 0.2158037573 * c.z;\n  float m = c.x - 0.1055613458 * c.y - 0.0638541728 * c.z;\n  float s = c.x - 0.0894841775 * c.y - 1.2914855480 * c.z;\n  l = l * l * l; m = m * m * m; s = s * s * s;\n  return vec3(\n       4.0767416621 * l - 3.3077115913 * m + 0.2309699292 * s,\n      -1.2684380046 * l + 2.6097574011 * m - 0.3413193965 * s,\n      -0.0041960863 * l - 0.7034186147 * m + 1.7076147010 * s);\n}\n\nvec4 mixColor(vec4 a, vec4 b, float t)\n{\n  float alpha = mix(a.a, b.a, t);\n  if(space == 0)\n    return vec4(mix(a.rgb, b.rgb, t), alpha);\n  vec3 la = linearToOklab(toLinear(a.rgb));\n  vec3 lb = linearToOklab(toLinear(b.rgb));\n  return vec4(toSrgb(clamp(oklabToLinear(mix(la, lb, t)), 0.0, 1.0)), alpha);\n}\n\nvoid main()\n{\n  uint idx = gl_GlobalInvocationID.x;\n  uint n = uint(ISF_READ(geo, position).length());\n  if(idx >= n)\n    return;\n\n  vec3 r = rand3(idx, uint(seed), 5u);\n\n  // Gradient coordinate\n  float t;\n  if(source == 0)\n  {\n    t = (n > 1u) ? float(idx) / float(n - 1u) : 0.0;\n  }\n  else if(source == 1)\n  {\n    t = r.x;\n  }\n  else\n  {\n    vec3 pos = ISF_READ(geo, position)[idx].xyz - center;\n    if(source == 2)\n    {\n      float len = length(axis);\n      vec3 dir = len > 1e-6 ? axis / len : vec3(0.0, 1.0, 0.0);\n      t = dot(pos, dir) / range * 0.5 + 0.5;\n    }\n    else\n    {\n      t = length(pos) / range;\n    }\n  }\n\n  t = t * repeats + offset + (r.y - 0.5) * jitter;\n\n  if(wrap == 0)\n    t = clamp(t, 0.0, 1.0);\n  else if(wrap == 1)\n    t = fract(t);\n  else\n    t = 1.0 - abs(fract(t * 0.5) * 2.0 - 1.0);\n\n  vec4 g;\n  if(stops == 2)\n    g = mixColor(colorA, colorC, t);\n  else\n    g = (t < 0.5) ? mixColor(colorA, colorB, t * 2.0)\n                  : mixColor(colorB, colorC, t * 2.0 - 1.0);\n\n  // Blend over the incoming colour\n  vec4 prev = ISF_READ(geo, color)[idx];\n  vec4 target = (blend == 0) ? g : prev * g;\n  ISF_WRITE(geo, color)[idx] = mix(prev, target, amount);\n}","Inlets":[{"uuid":"f2ab26ea-415d-45a2-bfbc-2968c7c92a33","ObjectName":"Inlet","id":0,"Hidden":false,"Custom":"geo","Exposed":"geo"},{"uuid":"485680cc-b8b9-4a01-acc7-3e8334bdc016","ObjectName":"Inlet","id":1,"Hidden":true,"Custom":"stops","Exposed":"stops","Value":{"Int":3},"Init":{"Int":3},"Domain":{"Int":{"Values":[2,3]}},"Values":[["2 colours",{"Int":2}],["3 colours",{"Int":3}]],"FolderPort":"","FileExtensions":""},{"uuid":"8f38638e-9f9f-48b0-ae36-1cba86ef5703","ObjectName":"Inlet","id":2,"Hidden":true,"Custom":"colorA","Exposed":"colora","Value":{"Vec4f":[0.9000076055526733,0.095704585313797,0.0,1.0]},"Init":{"Vec4f":[0.10000000149011612,0.20000000298023224,0.8999999761581421,1.0]},"Domain":{}},{"uuid":"8f38638e-9f9f-48b0-ae36-1cba86ef5703","ObjectName":"Inlet","id":3,"Hidden":true,"Custom":"colorB","Exposed":"colorb","Value":{"Vec4f":[0.20457769930362701,0.9499961733818054,0.025726711377501488,1.0]},"Init":{"Vec4f":[0.949999988079071,0.30000001192092896,0.550000011920929,1.0]},"Domain":{}},{"uuid":"8f38638e-9f9f-48b0-ae36-1cba86ef5703","ObjectName":"Inlet","id":4,"Hidden":true,"Custom":"colorC","Exposed":"colorc","Value":{"Vec4f":[1.0,0.06671244651079178,0.5092393159866333,1.0]},"Init":{"Vec4f":[1.0,0.8500000238418579,0.20000000298023224,1.0]},"Domain":{}},{"uuid":"485680cc-b8b9-4a01-acc7-3e8334bdc016","ObjectName":"Inlet","id":5,"Hidden":true,"Custom":"source","Exposed":"source","Value":{"Int":1},"Init":{"Int":2},"Domain":{"Int":{"Values":[0,1,2,3]}},"Values":[["Index",{"Int":0}],["Random",{"Int":1}],["Axis",{"Int":2}],["Radial",{"Int":3}]],"FolderPort":"","FileExtensions":""},{"uuid":"377e8205-b442-4d54-8832-3761def522b2","ObjectName":"Inlet","id":6,"Hidden":true,"Custom":"axis","Exposed":"axis","Value":{"Vec3f":[0.0,1.0,0.0]},"Init":{"Vec3f":[0.0,1.0,0.0]},"Domain":{"Vec3f":{"Min":[-1.0,-1.0,-1.0],"Max":[1.0,1.0,1.0],"Values":[[],[],[]]}}},{"uuid":"377e8205-b442-4d54-8832-3761def522b2","ObjectName":"Inlet","id":7,"Hidden":true,"Custom":"center","Exposed":"center","Value":{"Vec3f":[0.0,0.0,0.0]},"Init":{"Vec3f":[0.0,0.0,0.0]},"Domain":{"Vec3f":{"Min":[-10.0,-10.0,-1