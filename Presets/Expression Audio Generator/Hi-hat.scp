{"Key":{"Uuid":"eae294b3-afeb-4fba-bbe4-337998d3748a","Effect":""},"Name":"Hi-hat","Category":"Drums","Preset":[[0,{"String":"// a: tempo, b: decay, c: level.\nif(m2[0] == 0 and m3[0] == 0) { m2[0] := 1; };\nm2[0] += (0.4 + 8 a) / fs;\nif(m2[0] >= 1) { m2[0] := m2[0] - 1; m3[0] := 1; };\nm3[0] := m3[0] * (1 - (40 + 300 b) / fs);\nvar nz := random(-1, 1);\nm1[0] := m1[0] + 0.6 * (nz - m1[0]);\nvar s := 0.5 c * m3[0] * (nz - m1[0]);\nout[0] := s;\nout[1] := s;"}],[1,{"Float":0.2}],[2,{"Float":0.3}],[3,{"Float":0.8}]]}