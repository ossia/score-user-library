{"Key":{"Uuid":"eae294b3-afeb-4fba-bbe4-337998d3748a","Effect":""},"Name":"Snare","Category":"Drums","Preset":[[0,{"String":"// a: tempo, b: decay, c: level.\nif(m2[0] == 0 and m3[0] == 0) { m2[0] := 1; };\nm2[0] += (0.2 + 4 a) / fs;\nif(m2[0] >= 1) { m2[0] := m2[0] - 1; m3[0] := 1; };\nm3[0] := m3[0] * (1 - (10 + 60 b) / fs);\nm1[0] := frac(m1[0] + 180 / fs);\nvar s := 0.5 c * m3[0] * (1.4 random(-1, 1) + 0.6 sin(2 pi m1[0]));\nout[0] := s;\nout[1] := s;"}],[1,{"Float":0.15}],[2,{"Float":0.4}],[3,{"Float":0.8}]]}