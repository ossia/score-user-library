{"Key":{"Uuid":"eae294b3-afeb-4fba-bbe4-337998d3748a","Effect":""},"Name":"Pulse","Category":"Oscillators","Preset":[[0,{"String":"// a: pitch, b: level, c: pulse width.\nvar f := 20 + 2000 a;\nm1[0] := frac(m1[0] + f / fs);\nvar s := if(m1[0] < 0.02 + 0.96 c, b, -b);\nout[0] := s;\nout[1] := s;"}],[1,{"Float":0.1}],[2,{"Float":0.3}],[3,{"Float":0.5}]]}