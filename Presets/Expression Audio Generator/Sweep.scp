{"Key":{"Uuid":"eae294b3-afeb-4fba-bbe4-337998d3748a","Effect":""},"Name":"Sweep","Category":"Synthesis","Preset":[[0,{"String":"// Repeating exponential chirp. a: low, b: high, c: sweep rate.\nvar f0 := 40 + 200 a;\nvar f1 := 400 + 4000 b;\nm2[0] := frac(m2[0] + (0.05 + c) / fs);\nm1[0] := frac(m1[0] + f0 (f1 / f0) ^ m2[0] / fs);\nvar s := 0.3 sin(2 pi m1[0]);\nout[0] := s;\nout[1] := s;"}],[1,{"Float":0.2}],[2,{"Float":0.4}],[3,{"Float":0.2}]]}