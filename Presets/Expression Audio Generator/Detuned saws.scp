{"Key":{"Uuid":"eae294b3-afeb-4fba-bbe4-337998d3748a","Effect":""},"Name":"Detuned saws","Category":"Oscillators","Preset":[[0,{"String":"// b: detune amount.\nvar f := 40 + 400 a;\nm1[0] := frac(m1[0] + f / fs);\nm1[1] := frac(m1[1] + f (1 + 0.02 b) / fs);\nvar s := 0.2 ((2 m1[0] - 1) + (2 m1[1] - 1));\nout[0] := s;\nout[1] := s;"}],[1,{"Float":0.2}],[2,{"Float":0.4}],[3,{"Float":0.5}]]}