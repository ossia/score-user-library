{"Key":{"Uuid":"eae294b3-afeb-4fba-bbe4-337998d3748a","Effect":""},"Name":"FM pair","Category":"Synthesis","Preset":[[0,{"String":"// a: pitch, b: modulator ratio, c: modulation depth.\nvar fc := 40 + 800 a;\nvar ratio := 1 + round(7 b);\nm1[0] := frac(m1[0] + fc / fs);\nm1[1] := frac(m1[1] + fc ratio / fs);\nvar s := 0.4 sin(2 pi m1[0] + 8 c sin(2 pi m1[1]));\nout[0] := s;\nout[1] := s;"}],[1,{"Float":0.2}],[2,{"Float":0.15}],[3,{"Float":0.3}]]}