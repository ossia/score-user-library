{"Key":{"Uuid":"eae294b3-afeb-4fba-bbe4-337998d3748a","Effect":""},"Name":"Binaural beat","Category":"Oscillators","Preset":[[0,{"String":"// a: pitch, b: beat frequency between the two ears.\nvar f := 100 + 400 a;\nm1[0] := frac(m1[0] + f / fs);\nm1[1] := frac(m1[1] + (f + 0.5 + 20 b) / fs);\nout[0] := 0.3 sin(2 pi m1[0]);\nout[1] := 0.3 sin(2 pi m1[1]);"}],[1,{"Float":0.1}],[2,{"Float":0.3}],[3,{"Float":0.5}]]}