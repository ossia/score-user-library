{"Key":{"Uuid":"cf3df02f-a563-4e92-a739-b321d3a84252","Effect":""},"Name":"Chladni grid","Category":"Animation","Preset":[[0,{"String":"// Standing-wave figure sampled on a square grid: one amplitude per cell.\nvar side := max(1, ceil(sqrt(n)));\nvar d := max(1, side - 1);\nvar cx := (i % side) / d;\nvar cy := trunc(i / side) / d;\nvar M := 3;\nvar K := 5;\ncos(M pi cx) cos(K pi cy) - cos(K pi cx) cos(M pi cy)"}],[1,{"Int":256}]]}