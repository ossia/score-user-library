{"Key":{"Uuid":"cf3df02f-a563-4e92-a739-b321d3a84252","Effect":""},"Name":"Comet","Category":"Animation","Preset":[[0,{"String":"// Bright head, exponential tail, wraps around the strip.\nvar tsec := t / 705600000;\nvar u := i / max(1, n - 1);\nvar head := frac(0.4 tsec);\nexp(-8 frac(head - u))"}],[1,{"Int":60}]]}