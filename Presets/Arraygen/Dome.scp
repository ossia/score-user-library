{"Key":{"Uuid":"cf3df02f-a563-4e92-a739-b321d3a84252","Effect":""},"Name":"Dome","Category":"Spatial","Preset":[[0,{"String":"// Even coverage of the upper half-sphere.\nvar y := 1 - (i + 0.5) / n;\nvar r := sqrt(max(0, 1 - y y));\nvar a := i * 2.39996322972865332;\nreturn [r cos(a), y, r sin(a)]"}],[1,{"Int":16}]]}