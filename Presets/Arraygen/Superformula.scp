{"Key":{"Uuid":"cf3df02f-a563-4e92-a739-b321d3a84252","Effect":""},"Name":"Superformula","Category":"Shapes","Preset":[[0,{"String":"var a := 2 pi i / n;\nvar m := 7;\nvar e1 := 0.3;\nvar e2 := 1.7;\nvar base := max(0.000001, abs(cos(m a / 4)) ^ e2 + abs(sin(m a / 4)) ^ e2);\nvar r := base ^ (-1 / (3 e1));\nreturn [r cos(a), r sin(a)]"}],[1,{"Int":512}]]}