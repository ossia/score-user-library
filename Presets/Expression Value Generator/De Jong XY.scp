{"Key":{"Uuid":"d757bd0d-c0a1-4aec-bf72-945b722ab85b","Effect":""},"Name":"De Jong XY","Category":"Motion","Preset":[[0,{"String":"// Bounded strange attractor - a, b, c reshape it.\nvar A := -2 + 4 a;\nvar B := -2 + 4 b;\nvar C := -2 + 4 c;\nvar nx := sin(A m2) - cos(B m1);\nvar ny := sin(C m1) - cos(2 m2);\nm1 := nx;\nm2 := ny;\nreturn [0.5 m1, 0.5 m2]"}],[1,{"Float":0.15}],[2,{"Float":0.85}],[3,{"Float":0.3}]]}