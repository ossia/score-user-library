{"Key":{"Uuid":"d757bd0d-c0a1-4aec-bf72-945b722ab85b","Effect":""},"Name":"Hue sweep RGBA","Category":"Colour","Preset":[[0,{"String":"// a: how many times the hue goes round, b: starting hue.\nvar h := 6 frac(pos (0.5 + 4 a) + b);\nreturn [\n  clamp(0, abs(h - 3) - 1, 1),\n  clamp(0, 2 - abs(h - 2), 1),\n  clamp(0, 2 - abs(h - 4), 1),\n  1\n]"}],[1,{"Float":0.25}],[2,{"Float":0.0}],[3,{"Float":0.5}]]}