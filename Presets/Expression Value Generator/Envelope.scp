{"Key":{"Uuid":"d757bd0d-c0a1-4aec-bf72-945b722ab85b","Effect":""},"Name":"Envelope","Category":"Envelopes","Preset":[[0,{"String":"// Attack / sustain / release across the interval. a: attack, b: release, c: level.\nvar A := 0.02 + 0.3 a;\nvar R := 0.02 + 0.5 b;\nvar s := 0.2 + 0.7 c;\nvar up := clamp(0, pos / A, 1);\nvar down := clamp(0, (1 - pos) / R, 1);\ns min(up, down)"}],[1,{"Float":0.2}],[2,{"Float":0.2}],[3,{"Float":0.8}]]}