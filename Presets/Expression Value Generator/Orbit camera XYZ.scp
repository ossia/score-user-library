{"Key":{"Uuid":"d757bd0d-c0a1-4aec-bf72-945b722ab85b","Effect":""},"Name":"Orbit camera XYZ","Category":"Motion","Preset":[[0,{"String":"// Orbit camera around (0,0,0), Y up. a: speed, b: radius, c: elevation.\n// Phase is accumulated in m1 so that changing the speed does not jump.\nvar speed := 0.5 a;\nm1 := m1 + 2 pi speed dt / 705600000;\nm1 := m1 - 2 pi floor(m1 / (2 pi));\nvar r := 0.5 + 19.5 b;\nvar el := 0.45 pi (2 c - 1);\nreturn [r cos(el) cos(m1), r sin(el), r cos(el) sin(m1)]"}],[1,{"Float":0.2}],[2,{"Float":0.25}],[3,{"Float":0.6}]]}