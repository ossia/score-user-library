{"Key":{"Uuid":"d757bd0d-c0a1-4aec-bf72-945b722ab85b","Effect":""},"Name":"Square LFO","Category":"LFO","Preset":[[0,{"String":"// a: rate, b: pulse width.\nvar tsec := t / 705600000;\nvar ph := frac((0.05 + 5 a) tsec);\nif(ph < 0.02 + 0.96 b, 1, 0)"}],[1,{"Float":0.1}],[2,{"Float":0.5}],[3,{"Float":0.5}]]}