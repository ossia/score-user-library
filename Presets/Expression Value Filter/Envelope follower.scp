{"Key":{"Uuid":"ae84e8b6-74ff-4259-aeeb-305d95cdfcab","Effect":""},"Name":"Envelope follower","Category":"Dynamics","Preset":[[1,{"String":"// a: attack, b: release.\nvar at := 0.001 + a;\nvar rl := 0.001 + b;\nvar v := abs(x);\nm1 := m1 + if(v > m1, at, rl) * (v - m1)"}],[2,{"Float":0.5}],[3,{"Float":0.02}],[4,{"Float":0.5}]]}