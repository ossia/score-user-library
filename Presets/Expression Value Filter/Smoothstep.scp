{"Key":{"Uuid":"ae84e8b6-74ff-4259-aeeb-305d95cdfcab","Effect":""},"Name":"Smoothstep","Category":"Shaping","Preset":[[1,{"String":"// a and b are the two ends of the ramp.\nvar l := min(a, b);\nvar r := max(a, b);\nvar v := clamp(0, (x - l) / max(0.000001, r - l), 1);\nv v (3 - 2 v)"}],[2,{"Float":0.0}],[3,{"Float":1.0}],[4,{"Float":0.5}]]}