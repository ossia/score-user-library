{"Key":{"Uuid":"ae84e8b6-74ff-4259-aeeb-305d95cdfcab","Effect":""},"Name":"Damped spring","Category":"Smoothing","Preset":[[1,{"String":"// a: stiffness, b: damping. Overshoots and settles on the input.\nvar k := 0.001 + 0.2 a;\nvar d := 0.5 + 0.49 b;\nm2 := d (m2 + k (x - m1));\nm1 := m1 + m2;\nm1"}],[2,{"Float":0.3}],[3,{"Float":0.5}],[4,{"Float":0.5}]]}