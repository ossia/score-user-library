{"Key":{"Uuid":"ae84e8b6-74ff-4259-aeeb-305d95cdfcab","Effect":""},"Name":"Beat to pulse","Category":"Triggers","Preset":[[1,{"String":"// For a 0..1 beat-phase input, as the Beat Tracker emits: 1 on the tick\n// where the phase wraps back round, 0 otherwise.\nvar p := frac(x);\nvar fire := if(p < m1, 1, 0);\nm1 := p;\nfire"}],[2,{"Float":0.5}],[3,{"Float":0.5}],[4,{"Float":0.5}]]}