{"Key":{"Uuid":"ae84e8b6-74ff-4259-aeeb-305d95cdfcab","Effect":""},"Name":"Quantize to pentatonic","Category":"Musical","Preset":[[1,{"String":"// 0..1 in, MIDI note out.\nvar sc[5] := {0, 2, 4, 7, 9};\nvar d := round(15 clamp(0, x, 1));\nvar o := trunc(d / 5);\n36 + 12 o + sc[d % 5]"}],[2,{"Float":0.5}],[3,{"Float":0.5}],[4,{"Float":0.5}]]}