{"Key":{"Uuid":"ae84e8b6-74ff-4259-aeeb-305d95cdfcab","Effect":""},"Name":"Onset to bang","Category":"Triggers","Preset":[[1,{"String":"// For the onset detectors (Spectral Difference, Complex Spectral Difference,\n// High-Frequency Content, Energy Difference).\n// a: threshold, b: minimum time between two bangs.\nvar tsec := t / 705600000;\nif(m2 < 0.5) { m2 := 1; m1 := -1000; };\nvar fire := if(x > a and tsec - m1 > 0.005 + b, 1, 0);\nm1 := if(fire > 0.5, tsec, m1);\nfire"}],[2,{"Float":0.2}],[3,{"Float":0.05}],[4,{"Float":0.5}]]}