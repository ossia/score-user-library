{"Key": {"Uuid": "3f0a1b6e-6a6b-4d0c-9d8f-2b3c1e7a9f10", "Effect": "# Motion-adaptive deinterlacer on the GPU.\n# Portable form: the frame is uploaded to the GPU, filtered, and read back,\n# so it works whatever backend score renders with. When score renders with\n# Vulkan the frames are already on the GPU: drop the hwupload and the\n# hwdownload/format lines and nothing is copied at all.\nhwupload,\nbwdif_vulkan=mode=send_frame,\nhwdownload,format=rgba"}, "Name": "Deinterlace (Vulkan)", "Preset": []}
