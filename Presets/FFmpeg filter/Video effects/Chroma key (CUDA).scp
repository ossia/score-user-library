{"Key": {"Uuid": "3f0a1b6e-6a6b-4d0c-9d8f-2b3c1e7a9f10", "Effect": "# Chroma key on NVIDIA. The frame is uploaded to CUDA, keyed, and read back.\n# yuv420p is what chromakey_cuda takes; it adds an alpha plane, so what comes\n# back down is yuva420p.\nformat=yuv420p,hwupload_cuda,\nchromakey_cuda=color=0x00FF00:similarity=0.3:blend=0.1,\nhwdownload,format=yuva420p"}, "Name": "Chroma key (CUDA)", "Preset": []}
