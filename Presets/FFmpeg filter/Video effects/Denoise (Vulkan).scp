{"Key": {"Uuid": "3f0a1b6e-6a6b-4d0c-9d8f-2b3c1e7a9f10", "Effect": "# Non-local means denoiser on the GPU. Strong and expensive.\n# Portable form: the frame is uploaded to the GPU, filtered, and read back,\n# so it works whatever backend score renders with. When score renders with\n# Vulkan the frames are already on the GPU: drop the hwupload and the\n# hwdownload/format lines and nothing is copied at all.\nhwupload,\nnlmeans_vulkan=s=4:p=3:r=7,\nhwdownload,format=rgba"}, "Name": "Denoise (Vulkan)", "Preset": []}
