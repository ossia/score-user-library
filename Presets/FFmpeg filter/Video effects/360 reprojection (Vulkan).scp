{"Key": {"Uuid": "3f0a1b6e-6a6b-4d0c-9d8f-2b3c1e7a9f10", "Effect": "# Equirectangular source to a flat virtual camera, on the GPU.\n# yaw, pitch and roll are runtime controls.\n# Portable form: the frame is uploaded to the GPU, filtered, and read back,\n# so it works whatever backend score renders with. When score renders with\n# Vulkan the frames are already on the GPU: drop the hwupload and the\n# hwdownload/format lines and nothing is copied at all.\nhwupload,\nv360_vulkan=input=e:output=flat:yaw=0:pitch=0:roll=0:h_fov=90:v_fov=60,\nhwdownload,format=rgba"}, "Name": "360 reprojection (Vulkan)", "Preset": []}
