{"Key": {"Uuid": "3f0a1b6e-6a6b-4d0c-9d8f-2b3c1e7a9f10", "Effect": "# Two video inputs, one output. Offset and duration are in seconds.\n# Portable form: the frame is uploaded to the GPU, filtered, and read back,\n# so it works whatever backend score renders with. When score renders with\n# Vulkan the frames are already on the GPU: drop the hwupload and the\n# hwdownload/format lines and nothing is copied at all.\n[a]hwupload[ua];\n[b]hwupload[ub];\n[ua][ub]xfade_vulkan=transition=fade:duration=1:offset=0,\nhwdownload,format=rgba"}, "Name": "Crossfade (Vulkan)", "Preset": []}
