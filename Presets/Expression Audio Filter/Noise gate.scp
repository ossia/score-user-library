{"Key":{"Uuid":"13e1f4b0-1c2c-40e6-93ad-dfc91aac5335","Effect":""},"Name":"Noise gate","Category":"Dynamics","Preset":[[1,{"String":"// a: threshold.\nvar th := 0.001 + 0.3 a;\nfor(var i := 0; i < x[]; i += 1) {\n  var v := abs(x[i]);\n  m1[i] := m1[i] + if(v > m1[i], 0.01, 0.0005) * (v - m1[i]);\n  out[i] := if(m1[i] > th, x[i], 0);\n}"}],[2,{"Float":0.05}],[3,{"Float":0.5}],[4,{"Float":0.5}]]}