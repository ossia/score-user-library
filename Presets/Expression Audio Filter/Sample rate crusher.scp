{"Key":{"Uuid":"13e1f4b0-1c2c-40e6-93ad-dfc91aac5335","Effect":""},"Name":"Sample rate crusher","Category":"Lo-fi","Preset":[[1,{"String":"// a: how many input samples to hold.\nvar hold := max(1, round(1 + 100 a));\nm2[0] += 1;\nif(m2[0] >= hold) {\n  m2[0] := 0;\n  for(var i := 0; i < x[]; i += 1) { m1[i] := x[i]; };\n};\nfor(var i := 0; i < x[]; i += 1) { out[i] := m1[i]; }"}],[2,{"Float":0.2}],[3,{"Float":0.5}],[4,{"Float":0.5}]]}