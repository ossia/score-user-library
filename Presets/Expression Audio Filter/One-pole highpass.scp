{"Key":{"Uuid":"13e1f4b0-1c2c-40e6-93ad-dfc91aac5335","Effect":""},"Name":"One-pole highpass","Category":"Filters","Preset":[[1,{"String":"var k := 0.0005 + 0.5 a;\nfor(var i := 0; i < x[]; i += 1) {\n  m1[i] := m1[i] + k (x[i] - m1[i]);\n  out[i] := x[i] - m1[i];\n}"}],[2,{"Float":0.1}],[3,{"Float":0.5}],[4,{"Float":0.5}]]}