{"Key":{"Uuid":"13e1f4b0-1c2c-40e6-93ad-dfc91aac5335","Effect":""},"Name":"Cheby 4","Category":"Distortion","Preset":[[1,{"String":"// Chebyshev waveshaper. a: drive, c: output level.\nvar v := tanh((0.2 + 8 a) x);\nout := (0.2 + 0.8 c) (8 v v v v - 8 v v + 1)"}],[2,{"Float":0.118}],[3,{"Float":1.0}],[4,{"Float":0.25}]]}