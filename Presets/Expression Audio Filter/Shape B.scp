{"Key":{"Uuid":"13e1f4b0-1c2c-40e6-93ad-dfc91aac5335","Effect":""},"Name":"Shape B","Category":"Distortion","Preset":[[1,{"String":"// Chebyshev waveshaper. a: drive, c: output level.\nvar v := tanh((0.2 + 8 a) x);\nout := (0.2 + 0.8 c) (1.5 v - 0.5 v v v)"}],[2,{"Float":0.8}],[3,{"Float":1.0}],[4,{"Float":0.25}]]}