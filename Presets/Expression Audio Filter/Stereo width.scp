{"Key":{"Uuid":"13e1f4b0-1c2c-40e6-93ad-dfc91aac5335","Effect":""},"Name":"Stereo width","Category":"Utility","Preset":[[1,{"String":"// a: width. 0 = mono, 1 = normal, right = wider.\nvar w := 3 a;\nfor(var i := 0; i < x[]; i += 1) { out[i] := x[i]; };\nfor(var i := 0; i + 1 < x[]; i += 2) {\n  var mid := 0.5 (x[i] + x[i+1]);\n  var side := 0.5 w (x[i] - x[i+1]);\n  out[i] := mid + side;\n  out[i+1] := mid - side;\n}"}],[2,{"Float":0.333}],[3,{"Float":0.5}],[4,{"Float":0.5}]]}