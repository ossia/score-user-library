{"Key":{"Uuid":"13e1f4b0-1c2c-40e6-93ad-dfc91aac5335","Effect":""},"Name":"Ring modulator","Category":"Modulation","Preset":[[1,{"String":"// a: modulator frequency, b: dry/wet.\nm1[0] := frac(m1[0] + (10 + 2000 a) / fs);\nout := x (1 - b + b sin(2 pi m1[0]))"}],[2,{"Float":0.1}],[3,{"Float":0.8}],[4,{"Float":0.5}]]}