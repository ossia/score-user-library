{"Key":{"Uuid":"13e1f4b0-1c2c-40e6-93ad-dfc91aac5335","Effect":""},"Name":"Mid-side decode","Category":"Utility","Preset":[[1,{"String":"// Mid / side pairs back to left / right.\nfor(var i := 0; i < x[]; i += 1) { out[i] := x[i]; };\nfor(var i := 0; i + 1 < x[]; i += 2) {\n  out[i] := x[i] + x[i+1];\n  out[i+1] := x[i] - x[i+1];\n}"}],[2,{"Float":0.5}],[3,{"Float":0.5}],[4,{"Float":0.5}]]}