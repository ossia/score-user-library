{"Key":{"Uuid":"13e1f4b0-1c2c-40e6-93ad-dfc91aac5335","Effect":""},"Name":"Auto-pan","Category":"Modulation","Preset":[[1,{"String":"// a: rate, b: width. Even channels go one way, odd channels the other.\nm1[0] := frac(m1[0] + (0.05 + 5 a) / fs);\nvar p := 0.5 + 0.5 b sin(2 pi m1[0]);\nfor(var i := 0; i < x[]; i += 1) {\n  out[i] := x[i] * sqrt(if(i % 2 == 0, 1 - p, p));\n}"}],[2,{"Float":0.1}],[3,{"Float":0.8}],[4,{"Float":0.5}]]}