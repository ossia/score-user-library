{"Key":{"Uuid":"13e1f4b0-1c2c-40e6-93ad-dfc91aac5335","Effect":""},"Name":"Mid-side encode","Category":"Utility","Preset":[[1,{"String":"// Channel pairs to mid / side.\nfor(var i := 0; i < x[]; i += 1) { out[i] := x[i]; };\nfor(var i := 0; i + 1 < x[]; i += 2) {\n  out[i] := 0.5 * (x[i] + x[i+1]);\n  out[i+1] := 0.5 * (x[i] - x[i+1]);\n}"}],[2,{"Float":0.5}],[3,{"Float":0.5}],[4,{"Float":0.5}]]}