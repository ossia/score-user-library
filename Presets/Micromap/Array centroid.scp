{"Key":{"Uuid":"25c64b87-a44a-4fed-9f60-0a48906fd3ec","Effect":""},"Name":"Array centroid","Category":"Arrays","Preset":[[1,{"String":"// Where the weight of the array sits, as 0..1 along its length: the\n// brightness of a Spectrum, the balance of a set of blobs.\nvar num := 0;\nvar den := 0;\nfor(var k := 0; k < xv[]; k += 1) {\n  var w := abs(xv[k]);\n  num += k * w;\n  den += w;\n};\nnum / (max(0.000001, den) * max(1, xv[] - 1))"}]]}